---
// Espaçador (Spacer)
// ------------
// Descrição: um componente simples para adicionar espaço entre elementos
// Propriedades:
// - Size: o tamanho do espaçador (0, 2, 3, 4, 6, 8, 12, 16, 24, 32)
// - DesktopSize: o tamanho do espaçador no desktop (0, 2, 3, 4, 6, 8, 12, 16, 24, 32)

// Props
type Props = {
	size: '0' | '2' | '3' | '4' | '6' | '8' | '12' | '16' | '24' | '32'
	desktopSize: '0' | '2' | '3' | '4' | '6' | '8' | '12' | '16' | '24' | '32'
}
const { size = '6', desktopSize = '12' } = Astro.props
---

<div class:list={[{ ['h-' + `${size}`]: size }, { ['lg:h-' + `${desktopSize}`]: desktopSize }]}>
</div>
