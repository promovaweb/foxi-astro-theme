---
// Feed
// ------------
// Descrição: o componente feed é um elemento de interface que exibe um fluxo de conteúdo (estático ou dinâmico), como comentários, atualizações de atividade, postagens, em ordem cronológica.
// Propriedades:
// - Data: os dados do feed (consiste em título, data, texto e imagem)
// - classes: classes adicionais
// - showVideos: booleano para mostrar ou ocultar vídeos (padrão true)

// Componentes
import Badge from '@components/ui/Badge.astro'

// Props
type Props = {
	data: any[]
	classes?: string
	showVideos?: boolean
}
const { data, classes, showVideos = true } = Astro.props

// Helper para formatar data em formato ISO (YYYY-MM-DD)
const formatDate = (dateString: string) => {
	const date = new Date(dateString)
	return date.toISOString().split('T')[0]
}

// Agrupando dados por data
const groupedData = data.reduce((acc, item) => {
	const date = item.data ? item.data.date : item.date
	if (!acc[date]) {
		acc[date] = []
	}
	acc[date].push(item)
	return acc
}, {})

// Ordenando as datas (descendente)
const sortedDates = Object.keys(groupedData).sort((a, b) => new Date(b).getTime() - new Date(a).getTime())

---

<ul aria-label="Feed de histórico de alterações" role="feed" class:list={['feed', { [`${classes}`]: classes }]}>
	{
		sortedDates.map((date) => {
			const items = groupedData[date]
			const formattedDate = formatDate(date)

			return (
				<li class="feed__group mb-16 lg:mb-24 last:mb-0">
					<div class="feed__item group">
						<div class="feed__item-side">
							<span class="feed__item-date">{formattedDate}</span>
						</div>
						
						<div class="feed__item-container">
							{items.map((item: any, index: number) => {
								const isEntry = !!item.data
								const title = isEntry ? item.data.title : item.title
								const description = isEntry ? item.data.description : null
								const youtube = isEntry ? item.data.youtube : null
								const category = isEntry ? item.data.category : null
								const id = isEntry ? item.id : null

								return (
									<div class:list={["feed__item-content", { "mt-16 pt-16 border-t border-neutral-100 dark:border-neutral-800 border-dashed": index > 0 }]}>
										<div class="flex flex-wrap items-center gap-3 mb-4">
											{category && (
												<a href={`/changelog/category/${category}`}>
													<Badge 
														name={category} 
														type="primary" 
														classes="!text-[10px] !py-0.5 !px-2.5 uppercase tracking-wider hover:bg-primary-600 transition-colors" 
													/>
												</a>
											)}
											<span class="text-neutral-400 dark:text-neutral-500 text-sm font-medium lg:hidden">
												• {formattedDate}
											</span>
										</div>

										<div class="mb-8">
											<h4 class="feed__item-header">
												{id ? (
													<a href={`/changelog/${id}`} class="group-hover:text-primary-500 transition-colors duration-300">
														{title}
													</a>
												) : (
													title
												)}
											</h4>
										</div>

										{description && (
											<p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed max-w-4xl mb-8">
												{description}
											</p>
										)}

										{showVideos && youtube && (
											<div class="feed__item-video mb-8 overflow-hidden rounded-2xl shadow-2xl shadow-neutral-500/10 dark:shadow-neutral-950/50 border border-neutral-100 dark:border-neutral-800">
												<div class="aspect-video w-full">
													<iframe
														width="100%"
														height="100%"
														src={`https://www.youtube.com/embed/${youtube}`}
														title="YouTube video player"
														frameborder="0"
														allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
														allowfullscreen
														class="w-full h-full"
													/>
												</div>
											</div>
										)}
									</div>
								)
							})}
						</div>
					</div>
				</li>
			)
		})
	}
</ul>

<style>
	.feed {
		@apply relative flex flex-col pl-4 lg:pl-0 before:absolute lg:before:left-32 before:left-4 before:top-0 before:h-full before:-translate-x-1/2 before:border-l before:border-neutral-200 dark:before:border-neutral-800;
	}
	.feed__item {
		@apply flex flex-col lg:flex-row gap-2 lg:gap-10 relative;
	}
	.feed__item-side {
		@apply hidden lg:flex lg:w-32 lg:justify-end lg:pt-1.5;
	}
	.feed__item-date {
		@apply text-xs font-bold tracking-widest text-neutral-400 dark:text-neutral-500 sticky top-24 pr-4;
	}
	.feed__item-container {
		@apply relative flex-1 pl-8 lg:pl-0 before:absolute before:left-0 lg:before:-left-10 before:top-2.5 before:z-10 before:h-3 before:w-3 before:-translate-x-1/2 before:rounded-full before:bg-white dark:before:bg-neutral-950 before:border-2 before:border-primary-500 before:shadow-[0_0_0_4px_rgba(226,24,125,0.1)] transition-all duration-300;
	}
	.feed__item-header {
		@apply text-lg lg:text-xl font-black text-neutral-900 dark:text-white leading-tight;
	}
	.feed__item-content {
		@apply pb-4;
	}
</style>
