---
// Feed
// ------------
// Descrição: o componente feed é um elemento de interface que exibe um fluxo de conteúdo (estático ou dinâmico), como comentários, atualizações de atividade, postagens, em ordem cronológica.
// Propriedades:
// - Data: os dados do feed (consiste em título, data, texto e imagem)
// - classes: classes adicionais

// Componentes
import { render } from 'astro:content'
import { Icon } from 'astro-icon/components'

// Props
type Props = {
	data: any[]
	classes?: string
}
const { data, classes } = Astro.props

// Helper para renderizar o conteúdo se for uma entrada de conteúdo
const renderContent = async (item: any) => {
	if (item.render) {
		const { Content } = await render(item)
		return Content
	}
	return null
}
---

<ul aria-label="Feed de histórico de alterações" role="feed" class:list={['feed', { [`${classes}`]: classes }]}>
	{
		data.map(async (item) => {
			const Content = await renderContent(item)
			const isEntry = !!item.data
			const title = isEntry ? item.data.title : item.title
			const date = isEntry ? item.data.date : item.date
			const image = isEntry ? item.data.image : item.image
			const text = isEntry ? null : item.text
			const id = isEntry ? item.id : null

			return (
				<li role="article" class="feed__item">
					<span class="feed__item-date"> {date}</span>
					<div class="feed__item-container">
						<h4 class="feed__item-header">
							{id ? (
								<a href={`/changelog/${id}`} class="hover:text-primary-600 transition-colors">
									{title}
								</a>
							) : (
								title
							)}
							<span> - {date}</span>
						</h4>
						{image && (
							<div class="feed__item-image">
								<img src={image} alt={title} width="1000" height="500" />
							</div>
						)}
						<div class="feed__item-text basic-text">
							{Content ? <Content /> : <Fragment set:html={text} />}
						</div>
						{id && (
							<a href={`/changelog/${id}`} class="feed__item-link mt-4 flex items-center gap-2 text-sm font-semibold text-primary-500 hover:text-primary-600 transition-colors">
								Ver detalhes da atualização
								<Icon name="long-arrow-right" class="w-4 h-4" />
							</a>
						)}
					</div>
				</li>
			)
		})
	}
</ul>

<style>
	.feed {
		@apply relative flex flex-col gap-24 py-12 pl-6 before:absolute before:left-6 before:top-0 before:h-full before:-translate-x-1/2 before:border before:border-dashed before:border-neutral-100 after:absolute after:bottom-6 after:left-6 after:top-6 after:-translate-x-1/2 after:border after:border-neutral-100 lg:before:left-44 lg:after:left-44 dark:before:border-neutral-800 dark:after:border-neutral-800;
	}
	.feed__item {
		@apply flex gap-6;
	}
	.feed__item-container {
		@apply relative flex flex-1 flex-col pl-6 before:absolute before:left-0 before:top-2 before:z-10 before:h-2 before:w-2 before:-translate-x-1/2 before:rounded-full before:bg-primary-500 before:ring-2 before:ring-neutral-100 lg:pl-12 dark:before:ring-neutral-800 [&_p]:m-0;
	}
	.feed__item-date {
		@apply hidden text-lg font-medium text-primary-500 lg:block lg:w-32;
	}
	.feed__item-header {
		@apply text-lg font-medium text-primary-500 lg:[&_span]:hidden;
	}
	.feed__item-text {
		@apply max-w-5xl;
	}
	.feed__item-image {
		@apply mb-6 overflow-hidden rounded border border-neutral-100 bg-neutral-50 dark:border-neutral-800 dark:bg-neutral-900;
	}
</style>
