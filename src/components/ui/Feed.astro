---
// Feed
// ------------
// Descrição: o componente feed é um elemento de interface que exibe um fluxo de conteúdo (estático ou dinâmico), como comentários, atualizações de atividade, postagens, em ordem cronológica.
// Propriedades:
// - Data: os dados do feed (consiste em título, data, texto e imagem)
// - classes: classes adicionais

// Componentes
import { render } from 'astro:content'
import { Icon } from 'astro-icon/components'
import Badge from '@components/ui/Badge.astro'

// Props
type Props = {
	data: any[]
	classes?: string
}
const { data, classes } = Astro.props

// Helper para formatar data em pt-BR
const formatDate = (dateString: string) => {
	const date = new Date(dateString)
	return date.toLocaleDateString('pt-BR', {
		day: '2-digit',
		month: 'short',
		year: 'numeric'
	})
}

// Agrupando dados por data
const groupedData = data.reduce((acc, item) => {
	const date = item.data ? item.data.date : item.date
	if (!acc[date]) {
		acc[date] = []
	}
	acc[date].push(item)
	return acc
}, {})

// Ordenando as datas (descendente)
const sortedDates = Object.keys(groupedData).sort((a, b) => new Date(b).getTime() - new Date(a).getTime())

---

<ul aria-label="Feed de histórico de alterações" role="feed" class:list={['feed', { [`${classes}`]: classes }]}>
	{
		sortedDates.map((date) => {
			const items = groupedData[date]
			const formattedDate = formatDate(date)

			return (
				<li class="feed__group mb-16 lg:mb-24 last:mb-0">
					<div class="feed__item group">
						<div class="feed__item-side">
							<span class="feed__item-date">{formattedDate}</span>
						</div>
						
						<div class="feed__item-container">
							{items.map((item, index) => {
								const isEntry = !!item.data
								const title = isEntry ? item.data.title : item.title
								const description = isEntry ? item.data.description : null
								const youtube = isEntry ? item.data.youtube : null
								const category = isEntry ? item.data.category : null
								const id = isEntry ? item.id : null

								return (
									<div class:list={["feed__item-content", { "mt-16 pt-16 border-t border-neutral-100 dark:border-neutral-800 border-dashed": index > 0 }]}>
										<div class="flex flex-wrap items-center gap-3 mb-4">
											{category && (
												<a href={`/changelog/category/${category}`}>
													<Badge 
														name={category} 
														type="primary" 
														classes="!text-[10px] !py-0.5 !px-2.5 uppercase tracking-wider hover:bg-primary-600 transition-colors" 
													/>
												</a>
											)}
											<span class="text-neutral-400 dark:text-neutral-500 text-sm font-medium lg:hidden">
												• {formattedDate}
											</span>
										</div>

										<div class="mb-8">
											<h4 class="feed__item-header">
												{id ? (
													<a href={`/changelog/${id}`} class="group-hover:text-primary-500 transition-colors duration-300">
														{title}
													</a>
												) : (
													title
												)}
											</h4>
										</div>

										{youtube ? (
											<div class="feed__item-video mb-8 overflow-hidden rounded-2xl shadow-2xl shadow-neutral-500/10 dark:shadow-neutral-950/50 border border-neutral-100 dark:border-neutral-800">
												<div class="aspect-video w-full">
													<iframe
														width="100%"
														height="100%"
														src={`https://www.youtube.com/embed/${youtube}`}
														title="YouTube video player"
														frameborder="0"
														allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
														allowfullscreen
														class="w-full h-full"
													/>
												</div>
											</div>
										) : (
											description && (
												<p class="text-xl text-neutral-600 dark:text-neutral-400 leading-relaxed max-w-4xl">
													{description}
												</p>
											)
										)}
									</div>
								)
							})}
						</div>
					</div>
				</li>
			)
		})
	}
</ul>

<style>
	.feed {
		@apply relative flex flex-col py-12 pl-6 lg:pl-0 before:absolute lg:before:left-44 before:left-6 before:top-0 before:h-full before:-translate-x-1/2 before:border-l-2 before:border-dashed before:border-neutral-100 dark:before:border-neutral-800;
	}
	.feed__item {
		@apply flex flex-col lg:flex-row gap-2 lg:gap-12 relative;
	}
	.feed__item-side {
		@apply hidden lg:flex lg:w-44 lg:justify-end lg:pt-2;
	}
	.feed__item-date {
		@apply text-sm font-bold uppercase tracking-widest text-neutral-400 dark:text-neutral-500 sticky top-24;
	}
	.feed__item-container {
		@apply relative flex-1 pl-8 lg:pl-0 before:absolute before:-left-[25px] lg:before:-left-[51px] before:top-3 before:z-10 before:h-4 before:w-4 before:-translate-x-1/2 before:rounded-full before:bg-white dark:before:bg-neutral-950 before:border-4 before:border-primary-500 before:shadow-[0_0_0_8px_rgba(var(--color-primary-500),0.1)] transition-all duration-300;
	}
	.feed__item-header {
		@apply text-3xl lg:text-4xl font-black text-neutral-900 dark:text-white leading-tight;
	}
	.feed__item-content {
		@apply pb-4;
	}
</style>
