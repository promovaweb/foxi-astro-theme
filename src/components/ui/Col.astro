---
// Coluna
// ------------
// Descrição: Representa uma coluna em uma grade de 12 colunas.
// Propriedades:
// - Span: a abrangência da coluna (1 a 12)
// - SpanMobile: a abrangência da coluna no mobile (1 a 12)
// - Align: o alinhamento horizontal da coluna (start, center, end)
// - Classes: classes adicionais

// Props
type Props = {
	span?: string
	lg?: string
	spanMobile?: string
	align?: string
	classes?: string
}
const { span, lg, spanMobile = '12', align, classes } = Astro.props

const desktopSpan = lg || span
const hasContent = Astro.slots.default
---

<div
	class:list={[
		'col',
		{ ['col-span-' + `${spanMobile}`]: spanMobile },
		{ ['lg:col-span-' + `${desktopSpan}`]: desktopSpan },
		{ ['text-' + `${align}`]: align },
		{ [`${classes}`]: classes }
	]}
>
	{hasContent ? <slot /> : <div class="col__placeholder" />}
</div>

<style>
	.col {
		@apply has-[.col\_\_placeholder]:hidden lg:has-[.col\_\_placeholder]:block;
	}
	.col__placeholder {
		@apply hidden;
	}
</style>
