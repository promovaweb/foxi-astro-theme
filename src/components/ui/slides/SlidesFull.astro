---
// SlidesFull Component
// Descrição: Slider em tela cheia 1920x1080 com imagem limpa e conteúdo em card lateral.
// Propriedades: slides (array de objetos com título, texto, imagem e link opcional)

import { Image } from 'astro:assets'
import Button from '@components/ui/Button.astro'
import defaultPlaceholder from '@/assets/bg-01.png'

type Slide = {
	title: string
	text: string
	image?: any
	buttonLink?: string
	buttonText?: string
}

type Props = {
	slides: Slide[]
	id?: string
	autoplay?: boolean
	classes?: string
}

const { slides, id = "full-slides", autoplay = true, classes } = Astro.props
---

<div class:list={["slides-full relative overflow-hidden h-[600px] lg:h-[800px] bg-neutral-100 dark:bg-neutral-900", classes]} id={id}>
	<div class="slides-full__wrapper h-full w-full relative">
		{slides.map((slide, index) => (
			<div class="slides-full__slide absolute inset-0 opacity-0 transition-opacity duration-1000 ease-in-out z-0" data-index={index}>
				<!-- Imagem de Fundo Limpa 1920x1080 -->
				<div class="absolute inset-0 overflow-hidden">
					<Image 
						src={slide.image || defaultPlaceholder} 
						alt={slide.title} 
						width={1920} 
						height={1080} 
						class="w-full h-full object-cover" 
					/>
				</div>
				<!-- Conteúdo em Card Lateral (para evitar overlay na imagem toda) -->
				<div class="relative h-full container mx-auto px-4 flex items-center justify-start pointer-events-none">
					<div class="bg-white/95 dark:bg-neutral-900/95 backdrop-blur-md p-8 lg:p-16 rounded-[2.5rem] shadow-2xl max-w-2xl border border-neutral-100 dark:border-neutral-800 pointer-events-auto slide-card translate-x-[-2rem] opacity-0 transition-all duration-700 delay-300">
						<h3 class="text-3xl lg:text-6xl font-black text-neutral-900 dark:text-white mb-6 leading-tight slide-title">
							{slide.title}
						</h3>
						<p class="text-lg lg:text-xl text-neutral-600 dark:text-neutral-400 mb-10 slide-text">
							{slide.text}
						</p>
						{slide.buttonLink && (
							<div class="slide-button">
								<Button link={slide.buttonLink} style="primary" size="lg">
									{slide.buttonText || "Saiba Mais"}
								</Button>
							</div>
						)}
					</div>
				</div>
			</div>
		))}
	</div>

	<!-- Progress Indicators - Estilo Dark/Light discreto -->
	<div class="absolute bottom-12 right-12 flex gap-4 z-10">
		{slides.map((_, index) => (
			<button class="slides-full__indicator w-12 h-1 bg-neutral-900/10 dark:bg-white/10 overflow-hidden relative" data-index={index}>
				<div class="absolute inset-0 bg-primary-500 origin-left scale-x-0 progress-bar"></div>
			</button>
		))}
	</div>
</div>

<script define:vars={{ id, autoplay, slidesCount: slides.length }}>
	function initSlidesFull() {
		const slides = document.querySelectorAll(`#${id} .slides-full__slide`);
		const indicators = document.querySelectorAll(`#${id} .slides-full__indicator`);
		
		if (!slides.length) return;

		let currentIndex = 0;
		let interval;

		function updateSlider() {
			slides.forEach((slide, i) => {
				const card = slide.querySelector('.slide-card');
				const progress = indicators[i].querySelector('.progress-bar');

				if (i === currentIndex) {
					slide.classList.add('opacity-100', 'z-1');
					slide.classList.remove('opacity-0', 'z-0');
					card.classList.add('opacity-100', 'translate-x-0');
					card.classList.remove('opacity-0', 'translate-x-[-2rem]');
					
					// Start progress animation
					progress.style.transition = 'none';
					progress.style.transform = 'scaleX(0)';
					setTimeout(() => {
						progress.style.transition = 'transform 6000ms linear';
						progress.style.transform = 'scaleX(1)';
					}, 50);
				} else {
					slide.classList.remove('opacity-100', 'z-1');
					slide.classList.add('opacity-0', 'z-0');
					card.classList.remove('opacity-100', 'translate-x-0');
					card.classList.add('opacity-0', 'translate-x-[-2rem]');
					
					progress.style.transition = 'none';
					progress.style.transform = 'scaleX(0)';
				}
			});
		}

		function nextSlide() {
			currentIndex = (currentIndex + 1) % slidesCount;
			updateSlider();
		}

		indicators.forEach((indicator, i) => {
			indicator.addEventListener('click', () => {
				currentIndex = i;
				updateSlider();
				resetTimer();
			});
		});

		function resetTimer() {
			if (autoplay) {
				clearInterval(interval);
				interval = setInterval(nextSlide, 6000);
			}
		}

		if (autoplay) resetTimer();
		updateSlider();
	}

	initSlidesFull();
	document.addEventListener('astro:page-load', initSlidesFull);
</script>

<style>
	.slides-full__indicator {
		@apply cursor-pointer;
	}
</style>
