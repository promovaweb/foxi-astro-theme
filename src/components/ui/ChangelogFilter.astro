---
// ChangelogFilter
// ------------
// Descrição: Componente de filtro de categorias para o changelog.

import { getCollection } from 'astro:content'
import Section from '@components/ui/Section.astro'

type Props = {
	currentCategory?: string
}

const { currentCategory } = Astro.props

const changelogEntries = await getCollection('changelog')
const categories = [...new Set(changelogEntries.map((entry) => entry.data.category))].sort()
---

<Section classes="!py-0">
	<div class="category-filter flex flex-wrap justify-center gap-3 lg:gap-4 py-8 border-b border-neutral-100 dark:border-neutral-800">
		<a
			href="/changelog"
			class:list={[
				'px-5 lg:px-6 py-2 rounded-full text-xs lg:text-sm font-bold transition-all border',
				!currentCategory 
					? 'bg-primary-500 border-primary-500 text-white shadow-lg shadow-primary-500/25' 
					: 'bg-white dark:bg-neutral-900 border-neutral-200 dark:border-neutral-800 text-neutral-600 dark:text-neutral-400 hover:border-primary-500 hover:text-primary-500'
			]}
		>
			Todos
		</a>
		{
			categories.map((category) => (
				<a
					href={`/changelog/category/${category}`}
					class:list={[
						'px-5 lg:px-6 py-2 rounded-full text-xs lg:text-sm font-bold transition-all border',
						currentCategory === category
							? 'bg-primary-500 border-primary-500 text-white shadow-lg shadow-primary-500/25'
							: 'bg-white dark:bg-neutral-900 border-neutral-200 dark:border-neutral-800 text-neutral-600 dark:text-neutral-400 hover:border-primary-500 hover:text-primary-500'
					]}
				>
					{category}
				</a>
			))
		}
	</div>
</Section>
