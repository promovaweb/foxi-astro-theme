---
// Accordion
// ------------
// Descrição: o elemento accordion cria um widget de divulgação no qual as informações são visíveis apenas quando o widget é alternado para um estado "aberto".
// Propriedades:
// - Title: o título do accordion (geralmente representa uma pergunta)
// - Text: o texto do accordion (geralmente representa uma resposta)
// - Open: se o accordion está aberto ou não
// - classes: classes adicionais
// Referência: https://wind-ui.com/components/accordions/

// Componentes
// - UI
import { Icon } from 'astro-icon/components'

// Props
type Props = {
	title: string
	text: string
	open?: boolean
	classes?: string
}
const {
	title = 'Foxi. Kit Inicial Astro com Tailwind CSS da Oxygenna',
	text = 'Foxi é uma agência de design e desenvolvimento especializada na criação de sites bonitos e funcionais.',
	open = false,
	classes 
} = Astro.props
---

<details
	class:list={['accordion group', { [`${classes}`]: classes }]}
	open={open ? true : undefined}
>
	<summary class="accordion__summary">
		{title}
		<Icon name="plus" class="accordion__icon" />
	</summary>
	<p class="accordion__text">
		{text}
	</p>
</details>

<style>
	.accordion {
		@apply cursor-pointer;
	}
	.accordion__summary {
		@apply relative list-none px-6 py-4 text-lg font-medium text-neutral-700 transition focus-visible:outline-none dark:text-neutral-300 [&::-webkit-details-marker]:hidden;
	}
	.accordion__icon {
		@apply absolute right-4 top-[1.375rem] h-4 w-4 shrink-0 transition duration-300 group-open:rotate-45;
	}
	.accordion__text {
		@apply mb-0 bg-neutral-50 p-6 transition dark:bg-neutral-800/50;
	}
</style>
