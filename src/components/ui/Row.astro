---
// Linha (Row)
// ------------
// Descrição: um componente fundamental que representa uma linha de conteúdo dentro de uma seção. O componente row usa uma grade de layout de 12 colunas e pode conter qualquer número de colunas.
// Propriedades:
// - Flex: se a linha é flex ou não (o padrão é grid)
// - Mode: use para sobrescrever o modo claro/escuro para uma linha específica. Útil se você tiver uma linha que possa conter um fundo escuro
// - Rows: define explicitamente o número de linhas da grade (grid-rows-{n})
// - RowsLg: define o número de linhas da grade no breakpoint lg (lg:grid-rows-{n})
// - classes: classes adicionais

// Props
type Props = {
	/** Se verdadeiro, usa flexbox em vez de grid. */
	flex?: boolean
	/** Classes CSS adicionais. */
	classes?: string
	/** Sobrescreve o modo claro/escuro para esta linha. */
	mode?: string
	/** Alinhamento horizontal dos itens (ex: center, end). */
	justify?: string
	/** Número de linhas explícitas da grade (grid-rows-{n}). */
	rows?: string
	/** Número de linhas explícitas no breakpoint lg (lg:grid-rows-{n}). */
	rowsLg?: string
}
const { flex, mode, classes, justify, rows, rowsLg } = Astro.props
---

<div
	class:list={[
		'row',
		{ 'row--flex': flex },
		{ [`justify-${justify}`]: justify },
		{ ['grid-rows-' + rows]: rows },
		{ ['lg:grid-rows-' + rowsLg]: rowsLg },
		{ [`${classes}`]: classes },
		{ [`${mode}`]: mode }
	]}
>
	<slot />
</div>

<style>
	.row {
		@apply grid grid-cols-4 gap-6 md:grid-cols-8 lg:grid-cols-12;
	}
	.row--flex {
		@apply flex w-full flex-col flex-wrap items-center justify-center lg:flex-row;
	}
</style>
