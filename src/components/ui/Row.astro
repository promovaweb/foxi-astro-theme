---
// Linha (Row)
// ------------
// Descrição: um componente fundamental que representa uma linha de conteúdo dentro de uma seção. O componente row usa uma grade de layout de 12 colunas e pode conter qualquer número de colunas.
// Propriedades:
// - Flex: se a linha é flex ou não (o padrão é grid)
// - Mode: use para sobrescrever o modo claro/escuro para uma linha específica. Útil se você tiver uma linha que possa conter um fundo escuro
// - classes: classes adicionais

// Props
type Props = {
	flex?: boolean
	classes?: string
	mode?: string
	justify?: string
}
const { flex, mode, classes, justify } = Astro.props
---

<div
	class:list={[
		'row',
		{ 'row--flex': flex },
		{ [`justify-${justify}`]: justify },
		{ [`${classes}`]: classes },
		{ [`${mode}`]: mode }
	]}
>
	<slot />
</div>

<style>
	.row {
		@apply grid grid-cols-4 gap-6 md:grid-cols-8 lg:grid-cols-12;
	}
	.row--flex {
		@apply flex w-full flex-col flex-wrap items-center justify-center lg:flex-row;
	}
</style>
