---
// Seção de Episódios Relacionados/Últimos Episódios
// Descrição: Exibe uma grade de episódios com capa e tooltip do título

import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

type Props = {
  episodes: CollectionEntry<'podcast'>[]
}

const { episodes } = Astro.props

if (episodes.length === 0) return null
---

<section class="mt-12">
  <div class="flex items-center gap-3 mb-6">
    <h3 class="text-sm font-bold uppercase tracking-widest text-neutral-500 dark:text-neutral-400">
      Descubra outros episódios
    </h3>
    <div class="h-px flex-1 bg-neutral-200 dark:bg-neutral-800"></div>
  </div>

  <div class="grid grid-cols-4 gap-3 sm:gap-4">
    {episodes.map((ep) => (
      <a 
        href={`/podcast/${ep.id}`} 
        class="group relative flex flex-col items-center"
      >
        <!-- Tooltip -->
        <div class="absolute bottom-full mb-2 left-1/2 -translate-x-1/2 w-48 p-2 bg-neutral-900 text-white text-[11px] font-medium rounded-lg opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none z-50 text-center shadow-xl">
          {ep.data.title}
          <!-- Seta do Tooltip -->
          <div class="absolute top-full left-1/2 -translate-x-1/2 border-8 border-transparent border-t-neutral-900"></div>
        </div>

        <!-- Capa -->
        <div class="relative aspect-square w-full overflow-hidden rounded-xl bg-neutral-200 dark:bg-neutral-800 ring-1 ring-inset ring-black/10 dark:ring-white/10 transition-transform duration-300 group-hover:scale-95 group-hover:shadow-lg">
          <Image
            src={ep.data.cover}
            alt={ep.data.title}
            width={400}
            height={400}
            class="h-full w-full object-cover"
          />
          <div class="absolute inset-0 bg-primary-500/0 group-hover:bg-primary-500/10 transition-colors duration-300"></div>
        </div>
      </a>
    ))}
  </div>
</section>
