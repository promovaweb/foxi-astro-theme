---
// Entrada de Episódio
// Descrição: Componente para exibir um episódio na lista

import type { CollectionEntry } from 'astro:content'
import { Image } from 'astro:assets'

type Props = {
  episode: CollectionEntry<'podcast'>
}

const { episode } = Astro.props
const { title, description, pubDate, cover } = episode.data
const slug = episode.id

const date = new Date(pubDate)
const formattedDate = date.toLocaleDateString('pt-BR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
})
---

<article
  aria-labelledby={`episode-${slug}-title`}
  class="episode-entry py-10 sm:py-12 px-4 sm:px-6 lg:px-8 border-b border-neutral-100 dark:border-neutral-800 last:border-0"
>
  <div class="flex flex-col sm:flex-row items-start gap-6 sm:gap-8 max-w-4xl">
    <a href={`/podcast/${slug}`} class="flex-none group">
      <div class="relative overflow-hidden rounded-xl bg-neutral-200 dark:bg-neutral-800 shadow-md transition-transform group-hover:scale-[1.02] duration-300">
        <Image
          class="size-32 sm:size-40 lg:size-48 object-cover"
          src={cover}
          alt={`Capa do episódio: ${title}`}
          width={1024}
          height={1024}
        />
        <div class="absolute inset-0 ring-1 ring-inset ring-black/10 rounded-xl" />
      </div>
    </a>
    <div class="flex flex-col items-start max-w-2xl">
      <time
        datetime={pubDate.toISOString()}
        class="order-first font-mono text-sm leading-7 text-neutral-500 dark:text-neutral-400"
      >
        {formattedDate}
      </time>
      <h2
        id={`episode-${slug}-title`}
        class="mt-2 text-2xl sm:text-3xl font-bold text-neutral-900 dark:text-neutral-50 font-headings"
      >
        <a href={`/podcast/${slug}`} class="hover:text-primary-500 transition-colors">
          {title}
        </a>
      </h2>
      <p class="mt-3 text-base leading-7 text-neutral-700 dark:text-neutral-300 line-clamp-3 sm:line-clamp-none">
        {description}
      </p>
    </div>
  </div>
</article>
