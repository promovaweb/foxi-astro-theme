---
// Campo de entrada (Input field)
// ------------
// Descrição: O componente para o campo de entrada básico de formulário
// Propriedades:
// - id: O id do campo de entrada
// - name: O nome do campo de entrada
// - placeholder: O placeholder do campo de entrada
// - type: O tipo do campo de entrada (text, email, password, tel)
// - label: O rótulo (label) do campo de entrada
// - iconName: O nome do ícone a ser exibido (opcional)
// - iconPosition: A posição do ícone (lead ou trail)
// - helperText: O texto de ajuda a ser exibido
// - required: Se o campo de entrada é obrigatório
// - disabled: Se o campo de entrada está desativado
// - value: O valor do campo de entrada
// - classes: Classes adicionais a serem adicionadas ao campo de entrada

// Referência: https://wind-ui.com/components/form-elements/input-groups/

// Componentes
// - UI
import { Icon } from 'astro-icon/components'

// Props
type Props = {
	id?: string
	name?: string
	placeholder?: string
	type?: 'text' | 'email' | 'password' | 'tel'
	label: string
	iconName?: string
	iconPosition?: 'lead' | 'trail'
	helperText?: string
	required?: boolean
	disabled?: boolean
	value?: string
	classes?: string
}
const {
	type = 'text',
	id,
	name,
	placeholder,
	label,
	iconName,
	iconPosition,
	helperText,
	required,
	disabled,
	value,
	classes
} = Astro.props

const inputId = id || name || label.toLowerCase().replace(/\s+/g, '-')
const inputName = name || inputId
const inputPlaceholder = placeholder || label
---

<div
	class:list={[
		'input',
		{ ['input--icon-' + `${iconPosition}`]: iconPosition },
		,
		{ [`${classes}`]: classes }
	]}
>
	<input
		id={inputId}
		type={type}
		name={inputName}
		placeholder=" "
		required={required}
		disabled={disabled}
		value={value}
		class="input__field peer"
	/>
	<label
		for={inputId}
		class="input__label"
	>
		{label}
	</label>
	{iconName && <Icon name={iconName} class="input__icon" />}
	{
		helperText && (
			<small class="input__helper-text">
				<span> {helperText} </span>
			</small>
		)
	}
</div>

<style>
	.input {
		@apply relative w-full;
	}
	.input__field {
		@apply relative h-14 w-full rounded-xl border border-neutral-300 px-4 text-neutral-950 outline-none transition-all autofill:bg-white invalid:border-red-500 invalid:text-red-500 focus:border-primary-500 focus:outline-none invalid:focus:border-red-500 focus-visible:outline-none disabled:cursor-not-allowed disabled:bg-neutral-50 disabled:text-neutral-400 dark:border-neutral-700 dark:bg-neutral-900 dark:text-white dark:autofill:bg-neutral-900 dark:disabled:bg-neutral-600;
	}
	
	/* Label base state (inside input) */
	.input__label {
		@apply absolute left-4 top-4 z-[1] cursor-text text-base font-normal text-neutral-500 transition-all pointer-events-none px-1;
	}

	/* Label floating state (when focused or not empty) */
	/* We use :not(:placeholder-shown) to detect if input is not empty */
	.input__field:focus ~ .input__label,
	.input__field:not(:placeholder-shown) ~ .input__label,
	.input__field:-webkit-autofill ~ .input__label {
		@apply -top-3 left-3 text-xs font-bold text-primary-500 bg-white dark:bg-neutral-950;
	}

	.input__field:not(:focus):not(:placeholder-shown) ~ .input__label {
		@apply text-neutral-600 dark:text-neutral-400;
	}

	.input__icon {
		@apply absolute left-4 top-4 h-6 w-6 stroke-neutral-400 peer-disabled:cursor-not-allowed;
	}
	.input__helper-text {
		@apply absolute flex w-full justify-between px-4 py-1 text-xs text-neutral-400 transition peer-invalid:text-red-500;
	}
	.input--icon-lead {
		@apply [&_.input\_\_field]:!pl-12 [&_.input\_\_icon]:left-4;
	}
	.input--icon-trail {
		@apply [&_.input\_\_field]:!pr-12 [&_.input\_\_icon]:right-4;
	}
</style>
