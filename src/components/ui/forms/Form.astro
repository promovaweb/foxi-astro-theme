---
// Formulário (Form)
// ------------
// Descrição: O componente de formulário
// Propriedades:
// - method: O método do formulário (post, get, dialog)
// - classes: Classes adicionais a serem adicionadas ao formulário
// - id: Para definir o ID específico do formulário
// - name: define o nome do formulário

type Props = {
  method?: 'post' | 'get' | 'dialog'
  classes?: string
  id?: string
  name?: string
}

const { method = 'post', classes, id, name } = Astro.props

// Use id as name if name is not set but id is set
const formName = name || id || undefined;
---

<form method={method} novalidate class:list={[{ [`${classes}`]: classes }]} id={id} name={formName}>
	<slot />
</form>
