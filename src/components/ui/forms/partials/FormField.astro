---
// Contêiner de Campo de Entrada (Input Field container)
// ------------
// Descrição: O contêiner para todos os elementos de formulário
// Propriedades:
// - classes: Classes adicionais a serem adicionadas ao campo de texto

// Props
type Props = {
	classes?: string
}
const { classes } = Astro.props
---

<div class:list={['form__field', { [`${classes}`]: classes }]}>
	<slot />
</div>

<style>
	.form__field {
		@apply my-8 flex flex-col items-baseline justify-between gap-6 lg:flex-row;
	}
</style>
