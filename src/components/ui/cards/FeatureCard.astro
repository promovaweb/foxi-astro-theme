---
// Cartão de Funcionalidade (Feature Card)
// ------------
// Descrição: O cartão para apresentar uma funcionalidade (feature)
// Propriedades:
// - Title: o título do cartão
// - Subtitle: o subtítulo do cartão
// - Image: a imagem principal do cartão
// - Link: o link para a postagem do blog
// Referência: https://wind-ui.com/components/cards/

// Componentes
// - UI
import Card from '@components/ui/cards/BasicCard.astro'

// Props
type Props = {
	title?: string
	subtitle?: string
	image?: any
	link?: string
}
const { title , subtitle, image, link } = Astro.props
---

<Card
	title={title}
	subtitle={subtitle}
	titleSize="xl"
	link={link}
	image={image}
	type="image-bottom"
	classes="!bg-neutral-50 !shadow-none dark:!bg-neutral-900 h-full justify-between border border-neutral-100 dark:border-neutral-800"
/>
