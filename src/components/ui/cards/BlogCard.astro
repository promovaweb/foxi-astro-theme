---
// Cartão de Blog (Blog Card)
// ------------
// Descrição: O componente de cartão de blog
// Propriedades:
// - Title: o título do cartão
// - Subtitle: o subtítulo do cartão
// - Image: a imagem principal do cartão
// - Icon: o ícone do cartão
// - Link: o link para a postagem do blog
// - classes: classes extras
// - Tags: as tags da postagem do blog
// Referência: https://wind-ui.com/components/cards/

// Componentes
// - UI
import { Image } from 'astro:assets'
import Card from '@components/ui/cards/partials/Card.astro'
import CardBody from '@components/ui/cards/partials/CardBody.astro'
import Badge from '@components/ui/Badge.astro'

// Props
type Props = {
	title?: string
	subtitle?: string
	image?: any
	link?: string
	classes?: string
	tags?: string[]
}
const {
	title = '',
	subtitle,
	image,
	link,
	classes,
	tags
} = Astro.props

const cardClasses = `!shadow-none border border-neutral-100 dark:border-neutral-800 relative group h-full ${classes || ''}`
---

<Card classes={cardClasses}>
	{
		image && (
			<div class="overflow-hidden aspect-[16/10]">
				<Image
					src={image}
					alt={title}
					width={600}
					height={400}
					class="transition-transform duration-500 group-hover:scale-105 h-full w-full object-cover"
				/>
			</div>
		)
	}
	<CardBody classes="flex-1">
		<h3 class="post-title">
			<a href={link} class="after:absolute after:inset-0">{title}</a>
		</h3>
		<h4 class="post-subtitle">{subtitle}</h4>
		<div class="line-clamp-3 text-neutral-600 dark:text-neutral-400">
			<slot />
		</div>
	</CardBody>

	{
		tags && (
			<div class="post-tags relative z-20 mt-auto">
				{tags.map((tag: string) => (
					<Badge name={tag} link={`/blog/tags/` + tag} classes="capitalize" />
				))}
			</div>
		)
	}
</Card>

<style>
	.post-title {
		@apply mb-0 text-xl transition-colors group-hover:text-primary-500 [&_a]:text-inherit;
	}
	.post-subtitle {
		@apply mb-6 text-sm font-normal text-neutral-400 dark:text-neutral-400;
	}
	.post-tags {
		@apply flex gap-2 border-t border-neutral-100 px-6 py-4 dark:border-neutral-800;
	}
</style>
