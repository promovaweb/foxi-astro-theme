---
// Cartão Básico (Basic Card)
// ------------
// Descrição: O componente de cartão básico
// Propriedades:
// - Title: o título do cartão
// - Subtitle: o subtítulo do cartão
// - TitleSize: o tamanho do título
// - Image: a imagem principal do cartão
// - Icon: o ícone do cartão
// - Link: se fornecido, o cartão será um link
// - Type: Image-top ou Image-bottom (refere-se à posição da imagem)
// - classes: classes extras
// Referência: https://wind-ui.com/components/cards/

// Componentes
// - UI
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import Card from '@components/ui/cards/partials/Card.astro'
import CardBody from '@components/ui/cards/partials/CardBody.astro'

// Props
type Props = {
	title?: string
	subtitle?: string
	titleSize?: 'sm' | 'base' | 'lg' | 'xl'
	image?: any
	icon?: string
	link?: string
	type?: 'image-top' | 'image-bottom'
	classes?: string
}
const { title = '', subtitle, titleSize = 'lg', image, icon, link, type, classes } = Astro.props
---

<Card classes={classes} link={link}>
	{
		image && (
			<Image
				src={image}
				alt={title}
				class={type === 'image-bottom' ? 'order-2' : ''}
				width={600}
				height={400}
			/>
		)
	}
	{
		icon && (
			<div class="px-6 pt-6">
				<Icon name={`${icon}`} class="card__icon" />
			</div>
		)
	}
	<CardBody>
		{
			title && (
				<h3 class:list={[['text-' + `${titleSize} ` + `lg:text` + `${titleSize}`]]}>{title}</h3>
			)
		}
		{subtitle && <p>{subtitle}</p>}
		<slot />
	</CardBody>
</Card>
<style>
	.card__icon {
		@apply inline-block size-6 shrink-0 text-primary-500;
	}
</style>
