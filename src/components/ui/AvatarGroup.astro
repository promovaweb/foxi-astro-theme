---
// Avatar
// ------------
// Descrição: um grupo de avatars
// Propriedades:
// - Size: o tamanho do avatar (lg, base, sm, xs)
// - Avatars: os avatars do grupo
// - Radius: o raio do avatar
// - classes: classes adicionais
// Referência: https://wind-ui.com/components/avatars/

// Componentes
// - UI
import Avatar from '@components/ui/Avatar.astro'

// Props
type Props = {
	size?: 'lg' | 'base' | 'sm' | 'xs'
	avatars: Array<any>
	radius?: string
	classes?: string
}
const { size = 'base', avatars, radius = 'rounded', classes } = Astro.props
---

<span class:list={['avatar-group', { [`${classes}`]: classes }]}>
	{
		avatars.map((item) => (
			<Avatar
				size={size}
				image={item.image}
				link={item.link}
				radius={radius}
				classes="-mx-2 first:ml-0"
			/>
		))
	}
</span>

<style>
	.avatar-group {
		@apply flex -space-x-2;
	}
</style>
