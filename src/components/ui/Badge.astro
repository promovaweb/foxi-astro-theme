---
// Badge
// ------------
// Descrição: Um badge é um indicador visual que chama a atenção para um elemento da interface. Ele aprimora o componente ao qual está anexado com informações adicionais.
// Propriedades:
// - Name: o texto do badge
// - Link: o link do badge (opcional)
// - Type: o tipo do badge (neutral, primary)
// - Classes: classes adicionais

// Referência: https://wind-ui.com/components/badges/

// Props
type Props = {
	name: string
	link?: string
	type?: string
	classes?: string
}
const { name, link, type = 'neutral', classes } = Astro.props
---

{
	link ? (
		<a
			href={link}
			class:list={['badge', { [`${classes}`]: classes }, { [`badge--${type}`]: type }]}
		>
			{name}
		</a>
	) : (
		<span class:list={['badge', { [`${classes}`]: classes }, { [`badge--${type}`]: type }]}>
			{name}
		</span>
	)
}

<style>
	.badge {
		@apply inline-flex items-center justify-center gap-1 rounded px-1.5 py-1 text-sm transition-colors;
	}
	.badge--neutral {
		@apply bg-neutral-100 text-neutral-500 dark:bg-neutral-800 dark:text-neutral-500;
	}
	.badge--primary {
		@apply bg-primary-500 text-white;
	}
</style>
