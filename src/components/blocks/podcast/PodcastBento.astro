---
/**
 * Componente: PodcastBento
 * Descrição: Uma vitrine em estilo Bento Grid para o podcast com refinamentos visuais.
 * Exibe a capa em destaque e os 4 episódios mais recentes.
 */

import Section from '@components/ui/Section.astro'
import Row from '@components/ui/Row.astro'
import Col from '@components/ui/Col.astro'
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import { getCollection } from 'astro:content'
import { configData } from '@config'
import posterImage from '@/assets/podcast-poster.png'

// Buscar episódios recentes
const allEpisodes = await getCollection('podcast')
const recentEpisodes = allEpisodes
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4)

// Se não houver episódios, não renderiza nada
if (allEpisodes.length === 0 || !configData.podcastEnabled) {
	return null
}
---

<Section id="podcast-bento" classes="bg-neutral-50 dark:bg-neutral-900/40">
	<Row classes="mb-12 lg:mb-16">
		<Col span="12" align="center">
			<div class="mb-4 inline-flex items-center gap-2 rounded-full bg-primary-500/10 px-4 py-1.5 text-xs font-black uppercase tracking-[0.2em] text-primary-600 dark:text-primary-400">
				🎙️ Explore nosso conteúdo
			</div>
			<h2 class="text-4xl font-black tracking-tight text-neutral-900 dark:text-white lg:text-5xl">
				Ouça nosso <strong>Podcast</strong>
			</h2>
			<p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-neutral-600 dark:text-neutral-400">
				Fique por dentro das últimas tendências e insights do mercado de tecnologia através de conversas com especialistas.
			</p>
		</Col>
	</Row>

	<div class="grid grid-cols-1 md:grid-cols-4 md:grid-rows-2 gap-6 lg:gap-8 h-auto lg:h-[650px] px-4 lg:px-0">
		<!-- Card de Destaque (Capa) -->
		<a 
			href="/podcast" 
			class="md:col-span-2 md:row-span-2 group relative flex flex-col justify-end overflow-hidden rounded-[2.5rem] bg-neutral-900 shadow-2xl transition-all duration-500 hover:shadow-primary-500/20"
		>
			<Image 
				src={posterImage} 
				alt="Capa do Podcast" 
				class="absolute inset-0 h-full w-full object-cover opacity-50 transition-transform duration-1000 group-hover:scale-105 group-hover:opacity-40"
			/>
			<!-- Overlay de Gradiente -->
			<div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/40 to-transparent"></div>
			
			<!-- Conteúdo do Destaque -->
			<div class="relative z-10 p-8 lg:p-14">
				<div class="mb-6 inline-flex items-center gap-2 rounded-full bg-primary-500 px-4 py-1.5 text-[10px] font-black uppercase tracking-widest text-white shadow-lg shadow-primary-500/30">
					<Icon name="microphone" class="h-4 w-4" />
					Canal Oficial
				</div>
				<h3 class="text-4xl lg:text-6xl font-black text-white mb-6 leading-[1.1] tracking-tighter">
					{configData.podcastName}
				</h3>
				<p class="text-neutral-300 text-lg lg:text-xl mb-8 max-w-md leading-relaxed opacity-90">
					{configData.podcastDescription}
				</p>
				<div class="inline-flex items-center gap-3 font-black text-primary-400 group-hover:text-primary-300 transition-all group-hover:translate-x-2">
					Explorar todos os episódios <Icon name="long-arrow-right" class="h-6 w-6" />
				</div>
			</div>
		</a>

		<!-- Episódios Recentes -->
		{recentEpisodes.map((episode, index) => (
			<a 
				href={`/podcast/${episode.id}`}
				class="group relative flex flex-col overflow-hidden rounded-[2rem] bg-white dark:bg-neutral-900 p-8 shadow-sm ring-1 ring-neutral-200 dark:ring-neutral-800 transition-all duration-300 hover:ring-primary-500/50 hover:shadow-xl hover:shadow-primary-500/5"
			>
				<div class="flex flex-col h-full relative z-10">
					<div class="mb-6 flex items-center justify-between">
						<span class="inline-flex items-center rounded-full bg-neutral-100 dark:bg-neutral-800 px-3 py-1 text-[10px] font-black uppercase tracking-widest text-neutral-500 dark:text-neutral-400 group-hover:bg-primary-500/10 group-hover:text-primary-500 transition-colors">
							EP #{allEpisodes.length - index}
						</span>
						<Icon name="youtube-icon" class="h-6 w-6 text-neutral-300 group-hover:text-red-500 transition-all duration-300 group-hover:scale-110" />
					</div>
					
					<h4 class="text-xl font-bold leading-tight text-neutral-900 dark:text-white mb-4 line-clamp-2 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
						{episode.data.title}
					</h4>
					
					<p class="text-sm leading-relaxed text-neutral-500 dark:text-neutral-400 line-clamp-3 mb-6">
						{episode.data.description}
					</p>
					
					<div class="mt-auto pt-6 flex items-center justify-between border-t border-neutral-100 dark:border-neutral-800 transition-colors group-hover:border-primary-500/10">
						<div class="flex items-center gap-2 text-[11px] font-bold text-neutral-400 uppercase tracking-wider">
							<Icon name="sun" class="h-3.5 w-3.5" />
							{episode.data.pubDate.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short' })}
						</div>
						<div class="opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300">
							<Icon name="long-arrow-right" class="h-4 w-4 text-primary-500" />
						</div>
					</div>
				</div>
				<!-- Subtle Background Hover Effect -->
				<div class="absolute inset-0 bg-gradient-to-br from-primary-500/0 to-primary-500/0 opacity-0 group-hover:opacity-[0.03] transition-opacity duration-500"></div>
			</a>
		))}
	</div>
</Section>

<style>
	#podcast-bento {
		@apply relative overflow-hidden;
	}
	
	/* Estilização suave para as imagens e cards */
	.line-clamp-2 {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	
	.line-clamp-3 {
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>
