---
// CTA de Texto Centralizado
// ------------
// Descrição: Uma seção simples de chamada para ação centralizada com um título, descrição e dois botões.
// Propriedades:
// - title: O título da seção de CTA
// - text: O texto de descrição da seção de CTA
// - primaryButton: Objeto com nome e link para a ação primária
// - secondaryButton: Objeto com nome e link para a ação secundária

// Components
// - UI
import Section from '@components/ui/Section.astro'
import Row from '@components/ui/Row.astro'
import Col from '@components/ui/Col.astro'
import Button from '@components/ui/Button.astro'

interface ButtonProps {
	name: string
	link: string
}

type Props = {
	title?: string
	text?: string
	primaryButton?: ButtonProps
	secondaryButton?: ButtonProps
}

const {
	title = 'Aumente sua produtividade. <strong>Comece a usar nosso app hoje.</strong>',
	text = 'Nossa plataforma oferece as ferramentas necessárias para você otimizar suas tarefas diárias e alcançar seus objetivos com mais eficiência.',
	primaryButton = { name: 'Começar agora', link: '/' },
	secondaryButton = { name: 'Saiba mais', link: '/' }
} = Astro.props
---

<Section id="centered-text-cta" classes="centered-text-cta bg-white dark:bg-neutral-950">
	<Row>
		<Col span="12" align="center">
			<div class="mx-auto max-w-2xl text-center">
				<h2
					class="centered-text-cta__title text-4xl font-bold tracking-tight text-neutral-900 sm:text-5xl dark:text-white"
					set:html={title}
				/>
				<p class="centered-text-cta__text mx-auto mt-6 max-w-xl text-lg leading-8 text-neutral-600 dark:text-neutral-400">
					{text}
				</p>
				<div class="centered-text-cta__actions mt-10 flex items-center justify-center gap-x-6">
					<Button size="lg" link={primaryButton.link} style="primary" elevated>
						{primaryButton.name}
					</Button>
					<Button size="lg" link={secondaryButton.link} style="neutral" variation="link">
						{secondaryButton.name} <span aria-hidden="true" class="ml-1">→</span>
					</Button>
				</div>
			</div>
		</Col>
	</Row>
</Section>

<style>
	.centered-text-cta__title {
		@apply text-balance;
	}
	.centered-text-cta__text {
		@apply text-pretty;
	}
</style>
