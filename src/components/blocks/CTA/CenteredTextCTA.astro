---
// Centered Text CTA
// ------------
// Description: A simple centered call to action section with a title, description and two buttons.
// Properties:
// - title: The title of the CTA section
// - text: The description text of the CTA section
// - primaryButton: Object with name and link for the primary action
// - secondaryButton: Object with name and link for the secondary action

// Components
// - UI
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
import Button from '../../ui/Button.astro'

interface ButtonProps {
	name: string
	link: string
}

type Props = {
	title?: string
	text?: string
	primaryButton?: ButtonProps
	secondaryButton?: ButtonProps
}

const {
	title = 'Aumente sua produtividade. <strong>Comece a usar nosso app hoje.</strong>',
	text = 'Incididunt sint fugiat pariatur cupidatat consectetur sit cillum anim id veniam aliqua proident excepteur commodo do ea.',
	primaryButton = { name: 'Começar agora', link: '/' },
	secondaryButton = { name: 'Saiba mais', link: '/' }
} = Astro.props
---

<Section id="centered-text-cta" classes="centered-text-cta bg-white dark:bg-neutral-950">
	<Row>
		<Col span="12" align="center">
			<div class="mx-auto max-w-2xl text-center">
				<h2
					class="centered-text-cta__title text-4xl font-bold tracking-tight text-neutral-900 sm:text-5xl dark:text-white"
					set:html={title}
				/>
				<p class="centered-text-cta__text mx-auto mt-6 max-w-xl text-lg leading-8 text-neutral-600 dark:text-neutral-400">
					{text}
				</p>
				<div class="centered-text-cta__actions mt-10 flex items-center justify-center gap-x-6">
					<Button size="lg" link={primaryButton.link} style="primary" elevated>
						{primaryButton.name}
					</Button>
					<Button size="lg" link={secondaryButton.link} style="neutral" variation="link">
						{secondaryButton.name} <span aria-hidden="true" class="ml-1">→</span>
					</Button>
				</div>
			</div>
		</Col>
	</Row>
</Section>

<style>
	.centered-text-cta__title {
		@apply text-balance;
	}
	.centered-text-cta__text {
		@apply text-pretty;
	}
</style>
