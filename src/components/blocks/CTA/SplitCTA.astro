---
// Split CTA
// ------------
// Description: A call to action section with a full-height image on one side and content on the other.
// Properties:
// - badge: Optional text for the top badge
// - title: The main title of the section
// - text: The description text of the section
// - button: Object with name and link for the CTA action
// - image: Object with src and alt for the side image

// Components
// - UI
import Section from '../../ui/Section.astro'
import Button from '../../ui/Button.astro'

interface ButtonProps {
	name: string
	link: string
}

interface ImageProps {
	src: string
	alt: string
}

type Props = {
	badge?: string
	title?: string
	text?: string
	button?: ButtonProps
	image?: ImageProps
}

const {
	badge = 'Suporte premiado',
	title = 'Estamos aqui para <strong>ajudar</strong>',
	text = 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Et, egestas tempus tellus etiam sed. Quam a scelerisque amet ullamcorper eu enim et fermentum, augue. Aliquet amet volutpat quisque ut interdum tincidunt duis.',
	button = { name: 'Visite a central de ajuda', link: '/' },
	image = {
		src: 'https://images.unsplash.com/photo-1525130413817-d45c1d127c42?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=1920&q=60&blend=6366F1&sat=-100&blend-mode=multiply',
		alt: 'Split CTA support background'
	}
} = Astro.props
---

<Section id="split-cta" fullWidth={true} padding="none" classes="split-cta relative bg-white dark:bg-neutral-950">
	<div class="relative h-80 overflow-hidden bg-primary-600 md:absolute md:left-0 md:h-full md:w-1/3 lg:w-1/2">
		<img
			alt={image.alt}
			src={image.src}
			class="h-full w-full object-cover"
		/>
		<svg
			viewBox="0 0 926 676"
			aria-hidden="true"
			class="absolute -bottom-24 left-24 w-[57.875rem] transform-gpu blur-[118px]"
		>
			<path
				d="m254.325 516.708-90.89 158.331L0 436.427l254.325 80.281 163.691-285.15c1.048 131.759 36.144 345.144 168.149 144.613C751.171 125.508 707.17-93.823 826.603 41.15c95.546 107.978 104.766 294.048 97.432 373.585L685.481 297.694l16.974 360.474-448.13-141.46Z"
				fill="url(#60c3c621-93e0-4a09-a0e6-4c228a0116d8)"
				fill-opacity=".4"
			/>
			<defs>
				<linearGradient
					id="60c3c621-93e0-4a09-a0e6-4c228a0116d8"
					x1="926.392"
					x2="-109.635"
					y1=".176"
					y2="321.024"
					gradientUnits="userSpaceOnUse"
				>
					<stop stop-color="#776FFF"></stop>
					<stop offset="1" stop-color="#FF4694"></stop>
				</linearGradient>
			</defs>
		</svg>
	</div>
	
	<div class="relative mx-auto max-w-7xl py-24 sm:py-32 lg:px-8 lg:py-40">
		<div class="px-6 md:ml-auto md:w-2/3 md:pl-16 lg:w-1/2 lg:pl-24 lg:pr-0 xl:pl-32">
			{badge && <h2 class="split-cta__badge text-base font-semibold leading-7 text-primary-600 dark:text-primary-500">{badge}</h2>}
			<p class="split-cta__title mt-2 text-4xl font-bold tracking-tight text-neutral-900 sm:text-5xl dark:text-white" set:html={title} />
			<p class="split-cta__text mt-6 text-base leading-7 text-neutral-600 dark:text-neutral-400">
				{text}
			</p>
			<div class="split-cta__actions mt-8">
				<Button link={button.link} style="primary" size="lg" elevated>
					{button.name}
				</Button>
			</div>
		</div>
	</div>
</Section>

<style>
	.split-cta__title {
		@apply text-balance;
	}
	.split-cta__text {
		@apply text-pretty;
	}
</style>
