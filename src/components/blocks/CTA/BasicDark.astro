---
// Seção de Chamada para Ação Básica Escura
// ------------
// Descrição: Uma seção de chamada para ação centralizada que contém: um título, texto, imagem de fundo, notificação e um botão.

// Components
// - Layout
import Section from '@components/ui/Section.astro'
import Row from '@components/ui/Row.astro'
import Col from '@components/ui/Col.astro'
// - UI
import CTA from '@components/ui/CTA.astro'
import Button from '@components/ui/Button.astro'
import ChipNotification from '@components/ui/ChipNotification.astro'
import { Image } from 'astro:assets'
import Highlight from '@components/ui/Highlight.astro'

// Content
import ctaImage from '@/assets/cta-dark-bg.webp'
import badge from '@/assets/badge.svg'
---

<Section>
	<Row>
		<Col span="1" />
		<Col span="10">
			<CTA
				title="Junte-se a Mais de 30.000 Usuários Satisfeitos!"
				text="Descubra por que milhares de profissionais confiam em nossa plataforma para simplificar seu fluxo de trabalho e aumentar a produtividade. Comece hoje mesmo e veja a diferença por si mesmo!"
				mode="dark"
				bg={ctaImage}
			>
				<ChipNotification radius="rounded-full" classes="mb-6 box">
					<Image src={badge} alt="Produto do Ano" class="h-12 w-12" slot="button" />
					<span class="hidden md:block">#1 Produto do Ano,</span>
					<Highlight classes="md:ml-2"> Product Hunt </Highlight>
				</ChipNotification>
				<Button size="lg" style="primary"> Comece agora mesmo! </Button>
			</CTA>
		</Col>
		<Col span="1" />
	</Row>
</Section>
