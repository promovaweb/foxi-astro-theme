---
// CTA Simples
// ------------
// Descrição: Uma seção simples de chamada para ação com um título e dois botões.
// Propriedades:
// - title: O título da seção de CTA
// - primaryButton: Objeto com nome e link para a ação primária
// - secondaryButton: Objeto com nome e link para a ação secundária

// Components
// - UI
import Section from '@components/ui/Section.astro'
import Row from '@components/ui/Row.astro'
import Col from '@components/ui/Col.astro'
import Button from '@components/ui/Button.astro'

interface ButtonProps {
	name: string
	link: string
}

type Props = {
	title?: string
	primaryButton?: ButtonProps
	secondaryButton?: ButtonProps
}

const {
	title = 'Aumente sua produtividade. <strong>Comece a usar nosso app hoje.</strong>',
	primaryButton = { name: 'Começar agora', link: '/' },
	secondaryButton = { name: 'Saiba mais', link: '/' }
} = Astro.props
---

<Section id="simple-cta" classes="simple-cta bg-white dark:bg-neutral-950">
	<Row>
		<Col span="12" classes="mx-auto max-w-7xl">
			<h2
				class="simple-cta__title max-w-2xl text-4xl font-bold tracking-tight text-neutral-900 sm:text-5xl dark:text-white"
				set:html={title}
			/>
			<div class="simple-cta__actions mt-10 flex items-center gap-x-6">
				<Button size="lg" link={primaryButton.link} style="primary" elevated>
					{primaryButton.name}
				</Button>
				<Button size="lg" link={secondaryButton.link} style="neutral" variation="link">
					{secondaryButton.name} <span aria-hidden="true" class="ml-1">→</span>
				</Button>
			</div>
		</Col>
	</Row>
</Section>

<style>
	.simple-cta__title {
		@apply text-balance;
	}
</style>
