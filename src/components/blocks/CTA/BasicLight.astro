---
// Seção de Chamada para Ação Básica Clara
// ------------
// Descrição: Uma seção de chamada para ação centralizada que contém: um título, texto, uma avaliação e um botão.

// Components
// - Layout
import Section from '@components/ui/Section.astro'
import Row from '@components/ui/Row.astro'
import Col from '@components/ui/Col.astro'
// - UI
import CTA from '@components/ui/CTA.astro'
import Button from '@components/ui/Button.astro'
import Ratings from '@components/ui/Rating.astro'
---

<Section>
	<Row>
		<Col span="1" />
		<Col span="10">
			<CTA
				title="Junte-se à Revolução Foxi!"
				text="Descubra por que milhares de profissionais confiam em nossa plataforma para simplificar seu fluxo de trabalho e aumentar a produtividade. Comece hoje mesmo e veja a diferença por si mesmo!"
				classes="!shadow-none"
			>
				<Ratings rating={5} text="30 mil avaliações de clientes" classes="mb-4" />
				<Button size="lg" style="primary"> Comece agora mesmo! </Button>
			</CTA>
		</Col>
		<Col span="1" />
	</Row>
</Section>
