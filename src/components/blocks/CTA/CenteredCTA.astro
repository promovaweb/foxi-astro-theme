---
// CTA Centralizado
// ------------
// Descrição: Uma seção de chamada para ação centralizada com um fundo escuro, sombra, cantos arredondados e um gradiente radial decorativo.
// Propriedades:
// - title: O título da seção de CTA
// - text: O texto de descrição da seção de CTA
// - primaryButton: Objeto com nome e link para a ação primária
// - secondaryButton: Objeto com nome e link para a ação secundária

// Components
// - UI
import Section from '@components/ui/Section.astro'
import Row from '@components/ui/Row.astro'
import Col from '@components/ui/Col.astro'
import Button from '@components/ui/Button.astro'

interface ButtonProps {
	name: string
	link: string
}

type Props = {
	title?: string
	text?: string
	primaryButton?: ButtonProps
	secondaryButton?: ButtonProps
}

const {
	title = 'Aumente sua produtividade hoje',
	text = 'Descubra como nossa solução pode transformar seu fluxo de trabalho, proporcionando agilidade e clareza em cada etapa do seu projeto.',
	primaryButton = { name: 'Começar agora', link: '/' },
	secondaryButton = { name: 'Saiba mais', link: '/' }
} = Astro.props
---

<Section id="centered-cta" classes="centered-cta bg-white dark:bg-neutral-950">
	<Row>
		<Col span="12">
			<div
				class="centered-cta__box relative isolate overflow-hidden bg-neutral-900 px-6 py-24 text-center shadow-2xl sm:rounded-3xl sm:px-16"
			>
				<h2
					class="centered-cta__title text-4xl font-bold tracking-tight text-white sm:text-5xl"
					set:html={title}
				/>
				<p class="centered-cta__text mx-auto mt-6 max-w-xl text-lg leading-8 text-neutral-300">
					{text}
				</p>
				<div class="centered-cta__actions mt-10 flex items-center justify-center gap-x-6">
					<!-- Custom styled white button to match original exactly -->
					<a
						href={primaryButton.link}
						class="rounded-md bg-white px-3.5 py-2.5 text-sm font-semibold text-neutral-900 shadow-sm hover:bg-neutral-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
					>
						{primaryButton.name}
					</a>
					<Button link={secondaryButton.link} style="white" variation="link">
						{secondaryButton.name} <span aria-hidden="true" class="ml-1">→</span>
					</Button>
				</div>
				<svg
					viewBox="0 0 1024 1024"
					aria-hidden="true"
					class="centered-cta__svg absolute left-1/2 top-1/2 -z-10 h-[64rem] w-[69rem] -translate-x-1/2 -translate-y-1/2 [mask-image:radial-gradient(closest-side,white,transparent)]"
				>
					<circle
						cx="512"
						cy="512"
						r="512"
						fill="url(#827591b1-ce8c-4110-b064-7cb85a0b1217)"
						fill-opacity="0.7"></circle>
					<defs>
						<radialGradient id="827591b1-ce8c-4110-b064-7cb85a0b1217">
							<stop stop-color="#7775D6"></stop>
							<stop offset="1" stop-color="#E935C1"></stop>
						</radialGradient>
					</defs>
				</svg>
			</div>
		</Col>
	</Row>
</Section>

<style>
	.centered-cta__title {
		@apply text-balance;
	}
	.centered-cta__text {
		@apply text-pretty;
	}
</style>
