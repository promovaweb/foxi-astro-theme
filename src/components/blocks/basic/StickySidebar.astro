---
// Seção de Barra Lateral Fixa
// ------------
// Descrição: Uma seção com uma barra lateral fixa. O conteúdo da barra lateral fixa usa o slot "sidebar".
// Propriedades:
// - id: O ID da seção
// - type: determina a posição da barra lateral fixa (esquerda ou direita)
// - classes: Classes adicionais a serem adicionadas à seção

// Components
// - Layout
import Section from '@components/ui/Section.astro'
import Row from '@components/ui/Row.astro'
import Col from '@components/ui/Col.astro'

// Props
type Props = {
	id?: string
	type?: 'left' | 'right'
	classes?: string
	padding?: 'both' | 'top' | 'bottom' | 'none'
}
const { id, type = 'left', classes, padding } = Astro.props
---

<Section {...id ? { id } : {}} classes={classes} padding={padding} stickyCol>
	<Row>
		<Col span="3" classes={type === 'right' ? 'lg:order-2' : ''}>
			<div class="sticky-sidebar">
				<slot name="sidebar" />
			</div>
		</Col>
		<Col span="9">
			<slot />
		</Col>
	</Row>
</Section>

<style>
	.sticky-sidebar {
		@apply lg:sticky lg:top-32;
	}
</style>
