---
// Social Proof Section
// ------------
// Description: A section with logos of social media platforms to enchance the trust of the users.

// Components
// - Layout
import Section from '@components/ui/Section.astro'
import Row from '@components/ui/Row.astro'
import Col from '@components/ui/Col.astro'
// - UI
import { Image } from 'astro:assets'

// Content
import airtable from '@/assets/logos/airtable-logo.svg'
import asana from '@/assets/logos/asana-logo.svg'
import basecamp from '@/assets/logos/basecamp-logo.svg'
import evernote from '@/assets/logos/evernote-logo.svg'
import notion from '@/assets/logos/notion-logo.svg'
import slack from '@/assets/logos/slack-logo.svg'

const images = [
	{
		image: airtable,
		alt: 'Logotipo da Airtable'
	},
	{
		image: asana,
		alt: 'Logotipo da Asana'
	},
	{
		image: basecamp,
		alt: 'Logotipo da Basecamp'
	},
	{
		image: evernote,
		alt: 'Logotipo da Evernote'
	},
	{
		image: notion,
		alt: 'Logotipo da Notion'
	},
	{
		image: slack,
		alt: 'Logotipo da Slack'
	}
]

// Props
type Props = {
	classes?: string
}
const { classes } = Astro.props
---

<Section padding="bottom" classes={classes}>
	<Row>
		<Col span="12" align="center">
			<h2 class="!mb-6 text-base font-normal text-neutral-400 dark:text-neutral-600">
				Confiado por mais de <strong class="highlight">50.000</strong> empresas
			</h2></Col
		>
	</Row>
	<Row flex classes="!flex-row">
		{
			images.map((item) => (
				<Col>
					<Image src={item.image} alt={item.alt} />
				</Col>
			))
		}
	</Row>
</Section>
