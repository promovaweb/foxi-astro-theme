---
// Split Hero
// ------------
// Description: An exact adaptation of the Tailwind UI Split Hero.
// Properties:
// - title: The title of the hero section
// - text: The description text of the hero section
// - primaryButton: Object with name and link for the primary action
// - secondaryButton: Object with name and link for the secondary action
// - badge: Optional text for the highlight badge
// - badgeText: Optional secondary text for the highlight badge
// - badgeLink: Optional link for the highlight badge
// - image: Object with src, alt, width and height for the hero image

// Components
// - UI
import Section from '@components/ui/Section.astro'
import Button from '@components/ui/Button.astro'
import { Icon } from 'astro-icon/components'

interface ButtonProps {
	name: string
	link: string
}

interface ImageProps {
	src: any
	alt: string
	width?: number
	height?: number
}

type Props = {
	title?: string
	text?: string
	primaryButton?: ButtonProps
	secondaryButton?: ButtonProps
	badge?: string
	badgeText?: string
	badgeLink?: string
	image?: ImageProps
}

// Default Image
const defaultScreenshot = "https://tailwindcss.com/plus-assets/img/component-images/project-app-screenshot.png"

const {
	title = 'Deploy para a nuvem com <strong>confiança total</strong>',
	text = 'Anim aute id magna aliqua ad ad non deserunt sunt. Qui irure qui lorem cupidatat commodo. Elit sunt amet fugiat veniam occaecat.',
	primaryButton = { name: 'Começar agora', link: '/' },
	secondaryButton = { name: 'Saiba mais', link: '/' },
	badge = "O que há de novo",
	badgeText = "Acabamos de lançar a v1.0",
	badgeLink = "/",
	image = { src: defaultScreenshot, alt: 'App screenshot', width: 2432, height: 1442 }
} = Astro.props
---

<Section id="split-hero" fullWidth={true} padding="none" classes="relative isolate overflow-hidden bg-white dark:bg-neutral-950">
	<!-- Background SVG Pattern -->
	<svg
		aria-hidden="true"
		class="absolute inset-0 -z-10 h-full w-full stroke-neutral-200 [mask-image:radial-gradient(100%_100%_at_top_right,white,transparent)] dark:stroke-neutral-800"
	>
		<defs>
			<pattern
				x="50%"
				y="-1"
				id="983e3e4c-de6d-4c3f-8d64-b9761d1534cc"
				width="200"
				height="200"
				patternUnits="userSpaceOnUse"
			>
				<path d="M.5 200V.5H200" fill="none"></path>
			</pattern>
		</defs>
		<svg x="50%" y="-1" class="overflow-visible fill-neutral-50 dark:fill-neutral-900/20">
			<path
				d="M-200 0h201v201h-201Z M600 0h201v201h-201Z M-400 600h201v201h-201Z M200 800h201v201h-201Z"
				stroke-width="0"></path>
		</svg>
		<rect width="100%" height="100%" stroke-width="0" fill="url(#983e3e4c-de6d-4c3f-8d64-b9761d1534cc)"></rect>
	</svg>

	<!-- Decorative Blob -->
	<div
		aria-hidden="true"
		class="absolute top-10 left-[calc(50%-4rem)] -z-10 transform-gpu blur-3xl sm:left-[calc(50%-18rem)] lg:top-[calc(50%-30rem)] lg:left-48 xl:left-[calc(50%-24rem)]"
	>
		<div
			style={{
				clipPath:
					'polygon(73.6% 51.7%, 91.7% 11.8%, 100% 46.4%, 97.4% 82.2%, 92.5% 84.9%, 75.7% 64%, 55.3% 47.5%, 46.5% 49.4%, 45% 62.9%, 50.3% 87.2%, 21.3% 64.1%, 0.1% 100%, 5.4% 51.1%, 21.4% 63.9%, 58.9% 0.2%, 73.6% 51.7%)'
			}}
			class="aspect-[1108/632] w-[69.25rem] bg-gradient-to-r from-[#80caff] to-[#4f46e5] opacity-20 dark:opacity-30"
		>
		</div>
	</div>

	<div class="mx-auto max-w-7xl px-6 pt-10 pb-24 sm:pb-32 lg:flex lg:px-8 lg:py-40">
		<div class="mx-auto max-w-2xl shrink-0 lg:mx-0 lg:pt-8">
			<!-- Logo/Brand Image -->
			<img
				alt="Your Company"
				src="/logo.svg"
				class="h-11 w-auto dark:invert"
			/>
			
			<div class="mt-24 sm:mt-32 lg:mt-16">
				<a href={badgeLink} class="inline-flex space-x-6">
					<span class="rounded-full bg-primary-500/10 px-3 py-1 text-sm font-semibold leading-6 text-primary-500 ring-1 ring-inset ring-primary-500/20">
						{badge}
					</span>
					<span class="inline-flex items-center space-x-2 text-sm font-medium leading-6 text-neutral-600 dark:text-neutral-400">
						<span>{badgeText}</span>
						<Icon name="chevron-down" class="h-5 w-5 -rotate-90 text-neutral-400" />
					</span>
				</a>
			</div>

			<h1
				class="mt-10 text-5xl font-bold tracking-tight text-neutral-900 sm:text-7xl dark:text-white"
				set:html={title}
			/>
			
			<p class="mt-8 text-lg font-medium text-neutral-600 sm:text-xl leading-8 dark:text-neutral-400">
				{text}
			</p>

			<div class="mt-10 flex items-center gap-x-6">
				<Button size="lg" link={primaryButton.link} style="primary" elevated>
					{primaryButton.name}
				</Button>
				<Button size="lg" link={secondaryButton.link} style="neutral" variation="link">
					{secondaryButton.name} <span aria-hidden="true" class="ml-1">→</span>
				</Button>
			</div>
		</div>

		<div class="mx-auto mt-16 flex max-w-2xl sm:mt-24 lg:mt-0 lg:mr-0 lg:ml-10 lg:max-w-none lg:flex-none xl:ml-32">
			<div class="max-w-3xl flex-none sm:max-w-5xl lg:max-w-none">
				<img
					alt={image.alt}
					src={image.src}
					width={image.width}
					height={image.height}
					class="w-[76rem] rounded-md bg-neutral-50 shadow-2xl ring-1 ring-neutral-900/10 dark:bg-neutral-900 dark:ring-white/10"
				/>
			</div>
		</div>
	</div>
</Section>

<style>
	h1 {
		@apply text-pretty;
	}
	p {
		@apply text-pretty;
	}
</style>
