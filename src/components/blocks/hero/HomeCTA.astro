---
// Seção de CTA da página inicial
// ------------
// Descrição: Uma seção de chamada para ação centralizada que contém: um título, texto, um trecho de avaliação de usuário, um botão e uma imagem.

// Componentes
// - Layout
import Section from '@components/ui/Section.astro'
import Row from '@components/ui/Row.astro'
import Col from '@components/ui/Col.astro'
// - UI
import ChipNotification from '@components/ui/ChipNotification.astro'
import { Image } from 'astro:assets'
import Button from '@components/ui/Button.astro'
import AvatarGroup from '@components/ui/AvatarGroup.astro'

// Conteúdo
// - Imagem de Herói
import heroImage from '@/assets/hero-01.png'
// - Avatares
import user1 from '@/assets/avatars/avatar-01.webp'
import user2 from '@/assets/avatars/avatar-02.webp'
import user3 from '@/assets/avatars/avatar-03.webp'
const avatars = [
	{ image: { src: user1.src, alt: 'nome do usuário' }, link: '/' },
	{ image: { src: user2.src, alt: 'nome do usuário' }, link: '/' },
	{ image: { src: user3.src, alt: 'nome do usuário' }, link: '/' }
]
---

<Section id="intro" padding="top" classes="bg-neutral-50 dark:bg-neutral-900">
	<Row>
		<Col span="2" />
		<Col span="8" align="center">
			<ChipNotification radius="rounded-full" classes="mb-6">
				Mais de <strong>30 mil</strong> clientes satisfeitos
				<AvatarGroup avatars={avatars} radius="rounded-full" slot="button" />
			</ChipNotification>
			<h1>Aumente o desempenho da <strong>equipe</strong> com integração perfeita</h1>

			<p class="pb-0 text-lg">Trabalhe de forma mais inteligente, não mais difícil, com nossa plataforma inovadora</p>
			<Button size="lg" link="/">Comece gratuitamente</Button>
		</Col>
		<Col span="2" />
		<Col span="2" />
		<Col span="8">
			<Image
				src={heroImage}
				alt="Foxi. O tema Astro com Tailwind"
				class="translate-y-8 shadow-2xl shadow-neutral-200 dark:shadow-neutral-950"
				format="webp"
			/></Col
		>
		<Col span="2" />
	</Row>
</Section>
