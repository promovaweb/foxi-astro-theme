---
// Half Image Hero
// ------------
// Description: A hero section with content on one side and a full-height image on the other.
// Properties:
// - title: The title of the hero section
// - text: The description text of the hero section
// - primaryButton: Object with name and link for the primary action
// - secondaryButton: Object with name and link for the secondary action
// - notification: Optional text for the top notification chip
// - notificationLink: Optional link for the notification chip
// - image: Object with src and alt for the hero image

// Components
// - UI
import Section from '@components/ui/Section.astro'
import Button from '@components/ui/Button.astro'

interface ButtonProps {
	name: string
	link: string
}

interface ImageProps {
	src: string
	alt: string
}

type Props = {
	title?: string
	text?: string
	primaryButton?: ButtonProps
	secondaryButton?: ButtonProps
	notification?: string
	notificationLink?: string
	image?: ImageProps
}

const {
	title = 'Dados para enriquecer o seu <strong>negócio</strong>',
	text = 'Anim aute id magna aliqua ad ad non deserunt sunt. Qui irure qui lorem cupidatat commodo. Elit sunt amet fugiat veniam occaecat.',
	primaryButton = { name: 'Começar agora', link: '/' },
	secondaryButton = { name: 'Saiba mais', link: '/' },
	notification = 'Anim aute id magna aliqua ad ad non deserunt sunt.',
	notificationLink = '/',
	image = {
		src: 'https://images.unsplash.com/photo-1487017159836-4e23ece2e4cf?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=crop&w=2102&q=80',
		alt: 'Half image hero background'
	}
} = Astro.props
---

<Section id="half-image-hero" fullWidth={true} padding="none" classes="half-image-hero relative bg-white dark:bg-neutral-950">
	<div class="mx-auto max-w-7xl lg:grid lg:grid-cols-12 lg:gap-x-8 lg:px-8">
		<div class="half-image-hero__content px-6 pt-10 pb-24 sm:pb-32 lg:col-span-7 lg:px-0 lg:pt-40 lg:pb-48 xl:col-span-6">
			<div class="mx-auto max-w-lg lg:mx-0">
				<!-- Brand Logo -->
				<img
					alt="Your Company"
					src="/logo.svg"
					class="h-11 w-auto dark:invert"
				/>

				{
					notification && (
						<div class="hidden sm:mt-32 sm:flex lg:mt-16">
							<div class="half-image-hero__notification relative rounded-full px-3 py-1 text-sm leading-6 text-neutral-500 ring-1 ring-neutral-900/10 hover:ring-neutral-900/20 dark:text-neutral-400 dark:ring-neutral-100/10 dark:hover:ring-neutral-100/20">
								{notification}{' '}
								<a href={notificationLink} class="font-semibold whitespace-nowrap text-primary-500">
									<span class="absolute inset-0" aria-hidden="true" />
									Leia mais <span aria-hidden="true">&rarr;</span>
								</a>
							</div>
						</div>
					)
				}

				<h1 class="half-image-hero__title mt-24 text-5xl font-bold tracking-tight text-neutral-900 sm:mt-10 sm:text-7xl dark:text-white" set:html={title} />
				
				<p class="half-image-hero__text mt-8 text-lg font-medium text-neutral-500 sm:text-xl leading-8 dark:text-neutral-400">
					{text}
				</p>

				<div class="half-image-hero__actions mt-10 flex items-center gap-x-6">
					<Button size="lg" link={primaryButton.link} style="primary" elevated>
						{primaryButton.name}
					</Button>
					<Button size="lg" link={secondaryButton.link} style="neutral" variation="link">
						{secondaryButton.name} <span aria-hidden="true" class="ml-1">→</span>
					</Button>
				</div>
			</div>
		</div>

		<div class="half-image-hero__image-container relative lg:col-span-5 lg:-mr-8 xl:absolute xl:inset-0 xl:left-1/2 xl:mr-0">
			<img
				alt={image.alt}
				src={image.src}
				class="half-image-hero__image aspect-[3/2] w-full bg-neutral-50 object-cover lg:absolute lg:inset-0 lg:aspect-auto lg:h-full dark:bg-neutral-900"
			/>
		</div>
	</div>
</Section>

<style>
	.half-image-hero__title {
		@apply text-pretty;
	}
	.half-image-hero__text {
		@apply text-pretty;
	}
</style>
