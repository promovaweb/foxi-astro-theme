---
// Bento Grid Alternative
// ------------
// Description: An asymmetrical bento grid with 6 columns and large feature images.

// Components
// - Layout
import Section from '@components/ui/Section.astro'

type Props = {
	badge?: string
	title?: string
}

const {
	badge = 'Deploy mais rápido',
	title = 'Tudo o que você precisa para fazer o deploy do seu app'
} = Astro.props
---

<Section id="bento-alternative" classes="bg-neutral-50 dark:bg-neutral-900/50">
	<div class="mx-auto max-w-2xl lg:max-w-7xl">
		<h2 class="text-base font-semibold leading-7 text-primary-500">{badge}</h2>
		<p class="mt-2 max-w-lg text-4xl font-bold tracking-tight text-neutral-900 sm:text-5xl dark:text-white" set:html={title} />
		
		<div class="mt-10 grid grid-cols-1 gap-4 sm:mt-16 lg:grid-cols-6 lg:grid-rows-2">
			<!-- Releases -->
			<div class="flex p-px lg:col-span-4">
				<div class="w-full overflow-hidden rounded-lg bg-white dark:bg-neutral-950 shadow-sm ring-1 ring-black/5 dark:ring-white/10 max-lg:rounded-t-[2rem] lg:rounded-tl-[2rem]">
					<img
						alt="Releases preview"
						src="https://tailwindcss.com/plus-assets/img/component-images/bento-02-releases.png"
						class="h-80 w-full object-cover object-left"
					/>
					<div class="p-10">
						<h3 class="text-sm font-semibold text-neutral-500 dark:text-neutral-400">Releases</h3>
						<p class="mt-2 text-lg font-bold tracking-tight text-neutral-900 dark:text-white">Push to deploy</p>
						<p class="mt-2 max-w-lg text-sm leading-6 text-neutral-600 dark:text-neutral-400">
							Lorem ipsum dolor sit amet, consectetur adipiscing elit. In gravida justo et nulla efficitur, maximus egestas sem pellentesque.
						</p>
					</div>
				</div>
			</div>

			<!-- Integrations -->
			<div class="flex p-px lg:col-span-2">
				<div class="w-full overflow-hidden rounded-lg bg-white dark:bg-neutral-950 shadow-sm ring-1 ring-black/5 dark:ring-white/10 lg:rounded-tr-[2rem]">
					<img
						alt="Integrations preview"
						src="https://tailwindcss.com/plus-assets/img/component-images/bento-02-integrations.png"
						class="h-80 w-full object-cover"
					/>
					<div class="p-10">
						<h3 class="text-sm font-semibold text-neutral-500 dark:text-neutral-400">Integrations</h3>
						<p class="mt-2 text-lg font-bold tracking-tight text-neutral-900 dark:text-white">Connect your favorite tools</p>
						<p class="mt-2 max-w-lg text-sm leading-6 text-neutral-600 dark:text-neutral-400">
							Curabitur auctor, ex quis auctor venenatis, eros arcu rhoncus massa.
						</p>
					</div>
				</div>
			</div>

			<!-- Security -->
			<div class="flex p-px lg:col-span-2">
				<div class="w-full overflow-hidden rounded-lg bg-white dark:bg-neutral-950 shadow-sm ring-1 ring-black/5 dark:ring-white/10 lg:rounded-bl-[2rem]">
					<img
						alt="Security preview"
						src="https://tailwindcss.com/plus-assets/img/component-images/bento-02-security.png"
						class="h-80 w-full object-cover"
					/>
					<div class="p-10">
						<h3 class="text-sm font-semibold text-neutral-500 dark:text-neutral-400">Security</h3>
						<p class="mt-2 text-lg font-bold tracking-tight text-neutral-900 dark:text-white">Advanced access control</p>
						<p class="mt-2 max-w-lg text-sm leading-6 text-neutral-600 dark:text-neutral-400">
							Vestibulum ante ipsum primis in faucibus orci luctus et ultrices posuere cubilia.
						</p>
					</div>
				</div>
			</div>

			<!-- Performance -->
			<div class="flex p-px lg:col-span-4">
				<div class="w-full overflow-hidden rounded-lg bg-white dark:bg-neutral-950 shadow-sm ring-1 ring-black/5 dark:ring-white/10 max-lg:rounded-b-[2rem] lg:rounded-br-[2rem]">
					<img
						alt="Performance preview"
						src="https://tailwindcss.com/plus-assets/img/component-images/bento-02-performance.png"
						class="h-80 w-full object-cover object-left"
					/>
					<div class="p-10">
						<h3 class="text-sm font-semibold text-neutral-500 dark:text-neutral-400">Performance</h3>
						<p class="mt-2 text-lg font-bold tracking-tight text-neutral-900 dark:text-white">Lightning-fast builds</p>
						<p class="mt-2 max-w-lg text-sm leading-6 text-neutral-600 dark:text-neutral-400">
							Sed congue eros non finibus molestie. Vestibulum euismod augue vel commodo vulputate. Maecenas at augue sed elit dictum vulputate.
						</p>
					</div>
				</div>
			</div>
		</div>
	</div>
</Section>
