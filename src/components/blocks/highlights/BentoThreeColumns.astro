---
// Bento Grid de Três Colunas
// ------------
// Descrição: Uma grade bento complexa com 3 colunas e 2 linhas, apresentando uma prévia amigável para dispositivos móveis e um trecho de código.

// Componentes
// - Layout
import Section from '@components/ui/Section.astro'

type Props = {
	badge?: string
	title?: string
}

const {
	badge = 'Implantação mais rápida',
	title = 'Tudo o que você precisa para fazer o deploy do seu app'
} = Astro.props
---

<Section id="bento-three-columns" classes="bg-neutral-50 dark:bg-neutral-900/50">
	<div class="mx-auto max-w-2xl lg:max-w-7xl">
		<h2 class="text-center text-base font-semibold leading-7 text-primary-500">{badge}</h2>
		<p class="mx-auto mt-2 max-w-lg text-center text-4xl font-bold tracking-tight text-neutral-900 sm:text-5xl dark:text-white" set:html={title} />
		
		<div class="mt-10 grid gap-4 sm:mt-16 lg:grid-cols-3 lg:grid-rows-2">
			<!-- Amigável para dispositivos móveis -->
			<div class="relative lg:row-span-2">
				<div class="absolute inset-px rounded-lg bg-white dark:bg-neutral-950 lg:rounded-l-[2rem]" />
				<div class="relative flex h-full flex-col overflow-hidden rounded-[calc(0.5rem+1px)] lg:rounded-l-[calc(2rem+1px)]">
					<div class="px-8 pt-8 pb-3 sm:px-10 sm:pt-10 sm:pb-0">
						<p class="mt-2 text-lg font-bold tracking-tight text-neutral-900 dark:text-white max-lg:text-center">
							Amigável para dispositivos móveis
						</p>
						<p class="mt-2 max-w-lg text-sm leading-6 text-neutral-600 dark:text-neutral-400 max-lg:text-center">
							Anim aute id magna aliqua ad ad non deserunt sunt. Qui irure qui lorem cupidatat commodo.
						</p>
					</div>
					<div class="relative min-h-[30rem] w-full grow max-lg:mx-auto max-lg:max-w-sm">
						<div class="absolute inset-x-10 top-10 bottom-0 overflow-hidden rounded-t-[12cqw] border-x-[3cqw] border-t-[3cqw] border-neutral-700 bg-neutral-900 shadow-2xl">
							<img
								alt="Prévia do aplicativo móvel"
								src="https://tailwindcss.com/plus-assets/img/component-images/bento-03-mobile-friendly.png"
								class="h-full w-full object-cover object-top"
							/>
						</div>
					</div>
				</div>
				<div class="pointer-events-none absolute inset-px rounded-lg shadow-sm ring-1 ring-black/5 lg:rounded-l-[2rem] dark:ring-white/10" />
			</div>

			<!-- Desempenho -->
			<div class="relative max-lg:row-start-1">
				<div class="absolute inset-px rounded-lg bg-white dark:bg-neutral-950 max-lg:rounded-t-[2rem]" />
				<div class="relative flex h-full flex-col overflow-hidden rounded-[calc(0.5rem+1px)] max-lg:rounded-t-[calc(2rem+1px)]">
					<div class="px-8 pt-8 sm:px-10 sm:pt-10">
						<p class="mt-2 text-lg font-bold tracking-tight text-neutral-900 dark:text-white max-lg:text-center">Desempenho</p>
						<p class="mt-2 max-w-lg text-sm leading-6 text-neutral-600 dark:text-neutral-400 max-lg:text-center">
							Lorem ipsum, dolor sit amet consectetur adipisicing elit maiores impedit.
						</p>
					</div>
					<div class="flex flex-1 items-center justify-center px-8 max-lg:pt-10 max-lg:pb-12 sm:px-10 lg:pb-2">
						<img
							alt="Análise de desempenho"
							src="https://tailwindcss.com/plus-assets/img/component-images/bento-03-performance.png"
							class="w-full max-lg:max-w-xs"
						/>
					</div>
				</div>
				<div class="pointer-events-none absolute inset-px rounded-lg shadow-sm ring-1 ring-black/5 max-lg:rounded-t-[2rem] dark:ring-white/10" />
			</div>

			<!-- Segurança -->
			<div class="relative max-lg:row-start-3 lg:col-start-2 lg:row-start-2">
				<div class="absolute inset-px rounded-lg bg-white dark:bg-neutral-950" />
				<div class="relative flex h-full flex-col overflow-hidden rounded-[calc(0.5rem+1px)]">
					<div class="px-8 pt-8 sm:px-10 sm:pt-10">
						<p class="mt-2 text-lg font-bold tracking-tight text-neutral-900 dark:text-white max-lg:text-center">Segurança</p>
						<p class="mt-2 max-w-lg text-sm leading-6 text-neutral-600 dark:text-neutral-400 max-lg:text-center">
							Morbi viverra dui mi arcu sed. Tellus semper adipiscing suspendisse semper morbi.
						</p>
					</div>
					<div class="flex flex-1 items-center max-lg:py-6 lg:pb-2">
						<img
							alt="Escudo de segurança"
							src="https://tailwindcss.com/plus-assets/img/component-images/bento-03-security.png"
							class="h-32 object-cover"
						/>
					</div>
				</div>
				<div class="pointer-events-none absolute inset-px rounded-lg shadow-sm ring-1 ring-black/5 dark:ring-white/10" />
			</div>

			<!-- APIs -->
			<div class="relative lg:row-span-2">
				<div class="absolute inset-px rounded-lg bg-white dark:bg-neutral-950 max-lg:rounded-b-[2rem] lg:rounded-r-[2rem]" />
				<div class="relative flex h-full flex-col overflow-hidden rounded-[calc(0.5rem+1px)] max-lg:rounded-b-[calc(2rem+1px)] lg:rounded-r-[calc(2rem+1px)]">
					<div class="px-8 pt-8 pb-3 sm:px-10 sm:pt-10 sm:pb-0">
						<p class="mt-2 text-lg font-bold tracking-tight text-neutral-900 dark:text-white max-lg:text-center">
							APIs poderosas
						</p>
						<p class="mt-2 max-w-lg text-sm leading-6 text-neutral-600 dark:text-neutral-400 max-lg:text-center">
							Sit quis amet rutrum tellus ullamcorper ultricies libero dolor eget sem sodales gravida.
						</p>
					</div>
					<div class="relative min-h-[30rem] w-full grow">
						<div class="absolute top-10 right-0 bottom-0 left-10 overflow-hidden rounded-tl-xl bg-neutral-900 shadow-2xl ring-1 ring-white/10">
							<div class="flex bg-neutral-800 ring-1 ring-white/5">
								<div class="-mb-px flex text-sm font-medium text-neutral-400">
									<div class="border-r border-b border-r-white/10 border-b-white/20 bg-white/5 px-4 py-2 text-white">
										NotificationSetting.jsx
									</div>
									<div class="border-r border-neutral-600/10 px-4 py-2">App.jsx</div>
								</div>
							</div>
							<div class="px-6 pt-6 pb-14 text-sm text-neutral-400">
								<pre class="overflow-hidden"><code>{`export default function Example() {
  return (
    <div className="flex items-center">
      <span className="text-pink-500">API</span>
    </div>
  )
}`}</code></pre>
							</div>
						</div>
					</div>
				</div>
				<div class="pointer-events-none absolute inset-px rounded-lg shadow-sm ring-1 ring-black/5 max-lg:rounded-b-[2rem] lg:rounded-r-[2rem] dark:ring-white/10" />
			</div>
		</div>
	</div>
</Section>
