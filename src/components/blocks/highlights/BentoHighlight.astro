---
// Bento Grid Highlight
// ------------
// Description: A bento grid with a large center highlight and four surrounding smaller items.

// Components
// - Layout
import Section from '../../ui/Section.astro'
import { Icon } from 'astro-icon/components'

type Props = {
	badge?: string
	title?: string
}

const {
	badge = 'Plataforma completa',
	title = 'Tudo o que sua equipe precisa'
} = Astro.props
---

<Section id="bento-highlight" classes="bg-neutral-50 dark:bg-neutral-900/50">
	<div class="mx-auto max-w-7xl">
		<div class="text-center mb-16">
			<h2 class="text-base font-semibold leading-7 text-primary-500">{badge}</h2>
			<p class="mt-2 text-4xl font-bold tracking-tight text-neutral-900 sm:text-5xl dark:text-white" set:html={title} />
		</div>

		<div class="grid grid-cols-1 md:grid-cols-4 lg:grid-cols-4 gap-4 h-full">
			<!-- Side 1 -->
			<div class="md:col-span-1 space-y-4">
				<div class="bg-white dark:bg-neutral-950 p-8 rounded-2xl shadow-sm ring-1 ring-black/5 dark:ring-white/10 h-1/2 flex flex-col justify-center">
					<Icon name="bolt" class="size-8 text-primary-500 mb-4" />
					<h3 class="font-bold text-neutral-900 dark:text-white">Velocidade</h3>
					<p class="text-sm text-neutral-600 dark:text-neutral-400 mt-2">Otimizado para performance máxima em qualquer dispositivo.</p>
				</div>
				<div class="bg-white dark:bg-neutral-950 p-8 rounded-2xl shadow-sm ring-1 ring-black/5 dark:ring-white/10 h-1/2 flex flex-col justify-center">
					<Icon name="shield-check" class="size-8 text-primary-500 mb-4" />
					<h3 class="font-bold text-neutral-900 dark:text-white">Segurança</h3>
					<p class="text-sm text-neutral-600 dark:text-neutral-400 mt-2">Criptografia de ponta a ponta em todos os seus dados.</p>
				</div>
			</div>

			<!-- Center Highlight -->
			<div class="md:col-span-2 relative group overflow-hidden rounded-2xl bg-neutral-900 shadow-2xl">
				<img 
					src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?ixlib=rb-4.0.3&auto=format&fit=crop&w=2426&q=80" 
					alt="Dashboard highlight" 
					class="absolute inset-0 size-full object-cover opacity-50 group-hover:scale-105 transition-transform duration-500"
				/>
				<div class="relative h-full p-10 flex flex-col justify-end bg-gradient-to-t from-neutral-950 to-transparent">
					<h3 class="text-2xl font-bold text-white">Análise em Tempo Real</h3>
					<p class="text-neutral-300 mt-2 max-w-md">Monitore cada métrica do seu negócio enquanto as coisas acontecem. Insights poderosos ao seu alcance.</p>
				</div>
			</div>

			<!-- Side 2 -->
			<div class="md:col-span-1 space-y-4">
				<div class="bg-white dark:bg-neutral-950 p-8 rounded-2xl shadow-sm ring-1 ring-black/5 dark:ring-white/10 h-1/2 flex flex-col justify-center">
					<Icon name="chat-bubbles" class="size-8 text-primary-500 mb-4" />
					<h3 class="font-bold text-neutral-900 dark:text-white">Suporte</h3>
					<p class="text-sm text-neutral-600 dark:text-neutral-400 mt-2">Time dedicado disponível 24/7 para ajudar no seu sucesso.</p>
				</div>
				<div class="bg-white dark:bg-neutral-950 p-8 rounded-2xl shadow-sm ring-1 ring-black/5 dark:ring-white/10 h-1/2 flex flex-col justify-center">
					<Icon name="arrow-trending-up" class="size-8 text-primary-500 mb-4" />
					<h3 class="font-bold text-neutral-900 dark:text-white">Escalabilidade</h3>
					<p class="text-sm text-neutral-600 dark:text-neutral-400 mt-2">Cresça sem limites com nossa infraestrutura global.</p>
				</div>
			</div>
		</div>
	</div>
</Section>
