---
// Minimal Landing Footer
// ------------
type Props = {
	companyName?: string
}
const { companyName = "Foxi" } = Astro.props
---

<footer class="py-24 border-t border-neutral-100 dark:border-neutral-900 bg-white dark:bg-neutral-950">
	<div class="container mx-auto px-6 text-center">
		<div class="font-headings text-3xl font-black mb-6 text-neutral-900 dark:text-white">
			{companyName}<span class="text-primary-500">.</span>
		</div>
		<p class="text-base text-neutral-500 max-w-md mx-auto leading-relaxed">
			Transformando a produtividade de equipes modernas através de ferramentas inteligentes e design intuitivo.
		</p>
		<div class="mt-10 pt-10 border-t border-neutral-50 dark:border-neutral-900/50">
			<p class="text-xs text-neutral-400 uppercase tracking-widest font-bold">
				© {new Date().getFullYear()} {companyName}. Todos os direitos reservados.
			</p>
		</div>
	</div>
</footer>
