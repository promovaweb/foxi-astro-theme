---
// Minimal Landing Footer
// ------------
type Props = {
	companyName?: string
}
const { companyName = "Foxi" } = Astro.props
---

<footer class="py-12 border-t border-neutral-100 dark:border-neutral-900 bg-white dark:bg-neutral-950">
	<div class="container mx-auto px-6 text-center">
		<div class="font-headings text-2xl font-black mb-4 text-neutral-900 dark:text-white">
			{companyName}<span class="text-primary-500">.</span>
		</div>
		<p class="text-sm text-neutral-500">
			© {new Date().getFullYear()} {companyName}. Todos os direitos reservados.
		</p>
	</div>
</footer>
