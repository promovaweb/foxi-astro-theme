---
// Componente de SEO
// ------------
// Descrição: Um componente para adicionar meta tags de SEO à página usando astro-seo.
// Propriedades:
// - title: O título da página
// - description: A descrição da página
// - ogImage: A imagem da página para Open Graph
// - canonical: Se deve usar a URL canônica
// - noindex: Se deve adicionar meta tags noindex e nofollow

import { SEO } from 'astro-seo'

// Props
type Props = {
	title?: string
	description?: string
	ogImage?: string
	canonical?: boolean
	noindex?: boolean
}

const { title, description, ogImage, canonical, noindex } = Astro.props
---

<SEO
	title={title}
	description={description}
	canonical={canonical ? Astro.url.toString() : undefined}
	noindex={noindex}
	nofollow={noindex}
	openGraph={{
		basic: {
			title: title || '',
			type: 'website',
			image: ogImage || '',
			url: Astro.url.toString()
		}
	}}
	twitter={{
		card: 'summary_large_image',
		site: '@seu-twitter', // Opcional: configurar no configData
		creator: '@seu-twitter', // Opcional: configurar no configData
		title: title,
		description: description,
		image: ogImage
	}}
/>
