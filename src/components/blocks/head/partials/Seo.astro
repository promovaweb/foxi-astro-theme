---
// SEO Component
// ------------
// Description: A component to add SEO meta tags to the page using astro-seo.
// Properties:
// - title: The page title
// - description: The page description
// - ogImage: The page image for Open Graph
// - canonical: Whether to use the canonical URL
// - noindex: Whether to add noindex and nofollow meta tags

import { SEO } from 'astro-seo'

// Props
type Props = {
	title?: string
	description?: string
	ogImage?: string
	canonical?: boolean
	noindex?: boolean
}

const { title, description, ogImage, canonical, noindex } = Astro.props
---

<SEO
	title={title}
	description={description}
	canonical={canonical ? Astro.url.toString() : undefined}
	noindex={noindex}
	nofollow={noindex}
	openGraph={{
		basic: {
			title: title || '',
			type: 'website',
			image: ogImage || '',
			url: Astro.url.toString()
		}
	}}
	twitter={{
		card: 'summary_large_image',
		site: '@seu-twitter', // Opcional: configurar no configData
		creator: '@seu-twitter', // Opcional: configurar no configData
		title: title,
		description: description,
		image: ogImage
	}}
/>
