---
// Seção de grade de Cards Básicos
// ------------
// Descrição: Uma grade de cards com informações básicas de contato em um layout de 4 colunas.
// Propriedades:
// - classes: Classes adicionais a serem adicionadas à Seção

// Components
// - Layout
import Section from '@components/ui/Section.astro'
import Row from '@components/ui/Row.astro'
import Col from '@components/ui/Col.astro'
// - UI
import Card from '@components/ui/cards/BasicCard.astro'

// 	Props
type Props = {
	classes?: string
}
const { classes } = Astro.props
---

<Section id="requests" classes={classes}>
	<Row>
		<Col span="12" align="center" classes="mb-12 max-w-4xl mx-auto">
			<h2 class="text-balance">Tem um Pedido Especial? Estamos Aqui para <strong>Ajudar!</strong></h2>
			<p class="pb-0 text-lg">
				Escolha uma das opções abaixo para obter a ajuda específica que você precisa. Seja
				suporte ao cliente, consultas de vendas, solicitações de recursos ou feedback geral, estamos aqui para
				fornecer a melhor assistência possível.
			</p>
		</Col>
	</Row>
	<Row>
		<Col span="3">
			<Card
				title="Suporte ao Cliente"
				subtitle="Precisa de ajuda com o Foxi? Nossa equipe de suporte está disponível 24 horas por dia, 7 dias por semana, para ajudá-lo com quaisquer problemas ou perguntas que você possa ter."
				icon="rocket"
				classes="text-center dark:!bg-neutral-800/50"
				link="/contact"
			/>
		</Col>
		<Col span="3">
			<Card
				title="Consultas de Vendas"
				subtitle="Interessado em nossos planos ou quer uma solução personalizada? Entre em contato com nossa equipe de vendas para encontrar a opção perfeita."
				icon="document-text"
				classes="text-center dark:!bg-neutral-800/50"
				link="/contact"
			/>
		</Col>
		<Col span="3">
			<Card
				title="Solicitações de Recursos"
				subtitle="Tem uma ideia para tornar o Foxi ainda melhor? Gostaríamos muito de ouvir você! Compartilhe suas solicitações de recursos e ajude-nos a melhorar."
				icon="bolt"
				classes="text-center dark:!bg-neutral-800/50"
				link="/contact"
			/>
		</Col>
		<Col span="3" classes="flex flex-col gap-6">
			<Card
				title="Feedback Geral"
				subtitle="Seu feedback é inestimável para nós. Deixe-nos saber como estamos indo e como podemos melhorar."
				icon="chat-bubble-left-ellipsis"
				classes="text-center dark:!bg-neutral-800/50"
				link="/contact"
			/>
		</Col>
	</Row>
</Section>
