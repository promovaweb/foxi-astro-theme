---
// Grade de Newsletter
// ---------------
// Descrição: Uma seção de newsletter baseada em grade com um título de um lado e um formulário do outro.
// Propriedades:
// - title: O título da seção de newsletter
// - button: O texto para o botão de inscrição
// - placeholder: O texto de placeholder para o campo de e-mail
// - policy: O texto antes do link
// - policyLink: O texto do link
// - link: A URL do link

// Componentes
// - UI
import Button from '@components/ui/Button.astro'

type Props = {
	title?: string
	button?: string
	placeholder?: string
	policy?: string
	policyLink?: string
	link?: string
}

const {
	title = 'Quer notícias e atualizações sobre produtos? Assine nossa newsletter.',
	button = 'Inscrever-se',
	placeholder = 'Digite seu e-mail',
	policy = 'Nós nos preocupamos com seus dados. Leia nossa',
	policyLink = 'política de privacidade',
	link = '#'
} = Astro.props
---

<div class="newsletter-grid bg-white py-16 dark:bg-neutral-950 sm:py-24 lg:py-32">
	<div class="mx-auto grid max-w-7xl grid-cols-1 gap-10 px-6 lg:grid-cols-12 lg:gap-8 lg:px-8">
		<h2 class="newsletter-grid__title max-w-xl text-3xl font-bold tracking-tight text-neutral-900 dark:text-white sm:text-4xl lg:col-span-7" set:html={title} />
		<form
			aria-label="Formulário de inscrição na newsletter"
			class="newsletter-grid__form w-full max-w-md lg:col-span-5 lg:pt-2"
		>
			<div class="flex gap-x-4">
				<label for="newsletter-grid-email" class="sr-only">Endereço de e-mail</label>
				<input
					id="newsletter-grid-email"
					name="email"
					type="email"
					required
					placeholder={placeholder}
					autocomplete="email"
					class="min-w-0 flex-auto rounded-md bg-white px-3.5 py-2 text-base text-neutral-900 outline outline-1 -outline-offset-1 outline-neutral-300 placeholder:text-neutral-500 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-primary-500 sm:text-sm/6 dark:bg-neutral-900 dark:text-white dark:outline-neutral-800 dark:focus:outline-primary-500"
				/>
				<Button type="submit" style="primary" size="lg" classes="flex-none">
					{button}
				</Button>
			</div>
			<p class="newsletter-grid__policy mt-4 text-sm leading-6 text-neutral-600 dark:text-neutral-400">
				{policy}{' '}
				<a href={link} class="font-semibold whitespace-nowrap text-primary-600 hover:text-primary-500 dark:text-primary-400 dark:hover:text-primary-300">
					{policyLink}
				</a>.
			</p>
		</form>
	</div>
</div>

<style>
	.newsletter-grid__title {
		@apply text-balance;
	}
</style>
