---
// Grade de Newsletter
// ---------------
// Descrição: Uma seção de newsletter baseada em grade com um título de um lado e um formulário do outro.
// Propriedades:
// - title: O título da seção de newsletter
// - button: O texto para o botão de inscrição
// - placeholder: O texto de placeholder para o campo de e-mail
// - policy: O texto antes do link
// - policyLink: O texto do link
// - link: A URL do link

// Componentes
// - Layout
import Section from '@components/ui/Section.astro'
import Row from '@components/ui/Row.astro'
import Col from '@components/ui/Col.astro'
// - UI
import Button from '@components/ui/Button.astro'
import InputField from '@components/ui/forms/form-elements/InputField.astro'

// Dados
import { configData } from '@config'

type Props = {
	title?: string
	button?: string
	placeholder?: string
	policy?: string
	policyLink?: string
	link?: string
}

const {
	title = 'Quer notícias e atualizações sobre produtos? Assine nossa newsletter.',
	button = 'Inscrever-se',
	placeholder = 'Digite seu e-mail',
	policy = 'Nós nos preocupamos com seus dados. Leia nossa',
	policyLink = 'política de privacidade',
	link = '#'
} = Astro.props
---

<Section id="newsletter-grid" classes="newsletter-grid bg-white dark:bg-neutral-950">
	<Row>
		<Col span="12" lg="7" classes="flex items-center">
			<h2 class="newsletter-grid__title text-3xl font-bold tracking-tight text-neutral-900 dark:text-white sm:text-4xl" set:html={title} />
		</Col>
		<Col span="12" lg="5" classes="flex items-start">
			<form
				aria-label="Formulário de inscrição na newsletter"
				method="POST"
				action={configData.newsletterUrl}
				class="newsletter-grid__form w-full pt-2"
			>
				<div class="newsletter-grid__fields flex items-start gap-x-4">
					<div class="newsletter-grid__input-wrapper flex-auto">
						<InputField
							id="newsletter-grid-email"
							name="email"
							type="email"
							label={placeholder}
							required
							classes="mb-0"
						/>
					</div>
					<Button type="submit" style="primary" size="lg" classes="flex-none mt-1">
						{button}
					</Button>
				</div>
				<p class="newsletter-grid__policy mt-2 text-sm leading-6 text-neutral-600 dark:text-neutral-400">
					{policy}{' '}
					<a href={link} class="font-semibold whitespace-nowrap text-primary-600 hover:text-primary-500 dark:text-primary-400 dark:hover:text-primary-300">
						{policyLink}
					</a>.
				</p>
			</form>
		</Col>
	</Row>
</Section>

<style>
	.newsletter-grid__title {
		@apply text-balance;
	}
</style>
