---
// Newsletter com Imagem
// ---------------------
// Descrição: Uma seção de inscrição em newsletter com uma imagem de um lado e o formulário do outro.
// Propriedades:
// - title: O título da seção de newsletter
// - text: O texto de descrição da seção de newsletter
// - button: O texto para o botão de inscrição
// - placeholder: O texto de placeholder para o campo de e-mail
// - image: O caminho para a imagem (relativo a src/assets/)

// Componentes
// - UI
import Section from '@components/ui/Section.astro'
import Row from '@components/ui/Row.astro'
import Col from '@components/ui/Col.astro'
import Button from '@components/ui/Button.astro'
import InputField from '@components/ui/forms/form-elements/InputField.astro'
import { Image } from 'astro:assets'

// Dados
import { configData } from '@config'

type Props = {
	title?: string
	text?: string
	button?: string
	placeholder?: string
	image?: string
}

const {
	title = 'Junte-se à nossa comunidade',
	text = 'Mais de 5.000 pessoas já recebem nosso conteúdo exclusivo.',
	button = 'Quero participar',
	placeholder = 'Seu e-mail',
	image = '/src/assets/hero-01.png'
} = Astro.props

// Importa imagem dinamicamente
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/*.{jpeg,jpg,png,gif,webp,svg}')
if (!images[image]) throw new Error(`"${image}" não existe no glob: "src/assets/*.{jpeg,jpg,png,gif,webp,svg}"`)
---

<Section id="newsletter-image" classes="newsletter-image bg-white dark:bg-neutral-950">
	<div class="newsletter-image__container relative overflow-hidden bg-primary-500 rounded-3xl sm:px-16 lg:px-24">
		<Row>
			<Col span="12" lg="6" classes="py-16 lg:py-24">
				<div class="newsletter-image__content relative z-10">
					<h2 class="newsletter-image__title text-3xl font-bold tracking-tight text-white sm:text-4xl" set:html={title} />
					<p class="newsletter-image__text mt-4 text-lg text-primary-50">
						{text}
					</p>
					<form
						aria-label="Formulário de inscrição na newsletter"
						method="POST"
						action={configData.newsletterUrl}
						class="newsletter-image__form mt-8 flex flex-col items-center gap-4 sm:flex-row sm:items-start"
					>
						<div class="newsletter-image__input-wrapper w-full max-w-sm">
							<InputField
								id="newsletter-image-email"
								name="email"
								type="email"
								label={placeholder}
								required
								classes="mb-0 newsletter-image__input"
							/>
						</div>
						<Button type="submit" style="white" size="lg" classes="w-full sm:w-auto mt-1">
							{button}
						</Button>
					</form>
				</div>
			</Col>
			<Col span="12" lg="6" classes="hidden lg:block">
				<div class="newsletter-image__image-wrapper absolute inset-y-0 right-0 w-1/2">
					<Image src={images[image]()} alt="Newsletter" class="h-full w-full object-cover" />
				</div>
			</Col>
		</Row>
	</div>
</Section>

<style>
	.newsletter-image__title {
		@apply text-balance;
	}
	.newsletter-image__text {
		@apply text-pretty;
	}

	/* Estilos do campo de email sobre o fundo primary-500 */
	:global(.newsletter-image .newsletter-image__input .input__field) {
		@apply bg-white border-primary-300 text-neutral-900 placeholder:text-neutral-400 focus:border-primary-700;
	}

	/* Label no estado padrão (dentro do campo) */
	:global(.newsletter-image .newsletter-image__input .input__label) {
		@apply text-neutral-500;
	}

	/* Label flutuante: fundo primary-500 para cobrir a borda do campo */
	:global(.newsletter-image .newsletter-image__input .input__field:focus ~ .input__label),
	:global(.newsletter-image .newsletter-image__input .input__field:not(:placeholder-shown) ~ .input__label),
	:global(.newsletter-image .newsletter-image__input .input__field:-webkit-autofill ~ .input__label) {
		@apply bg-white text-primary-600;
	}
</style>
