---
// Funcionalidades da Newsletter
// -------------------
// Descrição: Uma seção de newsletter com funcionalidades/benefícios na lateral e um fundo decorativo.
// Propriedades:
// - title: O título da seção de newsletter
// - text: O texto de descrição da seção de newsletter
// - button: O texto para o botão de inscrição
// - placeholder: O texto de placeholder para o campo de e-mail
// - features: Array de funcionalidades com título, texto e ícone

// Componentes
// - Layout
import Section from '@components/ui/Section.astro'
import Row from '@components/ui/Row.astro'
import Col from '@components/ui/Col.astro'
// - UI
import Button from '@components/ui/Button.astro'
import InputField from '@components/ui/forms/form-elements/InputField.astro'
import { Icon } from 'astro-icon/components'

// Dados
import { configData } from '@config'

interface Feature {
	title: string
	text: string
	icon: string
}

type Props = {
	title?: string
	text?: string
	button?: string
	placeholder?: string
	features?: Feature[]
}

const {
	title = 'Assine nossa newsletter',
	text = 'Receba atualizações semanais sobre tendências tecnológicas.',
	button = 'Inscrever-se',
	placeholder = 'Digite seu melhor e-mail',
	features = []
} = Astro.props
---

<Section id="newsletter-features" classes="newsletter-features isolate overflow-hidden bg-white dark:bg-neutral-950">
	<!-- Fundo Decorativo -->
	<div aria-hidden="true" class="absolute top-0 left-1/2 -z-10 -translate-x-1/2 blur-3xl xl:-top-6">
		<div
			style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%);"
			class="aspect-[1155/678] w-[72.1875rem] bg-gradient-to-tr from-primary-200 to-primary-500 opacity-20 dark:opacity-10"
		>
		</div>
	</div>
	<Row>
		<!-- Coluna do formulário -->
		<Col span="12" lg="6">
			<h2 class="newsletter-features__title text-4xl font-bold tracking-tight text-neutral-900 dark:text-white sm:text-5xl" set:html={title} />
			<p class="newsletter-features__description mt-4 text-lg text-neutral-600 dark:text-neutral-400">
				{text}
			</p>
			<form
				aria-label="Formulário de inscrição na newsletter"
				method="POST"
				action={configData.newsletterUrl}
				class="newsletter-features__form mt-6 flex max-w-md items-start gap-x-4"
			>
				<div class="newsletter-features__input-wrapper flex-auto">
					<InputField
						id="newsletter-features-email"
						name="email"
						type="email"
						label={placeholder}
						required
						classes="mb-0"
					/>
				</div>
				<Button type="submit" style="primary" size="lg" classes="flex-none mt-1">
					{button}
				</Button>
			</form>
		</Col>
		<!-- Coluna de funcionalidades -->
		<Col span="12" lg="6" classes="lg:pt-2">
			<dl class="newsletter-features__list grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-2">
				{
					features.map((feature) => (
						<div class="flex flex-col items-start">
							<div class="rounded-md bg-neutral-900/5 p-2 ring-1 ring-neutral-900/10 dark:bg-white/5 dark:ring-white/10">
								<Icon name={feature.icon} class="h-6 w-6 text-neutral-600 dark:text-neutral-400" />
							</div>
							<dt class="mt-4 text-base font-semibold text-neutral-900 dark:text-white">
								{feature.title}
							</dt>
							<dd class="mt-2 text-base leading-7 text-neutral-600 dark:text-neutral-400">
								{feature.text}
							</dd>
						</div>
					))
				}
			</dl>
		</Col>
	</Row>
</Section>

<style>
	.newsletter-features__title {
		@apply text-balance;
	}
	.newsletter-features__description {
		@apply text-pretty;
	}
	.newsletter-features__list {
		@apply h-full;
	}
</style>
