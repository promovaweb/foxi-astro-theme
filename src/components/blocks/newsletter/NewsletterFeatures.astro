---
// Newsletter Features
// -------------------
// Description: A newsletter section with features/benefits on the side and a decorative background.
// Properties:
// - title: The title of the newsletter section
// - text: The description text of the newsletter section
// - button: The text for the subscription button
// - placeholder: The placeholder text for the email input
// - features: Array of features with title, text, and icon

// Components
// - UI
import Button from '@components/ui/Button.astro'
import { Icon } from 'astro-icon/components'

interface Feature {
	title: string
	text: string
	icon: string
}

type Props = {
	title?: string
	text?: string
	button?: string
	placeholder?: string
	features?: Feature[]
}

const {
	title = 'Assine nossa newsletter',
	text = 'Receba atualizações semanais sobre tendências tecnológicas.',
	button = 'Inscrever-se',
	placeholder = 'Digite seu melhor e-mail',
	features = []
} = Astro.props
---

<div class="newsletter-features relative isolate overflow-hidden bg-white py-16 dark:bg-neutral-950 sm:py-24 lg:py-32">
	<div class="mx-auto max-w-7xl px-6 lg:px-8">
		<div class="mx-auto grid max-w-2xl grid-cols-1 gap-x-8 gap-y-16 lg:max-w-none lg:grid-cols-2">
			<div class="max-w-xl lg:max-w-lg">
				<h2 class="newsletter-features__title text-4xl font-bold tracking-tight text-neutral-900 dark:text-white sm:text-5xl" set:html={title} />
				<p class="newsletter-features__description mt-4 text-lg text-neutral-600 dark:text-neutral-400">
					{text}
				</p>
				<form
					aria-label="Formulário de inscrição na newsletter"
					class="newsletter-features__form mt-6 flex max-w-md gap-x-4"
				>
					<label for="newsletter-features-email" class="sr-only">Endereço de e-mail</label>
					<input
						id="newsletter-features-email"
						name="email"
						type="email"
						required
						placeholder={placeholder}
						autocomplete="email"
						class="min-w-0 flex-auto rounded-md bg-white px-3.5 py-2 text-base text-neutral-900 outline outline-1 -outline-offset-1 outline-neutral-300 placeholder:text-neutral-500 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-primary-500 sm:text-sm/6 dark:bg-neutral-900 dark:text-white dark:outline-neutral-800 dark:focus:outline-primary-500"
					/>
					<Button type="submit" style="primary" size="lg" classes="flex-none">
						{button}
					</Button>
				</form>
			</div>
			<dl class="grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-2 lg:pt-2">
				{
					features.map((feature) => (
						<div class="flex flex-col items-start">
							<div class="rounded-md bg-neutral-900/5 p-2 ring-1 ring-neutral-900/10 dark:bg-white/5 dark:ring-white/10">
								<Icon name={feature.icon} class="h-6 w-6 text-neutral-600 dark:text-neutral-400" />
							</div>
							<dt class="mt-4 text-base font-semibold text-neutral-900 dark:text-white">
								{feature.title}
							</dt>
							<dd class="mt-2 text-base leading-7 text-neutral-600 dark:text-neutral-400">
								{feature.text}
							</dd>
						</div>
					))
				}
			</dl>
		</div>
	</div>
	<!-- Decorative Background -->
	<div aria-hidden="true" class="absolute top-0 left-1/2 -z-10 -translate-x-1/2 blur-3xl xl:-top-6">
		<div
			style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%);"
			class="aspect-[1155/678] w-[72.1875rem] bg-gradient-to-tr from-primary-200 to-primary-500 opacity-20 dark:opacity-10"
		>
		</div>
	</div>
</div>

<style>
	.newsletter-features__title {
		@apply text-balance;
	}
	.newsletter-features__description {
		@apply text-pretty;
	}
</style>
