---
// Newsletter Centralizada
// ------------------
// Descrição: Uma seção de inscrição em newsletter centralizada com cabeçalho, descrição e formulário.
// Propriedades:
// - title: O título da seção de newsletter
// - text: O texto de descrição da seção de newsletter
// - button: O texto para o botão de inscrição
// - placeholder: O texto de placeholder para o campo de e-mail

// Componentes
// - Layout
import Section from '@components/ui/Section.astro'
import Row from '@components/ui/Row.astro'
import Col from '@components/ui/Col.astro'
import Button from '@components/ui/Button.astro'
import InputField from '@components/ui/forms/form-elements/InputField.astro'

// Dados
import { configData } from '@config'

type Props = {
	title?: string
	text?: string
	button?: string
	placeholder?: string
}

const {
	title = 'Fique por dentro das novidades',
	text = 'Inscreva-se em nossa newsletter para receber as últimas notícias e atualizações.',
	button = 'Inscrever-se',
	placeholder = 'Seu melhor e-mail'
} = Astro.props
---

<Section id="newsletter-centered" classes="newsletter-centered bg-white dark:bg-neutral-950">
	<Row justify="center">
		<Col span="12" lg="8" classes="text-center">
			<div class="newsletter-centered__content">
				<h2 class="newsletter-centered__title text-4xl font-bold tracking-tight text-neutral-900 dark:text-white sm:text-5xl" set:html={title} />
				<p class="newsletter-centered__text mt-6 text-lg leading-8 text-neutral-700 dark:text-neutral-300">
					{text}
				</p>
				<form
					aria-label="Formulário de inscrição na newsletter"
					method="POST"
					action={configData.newsletterUrl}
					class="newsletter-centered__form mt-10 flex flex-col items-center gap-4"
				>
					<div class="newsletter-centered__input-wrapper w-full max-w-md text-left">
						<InputField id="newsletter-email" name="email" type="email" label={placeholder} required classes="mb-0 text-left" />
					</div>
					<Button type="submit" style="primary" size="lg" classes="w-full max-w-md sm:w-auto">
						{button}
					</Button>
				</form>
				<p class="newsletter-centered__footer mt-4 text-sm text-neutral-600 dark:text-neutral-400">
					Nós respeitamos sua privacidade. Cancele a assinatura a qualquer momento.
				</p>
			</div>
		</Col>
	</Row>
</Section>

<style>
	.newsletter-centered__title {
		@apply text-balance;
	}
	.newsletter-centered__text {
		@apply text-pretty;
	}
</style>
