---
// Split Feature
// ------------
// Description: A feature section with text and a list of sub-features on one side and a product screenshot on the other.
// Properties:
// - badge: Optional text for the top badge
// - title: The main title of the section
// - text: The description text of the section
// - features: Array of feature objects (name, description, icon)
// - image: Object with src, alt, width, and height for the screenshot
// - imagePosition: Position of the image (left or right), default is right

// Components
// - UI
import Section from '@components/ui/Section.astro'
import Row from '@components/ui/Row.astro'
import Col from '@components/ui/Col.astro'
import { Icon } from 'astro-icon/components'

interface FeatureItem {
	name: string
	description: string
	icon: string
}

interface ImageProps {
	src: string
	alt: string
	width?: number
	height?: number
}

type Props = {
	badge?: string
	title?: string
	text?: string
	features?: FeatureItem[]
	image?: ImageProps
	imagePosition?: 'left' | 'right'
}

const {
	badge = 'Deploy mais rápido',
	title = 'Um fluxo de trabalho <strong>melhor</strong>',
	text = 'Lorem ipsum, dolor sit amet consectetur adipisicing elit. Maiores impedit perferendis suscipit eaque, iste dolor cupiditate blanditiis ratione.',
	features = [
		{
			name: 'Push para deploy.',
			description:
				'Lorem ipsum, dolor sit amet consectetur adipisicing elit. Maiores impedit perferendis suscipit eaque, iste dolor cupiditate blanditiis ratione.',
			icon: 'rocket'
		},
		{
			name: 'Certificados SSL.',
			description:
				'Anim aute id magna aliqua ad ad non deserunt sunt. Qui irure qui lorem cupidatat commodo.',
			icon: 'shield-check'
		},
		{
			name: 'Backups de banco de dados.',
			description:
				'Ac tincidunt sapien vehicula erat auctor pellentesque rhoncus. Et magna sit morbi lobortis.',
			icon: 'circle-stack'
		}
	],
	image = {
		src: 'https://tailwindcss.com/plus-assets/img/component-images/project-app-screenshot.png',
		alt: 'Product screenshot',
		width: 2432,
		height: 1442
	},
	imagePosition = 'right'
} = Astro.props

const isImageLeft = imagePosition === 'left'
---

<Section id="split-feature" classes="split-feature overflow-hidden bg-white py-24 sm:py-32 dark:bg-neutral-950">
	<Row classes="lg:items-center">
		<!-- Content Column -->
		<Col span="6" classes={`${isImageLeft ? 'lg:order-last lg:pl-16' : 'lg:pr-8'}`}>
			<div class="split-feature__content lg:max-w-lg">
				{badge && <h2 class="split-feature__badge text-base font-semibold leading-7 text-primary-500">{badge}</h2>}
				<p class="split-feature__title mt-2 text-4xl font-bold tracking-tight text-neutral-900 sm:text-5xl dark:text-white" set:html={title} />
				<p class="split-feature__text mt-6 text-lg leading-8 text-neutral-600 dark:text-neutral-400">
					{text}
				</p>
				<dl class="split-feature__list mt-10 max-w-xl space-y-8 text-base leading-7 text-neutral-600 lg:max-w-none dark:text-neutral-400">
					{
						features.map((feature) => (
							<div class="split-feature__item relative pl-9">
								<dt class="split-feature__item-title inline font-semibold text-neutral-900 dark:text-white">
									<Icon name={feature.icon} class="split-feature__icon absolute left-1 top-1 h-5 w-5 text-primary-500" aria-hidden="true" />
									{feature.name}
								</dt>
								<dd class="split-feature__item-text inline">{feature.description}</dd>
							</div>
						))
					}
				</dl>
			</div>
		</Col>

		<!-- Image Column -->
		<Col span="6" classes="mt-16 sm:mt-24 lg:mt-0">
			<img
				src={image.src}
				alt={image.alt}
				width={image.width}
				height={image.height}
				class={`split-feature__image w-[48rem] max-w-none rounded-xl shadow-xl ring-1 ring-neutral-400/10 dark:ring-white/10 ${isImageLeft ? 'lg:-ml-0' : 'md:-ml-4 lg:-ml-0'}`}
			/>
		</Col>
	</Row>
</Section>

<style>
	.split-feature__title {
		@apply text-pretty;
	}
	.split-feature__text {
		@apply text-pretty;
	}
</style>
