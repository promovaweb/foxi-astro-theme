---
// Seção de grade de Cartões de Funcionalidades
// ------------
// Descrição: Uma grade de cartões com informações de funcionalidades em um layout de 4 colunas.

// Componentes
// - Layout
import Section from '@components/ui/Section.astro'
import Row from '@components/ui/Row.astro'
import Col from '@components/ui/Col.astro'
// - UI
import Card from '@components/ui/cards/FeatureCard.astro'

// Conteúdo
// - Cartões
import feature01 from '@/assets/cards/feature-01.svg'
import feature02 from '@/assets/cards/feature-02.svg'
import feature03 from '@/assets/cards/feature-03.svg'
import feature04 from '@/assets/cards/feature-04.svg'
import feature05 from '@/assets/cards/feature-05.svg'
---

<Section id="features">
	<Row>
		<Col span="12" align="center" classes="mb-12 max-w-4xl mx-auto">
			<h2 class="text-pretty">Ferramentas inovadoras para <strong>transformar</strong> seu fluxo de trabalho</h2>
			<p class="pb-0 text-lg">
				Explore o conjunto de ferramentas projetadas para otimizar seu fluxo de trabalho, aumentar a produtividade e
				impulsionar o crescimento. Cada produto é criado com precisão para atender às suas necessidades e superar suas
				expectativas.
			</p>
		</Col>
	</Row>
	<Row>
		<Col span="4">
			<Card
				title="Todos os seus dados em um só lugar"
				subtitle="Mantenha-se em dia com suas tarefas e prazos com nossa ferramenta intuitiva de gerenciamento de projetos. Visualize o progresso, atribua tarefas e colabore perfeitamente."
				image={feature01}
				link="/features"
			/>
		</Col>
		<Col span="4" classes="flex flex-col gap-6">
			<Card
				title="Organize e gerencie seus projetos"
				subtitle="Mantenha-se em dia com suas tarefas e prazos com nossa ferramenta intuitiva de gerenciamento de projetos."
				image={feature02}
				link="/features"
			/>
			<Card
				title="Mantenha sua equipe conectada"
				subtitle="Com nossa plataforma de chat integrada, compartilhe atualizações, arquivos e mensagens em um ambiente seguro e amigável."
				image={feature03}
				link="/features"
			/>
		</Col>
		<Col span="4" classes="flex flex-col gap-6">
			<Card
				title="Gerencie seus clientes"
				subtitle="Construa e nutra relacionamentos com os clientes com nosso poderoso sistema CRM."
				image={feature04}
				link="/features"
			/>
			<Card
				title="Simplifique suas operações financeiras"
				subtitle="Otimize seu processo de faturamento com nossa ferramenta de faturamento fácil de usar. Crie, envie e rastreie faturas sem esforço."
				image={feature05}
				link="/features"
			/>
		</Col>
	</Row>
</Section>
