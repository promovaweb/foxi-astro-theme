---
// Funcionalidade com Depoimento
// ------------
// Descrição: Uma seção de funcionalidade com texto, um botão de CTA e um depoimento em bloco de um lado, e uma captura de tela do produto do outro.
// Propriedades:
// - badge: Texto opcional para o selo superior
// - title: O título principal da seção
// - text: O texto de descrição da seção
// - button: Objeto com nome e link para a ação de CTA
// - testimonial: Objeto com citação, autor, cargo e avatar para o depoimento
// - image: Objeto com src, alt, largura e altura para a captura de tela
// - imagePosition: Posição da imagem (esquerda ou direita), o padrão é direita

// Componentes
// - UI
import Section from '@components/ui/Section.astro'
import Row from '@components/ui/Row.astro'
import Col from '@components/ui/Col.astro'
import Button from '@components/ui/Button.astro'
import Avatar from '@components/ui/Avatar.astro'

interface ButtonProps {
	name: string
	link: string
}

interface TestimonialProps {
	quote: string
	author: string
	role: string
	avatar: string
}

interface ImageProps {
	src: string
	alt: string
	width?: number
	height?: number
}

type Props = {
	badge?: string
	title?: string
	text?: string
	button?: ButtonProps
	testimonial?: TestimonialProps
	image?: ImageProps
	imagePosition?: 'left' | 'right'
}

const {
	badge = 'Implantação mais rápida',
	title = 'Um fluxo de trabalho <strong>melhor</strong>',
	text = 'Lorem ipsum, dolor sit amet consectetur adipisicing elit. Maiores impedit perferendis suscipit eaque, iste dolor cupiditate blanditiis ratione.',
	button = { name: 'Começar agora', link: '/' },
	testimonial = {
		quote: '“Vel ultricies morbi odio facilisi ultrices accumsan donec lacus purus. Lectus nibh ullamcorper ac dictum justo in euismod. Risus aenean ut elit massa. In amet aliquet eget cras. Sem volutpat enim tristique.”',
		author: 'Maria Hill',
		role: 'Gerente de Marketing',
		avatar: 'https://images.unsplash.com/photo-1509783236416-c9ad59bae472?ixlib=rb-=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=facearea&facepad=8&w=1024&h=1024&q=80'
	},
	image = {
		src: 'https://tailwindcss.com/plus-assets/img/component-images/dark-project-app-screenshot.png',
		alt: 'Captura de tela do produto',
		width: 2432,
		height: 1442
	},
	imagePosition = 'right'
} = Astro.props

const isImageLeft = imagePosition === 'left'
---

<Section id="feature-testimonial" classes="feature-testimonial overflow-hidden bg-white py-24 sm:py-32 dark:bg-neutral-950">
	<Row classes="lg:items-start lg:justify-between">
		<!-- Coluna de Conteúdo -->
		<Col span="6" classes={`${isImageLeft ? 'lg:order-last lg:pl-16' : 'lg:pr-8'}`}>
			<div class="feature-testimonial__content lg:max-w-lg">
				{badge && <h2 class="feature-testimonial__badge text-base font-semibold leading-7 text-primary-500">{badge}</h2>}
				<p class="feature-testimonial__title mt-2 text-4xl font-bold tracking-tight text-neutral-900 sm:text-5xl dark:text-white" set:html={title} />
				<p class="feature-testimonial__text mt-6 text-lg leading-8 text-neutral-600 dark:text-neutral-400">
					{text}
				</p>
				
				<div class="feature-testimonial__actions mt-8">
					<Button link={button.link} style="primary" size="lg" elevated>
						{button.name}
					</Button>
				</div>

				<figure class="feature-testimonial__quote mt-16 border-l border-neutral-200 dark:border-neutral-800 pl-8 text-neutral-600 dark:text-neutral-400">
					<blockquote class="text-base leading-7 italic">
						<p>
							{testimonial.quote}
						</p>
					</blockquote>
					<figcaption class="mt-6 flex gap-x-4 text-sm leading-6 items-center">
						<Avatar 
							size="sm" 
							image={{ src: testimonial.avatar, alt: testimonial.author }} 
							radius="rounded-full"
							classes="shrink-0"
						/>
						<div>
							<span class="font-semibold text-neutral-900 dark:text-white">{testimonial.author}</span> –{' '}
							<span class="text-neutral-600 dark:text-neutral-500">{testimonial.role}</span>
						</div>
					</figcaption>
				</figure>
			</div>
		</Col>

		<!-- Coluna de Imagem -->
		<Col span="6" classes="mt-16 sm:mt-24 lg:mt-0">
			<img
				src={image.src}
				alt={image.alt}
				width={image.width}
				height={image.height}
				class={`feature-testimonial__image w-[48rem] max-w-none rounded-xl shadow-xl ring-1 ring-neutral-400/10 dark:ring-white/10 ${isImageLeft ? 'lg:-ml-0' : 'md:-ml-4 lg:-ml-0'}`}
			/>
		</Col>
	</Row>
</Section>

<style>
	.feature-testimonial__title {
		@apply text-pretty;
	}
	.feature-testimonial__text {
		@apply text-pretty;
	}
</style>
