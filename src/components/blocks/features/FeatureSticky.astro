---
// Seção de Funcionalidade com barra lateral fixa
// ------------
// Descrição: Uma seção com o cabeçalho como uma barra lateral fixa (sticky) e funcionalidades com ícones e descrições em um layout de 3 colunas.

// Componentes
// - Layout
import Row from '@components/ui/Row.astro'
import Col from '@components/ui/Col.astro'
import StickySidebar from '@components/blocks/basic/StickySidebar.astro'
// - UI
import Feature from '@components/ui/Feature.astro'

// Props
type FeatureData = {
	title: string
	icon: string
	description: string
}
type Props = {
	title: string
	text?: string
	data: FeatureData[]
	classes?: string
}
const { title, text, data, classes } = Astro.props
---

<StickySidebar classes={classes}>
	<header slot="sidebar">
		{title && <h3 class="text-3xl">{title}</h3>}
		{text && <p class="text-lg leading-relaxed">{text}</p>}
	</header>

	<Row>
		{
			// Percorre as funcionalidades filtradas e as renderiza
			data.map((feature: FeatureData) => (
				<Col span="4">
					<Feature title={feature.title} icon={feature.icon} align="left" classes="mb-12">
						{feature.description}
					</Feature>
				</Col>
			))
		}
	</Row>
</StickySidebar>
