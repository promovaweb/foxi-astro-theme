---
/**
 * Componente: ChangelogBanner
 * Descrição: Um banner estilo "Hero Card" com fundo de grid tecnológico (CSS/SVG).
 */

import Section from '@components/ui/Section.astro'
import Button from '@components/ui/Button.astro'
import { Icon } from 'astro-icon/components'
import { getCollection } from 'astro:content'

// Buscar o changelog mais recente
const allChangelog = await getCollection('changelog')
const latestEntry = allChangelog
	.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())[0]

if (!latestEntry) return null

const { title, description, date, category } = latestEntry.data
const formattedDate = new Date(date).toLocaleDateString('pt-BR', {
	day: '2-digit',
	month: 'long',
	year: 'numeric'
})
---

<Section id="latest-changelog-banner" classes="!py-12">
	<div class="changelog-banner__card group relative overflow-hidden rounded-[2.5rem] bg-neutral-950 shadow-2xl transition-all duration-500 hover:shadow-primary-500/20 border border-neutral-800">
		
		<!-- Grid Background (SVG + CSS) -->
		<div class="absolute inset-0 pointer-events-none overflow-hidden">
			<!-- O Grid Principal -->
			<div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:40px_40px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"></div>
			
			<!-- Brilho de Acento -->
			<div class="absolute -top-24 left-1/2 -translate-x-1/2 h-[300px] w-[600px] bg-primary-500/10 blur-[120px] rounded-full"></div>
			
			<!-- Linhas de Luz Animadas (Opcional/Sutil) -->
			<div class="absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_0%,rgba(0,0,0,0.4)_100%)]"></div>
		</div>

		<!-- Content Area -->
		<div class="relative z-10 p-8 lg:p-14 flex flex-col justify-end min-h-[320px] lg:min-h-[380px]">
			<div class="flex flex-wrap items-center gap-4 mb-6">
				<div class="flex items-center gap-2 rounded-full bg-primary-500/10 border border-primary-500/20 px-4 py-1.5 backdrop-blur-sm">
					<span class="relative flex h-2 w-2">
						<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary-400 opacity-75"></span>
						<span class="relative inline-flex rounded-full h-2 w-2 bg-primary-500"></span>
					</span>
					<span class="text-[10px] font-black uppercase tracking-widest text-primary-500">
						{category || 'Lançamento'}
					</span>
				</div>
				<span class="text-xs font-bold text-neutral-500 uppercase tracking-widest">
					Atualizado em {formattedDate}
				</span>
			</div>

			<div class="max-w-3xl">
				<h2 class="text-3xl lg:text-5xl font-black text-white leading-tight mb-4 group-hover:text-primary-400 transition-colors">
					{title}
				</h2>
				<p class="text-lg text-neutral-400 mb-10 line-clamp-2 max-w-2xl font-medium leading-relaxed">
					{description || "Explore as últimas melhorias e novos recursos que acabamos de adicionar ao Foxi para elevar sua experiência."}
				</p>
			</div>

			<div class="flex flex-wrap items-center gap-6">
				<Button 
					link={`/changelog/${latestEntry.id}`} 
					style="primary" 
					size="lg" 
					elevated
					classes="font-black group/btn"
				>
					Explorar Novidades
					<Icon name="long-arrow-right" class="ml-2 h-5 w-5 transition-transform group-hover/btn:translate-x-1" />
				</Button>
				
				<a href="/changelog" class="inline-flex items-center text-sm font-bold text-neutral-400 hover:text-white transition-colors uppercase tracking-widest gap-2 group/link">
					Histórico Completo
					<Icon name="long-arrow-right" class="h-4 w-4 transition-transform group-hover/link:translate-x-1" />
				</a>
			</div>
		</div>

		<!-- Floating Decorative Element (Rocket) -->
		<div class="absolute top-8 right-8 lg:top-14 lg:right-14 opacity-10 pointer-events-none group-hover:opacity-30 transition-all duration-700 group-hover:-translate-y-2 group-hover:translate-x-2">
			<Icon name="rocket" class="h-20 w-20 lg:h-32 text-white -rotate-12" />
		</div>
	</div>
</Section>

<style>
	.changelog-banner__card {
		background-image: radial-gradient(circle at 2px 2px, rgba(255,255,255,0.02) 1px, transparent 0);
		background-size: 24px 24px;
	}
</style>
