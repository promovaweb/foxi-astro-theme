---
// PricingOverlapping
// ------------
// Description: Three tiers with overlapping central card and dark header.

import Section from '@components/ui/Section.astro'
import Row from '@components/ui/Row.astro'
import Col from '@components/ui/Col.astro'
import { Icon } from 'astro-icon/components'
import pricingData from '@data/json-files/pricingOverlapping.json'

interface Props {
	classes?: string
}
const { classes } = Astro.props
---

<Section padding="none" classes={`pricing-overlapping ${classes || ''}`}>
	<div class="bg-neutral-900 px-6 py-24 lg:px-8">
		<Row>
			<Col span="12" align="center" classes="mx-auto max-w-4xl text-center">
				<h2 class="text-base font-semibold text-primary-400 uppercase tracking-widest font-headings">{pricingData.title}</h2>
				<p class="mt-2 text-4xl font-bold text-white sm:text-6xl font-headings">{pricingData.heading}</p>
				<p class="mt-6 text-lg text-neutral-400">{pricingData.description}</p>
			</Col>
		</Row>
	</div>

	<div class="relative -mt-16 sm:-mt-24 lg:-mt-32 pb-24 lg:pb-32 px-6 lg:px-8">
		<Row classes="max-w-7xl mx-auto items-stretch gap-y-8 lg:gap-0 lg:grid-cols-7">
			{/* Hobby Tier */}
			<div class="lg:col-span-2 flex flex-col bg-white dark:bg-neutral-900 rounded-2xl shadow-lg lg:rounded-none lg:rounded-l-2xl overflow-hidden border-b lg:border-b-0 lg:border-r border-neutral-100 dark:border-neutral-800 self-center">
				<div class="p-10 text-center border-b border-neutral-100 dark:border-neutral-800">
					<h3 class="text-xl font-bold text-neutral-900 dark:text-white font-headings">{pricingData.tiers[0].name}</h3>
					<div class="mt-4 flex justify-center items-start">
						<span class="text-2xl font-bold text-neutral-500 mt-2 mr-1">R$</span>
						<span class="text-6xl font-bold text-neutral-900 dark:text-white font-headings">{pricingData.tiers[0].price}</span>
						<span class="text-lg text-neutral-500 self-end mb-2">/mês</span>
					</div>
				</div>
				<div class="p-10 bg-neutral-50 dark:bg-neutral-800/50 flex-1 flex flex-col justify-between">
					<ul class="space-y-4">
						{pricingData.tiers[0].features.map(f => (
							<li class="flex gap-3 text-neutral-600 dark:text-neutral-400">
								<Icon name="check-circle" class="size-6 text-primary-500 flex-none" />
								{f}
							</li>
						))}
					</ul>
					<a href="#" class="mt-10 block w-full py-3 px-6 text-center border border-primary-500 text-primary-500 font-bold rounded-lg hover:bg-primary-50 transition-colors">
						Iniciar teste
					</a>
				</div>
			</div>

			{/* Growth Tier (Overlapping/Featured) */}
			<div class="lg:col-span-3 flex flex-col bg-white dark:bg-neutral-900 rounded-2xl shadow-2xl relative z-10 ring-2 ring-primary-500 lg:scale-105">
				<div class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2">
					<span class="bg-primary-500 text-white px-4 py-1 rounded-full text-sm font-bold uppercase">Mais Popular</span>
				</div>
				<div class="p-12 text-center border-b border-neutral-100 dark:border-neutral-800">
					<h3 class="text-3xl font-bold text-neutral-900 dark:text-white font-headings">{pricingData.tiers[1].name}</h3>
					<div class="mt-6 flex justify-center items-start">
						<span class="text-3xl font-bold text-neutral-500 mt-2 mr-1">R$</span>
						<span class="text-7xl font-bold text-neutral-900 dark:text-white font-headings">{pricingData.tiers[1].price}</span>
						<span class="text-xl text-neutral-500 self-end mb-2">/mês</span>
					</div>
				</div>
				<div class="p-12 bg-neutral-50 dark:bg-neutral-800/50 flex-1 flex flex-col justify-between">
					<ul class="space-y-5">
						{pricingData.tiers[1].features.map(f => (
							<li class="flex gap-3 text-neutral-700 dark:text-neutral-300 font-medium">
								<Icon name="check-circle" class="size-6 text-primary-500 flex-none" />
								{f}
							</li>
						))}
					</ul>
					<a href="#" class="mt-12 block w-full py-4 px-6 text-center bg-primary-500 text-white font-bold rounded-lg shadow-xl hover:bg-primary-400 transition-colors">
						Iniciar teste agora
					</a>
				</div>
			</div>

			{/* Scale Tier */}
			<div class="lg:col-span-2 flex flex-col bg-white dark:bg-neutral-900 rounded-2xl shadow-lg lg:rounded-none lg:rounded-r-2xl overflow-hidden border-t lg:border-t-0 lg:border-l border-neutral-100 dark:border-neutral-800 self-center">
				<div class="p-10 text-center border-b border-neutral-100 dark:border-neutral-800">
					<h3 class="text-xl font-bold text-neutral-900 dark:text-white font-headings">{pricingData.tiers[2].name}</h3>
					<div class="mt-4 flex justify-center items-start">
						<span class="text-2xl font-bold text-neutral-500 mt-2 mr-1">R$</span>
						<span class="text-6xl font-bold text-neutral-900 dark:text-white font-headings">{pricingData.tiers[2].price}</span>
						<span class="text-lg text-neutral-500 self-end mb-2">/mês</span>
					</div>
				</div>
				<div class="p-10 bg-neutral-50 dark:bg-neutral-800/50 flex-1 flex flex-col justify-between">
					<ul class="space-y-4">
						{pricingData.tiers[2].features.map(f => (
							<li class="flex gap-3 text-neutral-600 dark:text-neutral-400">
								<Icon name="check-circle" class="size-6 text-primary-500 flex-none" />
								{f}
							</li>
						))}
					</ul>
					<a href="#" class="mt-10 block w-full py-3 px-6 text-center border border-primary-500 text-primary-500 font-bold rounded-lg hover:bg-primary-50 transition-colors">
						Iniciar teste
					</a>
				</div>
			</div>
		</Row>
	</div>
</Section>
