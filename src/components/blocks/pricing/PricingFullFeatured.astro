---
// PricingFullFeatured
// ------------
// Description: Two columns, one for full features list and another for a simple price box.

import Section from '@components/ui/Section.astro'
import { Icon } from 'astro-icon/components'
import pricingData from '@data/json-files/pricingFullFeatured.json'

interface Props {
	classes?: string
}
const { classes } = Astro.props
---

<Section classes={`pricing-full-featured ${classes || ''}`}>
	<div class="pricing-full-featured__bg" aria-hidden="true"></div>
	
	<div class="relative mx-auto max-w-7xl lg:grid lg:grid-cols-2 lg:px-8 border border-neutral-100 dark:border-neutral-800 rounded-[2rem] overflow-hidden bg-white dark:bg-neutral-900 shadow-2xl">
		<div class="px-6 py-16 sm:py-24 lg:px-12">
			<h2 class="text-sm font-semibold text-primary-500 uppercase tracking-wider font-headings">{pricingData.title}</h2>
			<p class="mt-2 text-3xl font-bold text-neutral-900 dark:text-white font-headings">{pricingData.heading}</p>
			
			<dl class="mt-12 space-y-10">
				{pricingData.features.map(f => (
					<div class="relative pl-16">
						<dt>
							<div class="absolute left-0 top-0 flex size-12 items-center justify-center rounded-lg bg-primary-500">
								<Icon name={f.icon} class="size-6 text-white" />
							</div>
							<p class="text-lg font-bold text-neutral-900 dark:text-white font-headings">{f.name}</p>
						</dt>
						<dd class="mt-2 text-neutral-500 dark:text-neutral-400">{f.description}</dd>
					</div>
				))}
			</dl>
		</div>

		<div class="bg-primary-500 px-6 py-16 sm:py-24 lg:flex lg:items-center lg:px-12">
			<div class="mx-auto w-full max-w-md space-y-10">
				<div class="text-center">
					<div class="relative flex justify-center items-center gap-8">
						<div class="flex flex-col">
							<span class="text-6xl font-bold text-white font-headings">{pricingData.price}</span>
							<span class="text-sm font-medium text-primary-100 uppercase tracking-widest">{pricingData.priceLabel}</span>
						</div>
						<Icon name="plus" class="size-6 text-primary-200" />
						<div class="flex flex-col">
							<span class="text-6xl font-bold text-white font-headings">{pricingData.monthlyPrice}</span>
							<span class="text-sm font-medium text-primary-100 uppercase tracking-widest">{pricingData.monthlyLabel}</span>
						</div>
					</div>
				</div>

				<ul class="grid sm:grid-cols-2 gap-4">
					{pricingData.checklist.map(item => (
						<li class="flex items-center gap-3 bg-white/10 p-4 rounded-lg text-white">
							<Icon name="check-circle" class="size-6 text-primary-200" />
							<span class="font-medium">{item}</span>
						</li>
					))}
				</ul>

				<div class="space-y-4">
					<a href="#" class="block w-full py-4 px-8 text-center bg-white text-primary-500 font-bold rounded-xl shadow-lg hover:bg-neutral-50 transition-colors">
						Comece hoje mesmo
					</a>
					<a href="#" class="block text-center text-primary-100 font-medium hover:text-white transition-colors">
						Experimente nosso plano Lite gratuitamente
					</a>
				</div>
			</div>
		</div>
	</div>
</Section>

<style>
	.pricing-full-featured {
		@apply relative bg-neutral-50 dark:bg-neutral-950 py-24 sm:py-32;
	}
	.pricing-full-featured__bg {
		@apply absolute inset-y-0 right-0 w-1/2 bg-primary-500 hidden lg:block;
	}
</style>
