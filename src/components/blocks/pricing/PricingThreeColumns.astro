---
// PricingThreeColumns
// ------------
// Description: Three columns with a 'Most Popular' badge.

import Section from '@components/ui/Section.astro'
import Row from '@components/ui/Row.astro'
import Col from '@components/ui/Col.astro'
import { Icon } from 'astro-icon/components'
import pricingData from '@data/json-files/pricingThreeColumns.json'

interface Props {
	classes?: string
}
const { classes } = Astro.props
---

<Section classes={`pricing-three-columns ${classes || ''}`}>
	<Row>
		<Col span="12" align="center" classes="mx-auto max-w-4xl text-center mb-16">
			<h2 class="pricing-three-columns__title">{pricingData.title}</h2>
			<p class="pricing-three-columns__heading">{pricingData.heading}</p>
			<p class="pricing-three-columns__description">{pricingData.description}</p>
		</Col>
	</Row>

	<Row classes="pricing-three-columns__grid items-stretch">
		{
			pricingData.tiers.map((tier, index) => (
				<Col span="4" classes="flex">
					<div
						class:list={[
							'three-card',
							{ 'three-card--popular': tier.mostPopular },
							{ 'three-card--first': index === 0 },
							{ 'three-card--last': index === pricingData.tiers.length - 1 }
						]}
					>
						<div class="three-card__header">
							<div class="flex items-center justify-between gap-x-4">
								<h3 class:list={['three-card__name', { 'three-card__name--popular': tier.mostPopular }]}>
									{tier.name}
								</h3>
								{tier.mostPopular && <span class="three-card__badge">Mais popular</span>}
							</div>
							<p class="three-card__description">{tier.description}</p>
							<p class="three-card__price">
								<span class="three-card__price-amount">{tier.priceMonthly}</span>
								<span class="three-card__price-label">/mês</span>
							</p>
							<ul role="list" class="three-card__list">
								{tier.features.map((feature) => (
									<li class="three-card__item">
										<Icon name="check-circle" class="three-card__icon" />
										{feature}
									</li>
								))}
							</ul>
						</div>
						<a
							href={tier.href}
							class:list={[
								'three-card__button',
								tier.mostPopular ? 'three-card__button--primary' : 'three-card__button--outline'
							]}
						>
							Comprar plano
						</a>
					</div>
				</Col>
			))
		}
	</Row>
</Section>

<style>
	.pricing-three-columns {
		@apply py-24 sm:py-32;
	}
	.pricing-three-columns__title {
		@apply text-base font-semibold leading-7 text-primary-500 font-headings;
	}
	.pricing-three-columns__heading {
		@apply mt-2 text-4xl font-bold tracking-tight text-neutral-900 sm:text-6xl font-headings dark:text-white;
	}
	.pricing-three-columns__description {
		@apply mx-auto mt-6 max-w-2xl text-lg font-medium text-neutral-600 dark:text-neutral-400;
	}
	.pricing-three-columns__grid {
		@apply mx-auto mt-16 max-w-md sm:mt-20 lg:mx-0 lg:max-w-none;
	}
	.three-card {
		@apply flex flex-col justify-between rounded-3xl bg-white p-8 ring-1 ring-neutral-200 xl:p-10 dark:bg-neutral-900 dark:ring-neutral-800 w-full transition-all duration-300;
	}
	.three-card--popular {
		@apply lg:z-10 lg:rounded-b-none ring-primary-500 dark:ring-primary-500 shadow-xl;
	}
	.three-card--first {
		@apply lg:mt-8 -mr-px lg:rounded-r-none;
	}
	.three-card--last {
		@apply lg:mt-8 -ml-px lg:rounded-l-none;
	}
	.three-card__name {
		@apply text-lg font-semibold leading-8 text-neutral-900 dark:text-white font-headings;
	}
	.three-card__name--popular {
		@apply text-primary-500;
	}
	.three-card__badge {
		@apply rounded-full bg-primary-500/10 px-2.5 py-1 text-xs font-semibold text-primary-500;
	}
	.three-card__description {
		@apply mt-4 text-sm leading-6 text-neutral-600 dark:text-neutral-400;
	}
	.three-card__price {
		@apply mt-6 flex items-baseline gap-x-1;
	}
	.three-card__price-amount {
		@apply text-4xl font-bold tracking-tight text-neutral-900 dark:text-white font-headings;
	}
	.three-card__price-label {
		@apply text-sm font-semibold text-neutral-600 dark:text-neutral-400;
	}
	.three-card__list {
		@apply mt-8 space-y-3 text-sm leading-6 text-neutral-600 dark:text-neutral-400;
	}
	.three-card__item {
		@apply flex gap-x-3;
	}
	.three-card__icon {
		@apply h-6 w-5 flex-none text-primary-500;
	}
	.three-card__button {
		@apply mt-8 block rounded-md px-3 py-2 text-center text-sm font-semibold leading-6 transition-all;
	}
	.three-card__button--primary {
		@apply bg-primary-500 text-white shadow-sm hover:bg-primary-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500;
	}
	.three-card__button--outline {
		@apply text-primary-500 ring-1 ring-inset ring-primary-200 hover:ring-primary-300 dark:ring-primary-900 dark:hover:ring-primary-700;
	}
</style>
