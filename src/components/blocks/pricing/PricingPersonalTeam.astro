---
// PricingPersonalTeam
// ------------
// Description: Two tiers, Personal is featured with white bg and shadow.

import Section from '@components/ui/Section.astro'
import Row from '@components/ui/Row.astro'
import Col from '@components/ui/Col.astro'
import { Icon } from 'astro-icon/components'
import pricingData from '@data/json-files/pricingPersonalTeam.json'

interface Props {
	classes?: string
}
const { classes } = Astro.props
---

<Section classes={`pricing-personal-team ${classes || ''}`}>
	<div class="pricing-personal-team__bg" aria-hidden="true">
		<div class="pricing-personal-team__blur"></div>
	</div>

	<Row>
		<Col span="12" align="center" classes="pricing-personal-team__header">
			<h2 class="pricing-personal-team__title">{pricingData.title}</h2>
			<p class="pricing-personal-team__heading">{pricingData.heading}</p>
			<p class="pricing-personal-team__description">{pricingData.description}</p>
		</Col>
	</Row>

	<Row classes="pricing-personal-team__grid">
		{
			pricingData.tiers.map((tier, index) => (
				<Col span="6" classes="flex justify-center">
					<div
						class:list={[
							'pricing-card',
							{ 'pricing-card--featured': tier.featured },
							{ 'pricing-card--first': !tier.featured && index === 0 },
							{ 'pricing-card--last': !tier.featured && index !== 0 }
						]}
					>
						<h3 id={tier.id} class="pricing-card__name">
							{tier.name}
						</h3>
						<p class="pricing-card__price">
							<span class="pricing-card__price-amount">{tier.priceMonthly}</span>
							<span class="pricing-card__price-label">/mês</span>
						</p>
						<p class="pricing-card__description">{tier.description}</p>
						<ul role="list" class="pricing-card__features">
							{tier.features.map((feature) => (
								<li class="pricing-card__feature">
									<Icon name="check-circle" class="pricing-card__feature-icon" />
									{feature}
								</li>
							))}
						</ul>
						<a
							href={tier.href}
							aria-describedby={tier.id}
							class:list={[
								'pricing-card__button',
								tier.featured ? 'pricing-card__button--primary' : 'pricing-card__button--outline'
							]}
						>
							Comece hoje
						</a>
					</div>
				</Col>
			))
		}
	</Row>
</Section>

<style>
	.pricing-personal-team {
		@apply relative isolate overflow-hidden py-24 sm:py-32;
	}
	.pricing-personal-team__bg {
		@apply absolute inset-x-0 -top-3 -z-10 transform-gpu overflow-hidden px-36 blur-3xl;
	}
	.pricing-personal-team__blur {
		@apply mx-auto aspect-[1155/678] w-[72.1875rem] bg-gradient-to-tr from-primary-300 to-primary-500 opacity-30;
		clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%);
	}
	.pricing-personal-team__header {
		@apply mx-auto max-w-4xl text-center mb-16;
	}
	.pricing-personal-team__title {
		@apply text-base font-semibold leading-7 text-primary-500 font-headings;
	}
	.pricing-personal-team__heading {
		@apply mt-2 text-balance text-4xl font-bold tracking-tight text-neutral-900 sm:text-5xl font-headings dark:text-white;
	}
	.pricing-personal-team__description {
		@apply mx-auto mt-6 max-w-2xl text-pretty text-center text-lg font-medium text-neutral-600 sm:text-xl/8 dark:text-neutral-400;
	}
	.pricing-personal-team__grid {
		@apply mx-auto mt-16 max-w-lg items-center gap-y-6 sm:mt-20 lg:max-w-4xl lg:grid-cols-2;
	}
	.pricing-card {
		@apply w-full rounded-3xl p-8 ring-1 ring-neutral-900/10 sm:p-10 bg-white/60 dark:bg-neutral-800/60 dark:ring-neutral-700/50 transition-all duration-300;
	}
	.pricing-card--featured {
		@apply relative bg-white shadow-2xl dark:bg-neutral-800 ring-neutral-200 dark:ring-neutral-700;
	}
	.pricing-card--first {
		@apply sm:mx-8 lg:mx-0 rounded-t-3xl sm:rounded-b-none lg:rounded-tr-none lg:rounded-bl-3xl;
	}
	.pricing-card--last {
		@apply sm:mx-8 lg:mx-0 sm:rounded-t-none lg:rounded-tr-3xl lg:rounded-bl-none;
	}
	.pricing-card__name {
		@apply text-base font-semibold leading-7 text-primary-500 font-headings;
	}
	.pricing-card__price {
		@apply mt-4 flex items-baseline gap-x-2;
	}
	.pricing-card__price-amount {
		@apply text-5xl font-bold tracking-tight text-neutral-900 dark:text-white font-headings;
	}
	.pricing-card__price-label {
		@apply text-base text-neutral-500 dark:text-neutral-400;
	}
	.pricing-card__description {
		@apply mt-6 text-base leading-7 text-neutral-600 dark:text-neutral-400;
	}
	.pricing-card__features {
		@apply mt-8 space-y-3 text-sm leading-6 text-neutral-600 sm:mt-10 dark:text-neutral-400;
	}
	.pricing-card__feature {
		@apply flex gap-x-3;
	}
	.pricing-card__feature-icon {
		@apply h-6 w-5 flex-none text-primary-500;
	}
	.pricing-card__button {
		@apply mt-8 block rounded-md px-3.5 py-2.5 text-center text-sm font-semibold leading-6 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 transition-all duration-300;
	}
	.pricing-card__button--primary {
		@apply bg-primary-500 text-white shadow-sm hover:bg-primary-400 focus-visible:outline-primary-500;
	}
	.pricing-card__button--outline {
		@apply text-primary-500 ring-1 ring-inset ring-primary-200 hover:ring-primary-300 focus-visible:outline-primary-500 dark:ring-primary-900 dark:hover:ring-primary-700;
	}
</style>
