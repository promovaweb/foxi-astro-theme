---
// Seção de grade de Postagens do Blog
// ------------
// Descrição: Uma grade de postagens de blog ordenadas por data em um layout de 3 colunas.
// Propriedades:
// - data: Um array de postagens de blog

// Components
// - Layout
import Section from '@components/ui/Section.astro'
import Row from '@components/ui/Row.astro'
import Col from '@components/ui/Col.astro'
// - UI
import Post from '@components/ui/cards/BlogCard.astro'
import TagNavigation from '@components/ui/blog/TagNavigation.astro'
import Pagination from '@components/ui/Pagination.astro'

// Props
type Props = {
	data?: any
	page?: any
}
const { data: allPosts, page } = Astro.props

// Use page.data if page is provided, otherwise use allPosts
const postsToDisplay = page ? page.data : allPosts

// Function to sort posts by date (only if not already paginated)
const sortedPosts = page 
	? postsToDisplay 
	: postsToDisplay.sort((a: any, b: any) => {
		return new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
	})
---

<Section>
	<Row>
		<Col span="12">
			<TagNavigation />
		</Col>
		{
			sortedPosts.map((post: any) => (
				<Col span="4">
					<Post
						link={`/blog/${post.id}`}
						title={post.data.title}
						subtitle={`Por ${post.data.author} em ${new Date(post.data.pubDate).toLocaleDateString('pt-BR', { year: 'numeric', month: 'long', day: 'numeric' })}`}
						image={post.data.image}
						tags={post.data.tags}
					>
						{post.data.description}
					</Post>
				</Col>
			))
		}
		{
			page && (
				<Col span="12">
					<Pagination page={page} />
				</Col>
			)
		}
	</Row>
</Section>
