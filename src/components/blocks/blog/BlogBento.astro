---
/**
 * Componente: BlogBento
 * Descrição: Uma vitrine em estilo Bento Grid para o blog com 5 itens.
 * Baseado no design do PodcastBento.
 */

import Section from '@components/ui/Section.astro'
import Row from '@components/ui/Row.astro'
import Col from '@components/ui/Col.astro'
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import { getCollection } from 'astro:content'

// Buscar posts recentes
const allPosts = await getCollection('blog')
const recentPosts = allPosts
	.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
	.slice(0, 5)

// Se não houver posts, não renderiza nada
if (recentPosts.length === 0) {
	return null
}

const mainPost = recentPosts[0]
const otherPosts = recentPosts.slice(1)
---

<Section id="blog-bento" classes="bg-white dark:bg-neutral-950">
	<Row classes="mb-12 lg:mb-16">
		<Col span="12" align="center">
			<div class="mb-4 inline-flex items-center gap-2 rounded-full bg-primary-500/10 px-4 py-1.5 text-xs font-black uppercase tracking-[0.2em] text-primary-600 dark:text-primary-400">
				✍️ Insights e Artigos
			</div>
			<h2 class="text-4xl font-black tracking-tight text-neutral-900 dark:text-white lg:text-5xl">
				Novidades do nosso <strong>Blog</strong>
			</h2>
			<p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-neutral-600 dark:text-neutral-400">
				Fique por dentro das últimas notícias, tutoriais e atualizações do universo Foxi Astro.
			</p>
		</Col>
	</Row>

	<div class="grid grid-cols-1 md:grid-cols-4 md:grid-rows-2 gap-6 lg:gap-8 h-auto lg:h-[650px] px-4 lg:px-0">
		<!-- Card de Destaque (Primeiro Post) -->
		<a 
			href={`/blog/${mainPost.id}`} 
			class="md:col-span-2 md:row-span-2 group relative flex flex-col justify-end overflow-hidden rounded-[2.5rem] bg-neutral-900 shadow-2xl transition-all duration-500 hover:shadow-primary-500/20"
		>
			<Image 
				src={mainPost.data.image} 
				alt={mainPost.data.title} 
				width={800}
                height={800}
				class="absolute inset-0 h-full w-full object-cover opacity-60 transition-transform duration-1000 group-hover:scale-105 group-hover:opacity-40"
			/>
			<!-- Overlay de Gradiente -->
			<div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/40 to-transparent"></div>
			
			<!-- Conteúdo do Destaque -->
			<div class="relative z-10 p-8 lg:p-14">
				<div class="mb-6 inline-flex items-center gap-2 rounded-full bg-primary-500 px-4 py-1.5 text-[10px] font-black uppercase tracking-widest text-white shadow-lg shadow-primary-500/30">
					<Icon name="document-text" class="h-4 w-4" />
					Artigo em Destaque
				</div>
				<h3 class="text-3xl lg:text-5xl font-black text-white mb-6 leading-[1.1] tracking-tighter">
					{mainPost.data.title}
				</h3>
				<p class="text-neutral-300 text-lg lg:text-xl mb-8 max-w-md leading-relaxed opacity-90 line-clamp-2">
					{mainPost.data.description}
				</p>
				<div class="inline-flex items-center gap-3 font-black text-primary-400 group-hover:text-primary-300 transition-all group-hover:translate-x-2">
					Ler artigo completo <Icon name="long-arrow-right" class="h-6 w-6" />
				</div>
			</div>
		</a>

		<!-- Outros Posts Recentes -->
		{otherPosts.map((post) => (
			<a 
				href={`/blog/${post.id}`}
				class="group relative flex flex-col overflow-hidden rounded-[2rem] bg-neutral-50 dark:bg-neutral-900 p-8 shadow-sm ring-1 ring-neutral-200 dark:ring-neutral-800 transition-all duration-300 hover:ring-primary-500/50 hover:shadow-xl hover:shadow-primary-500/5"
			>
				<div class="flex flex-col h-full relative z-10">
					<div class="mb-6 flex items-center justify-between">
						<span class="inline-flex items-center rounded-full bg-white dark:bg-neutral-800 px-3 py-1 text-[10px] font-black uppercase tracking-widest text-neutral-500 dark:text-neutral-400 group-hover:bg-primary-500/10 group-hover:text-primary-500 transition-colors">
							{post.data.tags ? post.data.tags[0] : 'Blog'}
						</span>
						<Icon name="document-text" class="h-6 w-6 text-neutral-300 group-hover:text-primary-500 transition-all duration-300 group-hover:scale-110" />
					</div>
					
					<h4 class="text-xl font-bold leading-tight text-neutral-900 dark:text-white mb-4 line-clamp-2 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
						{post.data.title}
					</h4>
					
					<p class="text-sm leading-relaxed text-neutral-500 dark:text-neutral-400 line-clamp-3 mb-6">
						{post.data.description}
					</p>
					
					<div class="mt-auto pt-6 flex items-center justify-between border-t border-neutral-200 dark:border-neutral-800 transition-colors group-hover:border-primary-500/10">
						<div class="flex items-center gap-2 text-[11px] font-bold text-neutral-400 uppercase tracking-wider">
							<Icon name="sun" class="h-3.5 w-3.5" />
							{new Date(post.data.pubDate).toLocaleDateString('pt-BR', { day: '2-digit', month: 'short' })}
						</div>
						<div class="opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300">
							<Icon name="long-arrow-right" class="h-4 w-4 text-primary-500" />
						</div>
					</div>
				</div>
				<!-- Subtle Background Hover Effect -->
				<div class="absolute inset-0 bg-gradient-to-br from-primary-500/0 to-primary-500/0 opacity-0 group-hover:opacity-[0.03] transition-opacity duration-500"></div>
			</a>
		))}
	</div>
</Section>

<style>
	.line-clamp-2 {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	
	.line-clamp-3 {
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>
