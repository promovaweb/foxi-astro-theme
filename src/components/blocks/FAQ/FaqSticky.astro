---
// FAQ com barra lateral fixa
// ------------
// Descrição: uma seção de FAQ com o título como uma barra lateral fixa (sticky).

// Componentes
// - UI
import StickySidebar from '@components/blocks/basic/StickySidebar.astro'
import FAQ from '@components/ui/Accordion.astro'
import Card from '@components/ui/cards/partials/Card.astro'

// Props
type Props = {
	title: string
	text?: string
	data: any
	type?: 'left' | 'right'
	classes?: string
}
const { title, text, data, type = 'left', classes } = Astro.props
---

<StickySidebar classes={classes} type={type}>
	<header slot="sidebar">
		{title && <h3 class="text-3xl">{title}</h3>}
		{text && <p class="text-lg leading-relaxed">{text}</p>}
	</header>

	<Card classes="divide-y divide-neutral-100 dark:divide-neutral-800">
		{data.map((faq: any) => <FAQ title={faq.question} text={faq.reply} open={faq.open} />)}
	</Card>
</StickySidebar>
