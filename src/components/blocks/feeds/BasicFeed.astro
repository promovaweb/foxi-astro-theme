---
// Uma seção de Feed
// ------------
// Descrição: Uma seção com feeds organizados em uma lista vertical de itens.

// Componentes
// - Layout
import Section from '@components/ui/Section.astro'
import Col from '@components/ui/Col.astro'
import Row from '@components/ui/Row.astro'
// - UI
import Feed from '@components/ui/Feed.astro'

// Props
type Props = {
	data: Array<{
		title: string
		date?: string
		body?: string
		listItems?: Array<{ listItem: string }>
	}>
	classes?: string
}
const { data, classes } = Astro.props
---

<Section id="changelog">
	<Row>
		<Col span="2" />
		<Col span="8">
			<Feed data={data} classes={classes} />
		</Col>
		<Col span="2" />
	</Row>
</Section>
