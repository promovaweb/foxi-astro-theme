---
// Download: Template de Planejamento
// ------------
import Layout from '@layouts/landing/DownloadLanding.astro'
import LandingHero from '@components/blocks/landing/LandingHero.astro'
import LandingForm from '@components/blocks/landing/LandingForm.astro'
import LandingFooter from '@components/blocks/landing/LandingFooter.astro'
import DownloadDetails from '@components/blocks/landing/DownloadDetails.astro'
import ContentList from '@components/blocks/landing/ContentList.astro'
import ImageSlider from '@components/blocks/landing/ImageSlider.astro'
import Row from '@components/ui/Row.astro'
import Col from '@components/ui/Col.astro'
import Section from '@components/ui/Section.astro'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'

// Imports de imagens
import heroImage from '@/assets/hero-01.png'
import slide1 from '@/assets/bg-01.png'
import slide2 from '@/assets/cta-dark-bg.png'
import slide3 from '@/assets/cta-light-bg.png'
import slide4 from '@/assets/test.jpg'
import slide5 from '@/assets/hero-01.png'

const metadata = {
	title: "Template de Planejamento Estratégico",
	description: "Baixe nosso template exclusivo em PDF para planejar o próximo trimestre da sua empresa com foco em resultados."
}

const templateDetails = {
	format: "PDF Interativo",
	size: "2.4 MB",
	version: "2.0",
	lastUpdated: "Março 2024"
}

const contentItems = [
	"Framework de definição de OKRs",
	"Matriz de priorização de projetos",
	"Cronograma macro trimestral",
	"Planilha de alocação de recursos",
	"Guia de métricas de sucesso",
	"Checklist de revisão semanal"
]

const sliderSlides = [
	{ image: slide1, caption: "Interface intuitiva para visualização clara de objetivos e metas trimestrais." },
	{ image: slide2, caption: "Controle total sobre o cronograma macro e alocação de recursos da equipe." },
	{ image: slide3, caption: "Dashboards interativos para acompanhamento de KPIs em tempo real." },
	{ image: slide4, caption: "Metodologia validada por centenas de gestores em todo o mundo." },
	{ image: slide5, caption: "Tudo o que você precisa para uma execução estratégica impecável." }
]
---

<Layout {...metadata}>
	<LandingHero 
		tag="Ferramenta Gratuita"
		title="Planeje seu sucesso com nosso <strong>Template Estratégico</strong>"
		text={metadata.description}
	>
		<div slot="image" class="w-full max-w-lg mx-auto lg:ml-auto">
			<LandingForm 
				title="Baixe o Template Gratuitamente" 
				buttonText="Quero baixar agora" 
				thankYouPage="/materiais/downloads/template-planejamento-obrigado"
				contrast={true} 
			/>
		</div>

		<div slot="after-text">
			<div class="flex items-center gap-4 text-sm text-neutral-500 font-medium">
				<Icon name="shield-check" class="w-5 h-5 text-emerald-500" />
				Sua privacidade é nossa prioridade. Download 100% seguro.
			</div>
		</div>
	</LandingHero>

	<!-- Segunda Seção: Imagem 16:9 + Texto -->
	<Section classes="bg-white dark:bg-neutral-950 py-24 lg:py-32">
		<Row>
			<Col span="12" lg="6" classes="mb-12 lg:mb-0">
				<div class="relative rounded-3xl overflow-hidden aspect-video shadow-2xl border border-neutral-100 dark:border-neutral-800">
					<Image src={heroImage} alt="Preview do Planejamento" class="w-full h-full object-cover" />
					<div class="absolute inset-0 bg-gradient-to-t from-neutral-900/40 to-transparent"></div>
				</div>
			</Col>
			<Col span="12" lg="6" classes="lg:pl-16 flex flex-col justify-center">
				<h2 class="text-3xl lg:text-5xl font-black text-neutral-900 dark:text-white mb-8">Visão 360º do seu <strong>negócio</strong></h2>
				<p class="text-lg text-neutral-600 dark:text-neutral-400 mb-8 leading-relaxed">
					Nosso template oferece uma interface visual intuitiva para você mapear cada aspecto do seu planejamento trimestral. Elimine a confusão de planilhas complexas e foque no que realmente importa: a execução estratégica.
				</p>
				<p class="text-lg text-neutral-600 dark:text-neutral-400 mb-0 leading-relaxed">
					Com este recurso, você poderá visualizar gargalos antes que eles aconteçam e manter toda a sua equipe na mesma página, utilizando frameworks validados pelo mercado.
				</p>
			</Col>
		</Row>
	</Section>

	<!-- Terceira Seção: Texto de um lado e Lista de outro -->
	<Section classes="bg-neutral-50 dark:bg-neutral-900/50 py-24 lg:py-32">
		<Row>
			<Col span="12" lg="6" classes="mb-12 lg:mb-0 flex flex-col justify-center">
				<h2 class="text-3xl lg:text-5xl font-black text-neutral-900 dark:text-white mb-8">Por que usar este <strong>template</strong>?</h2>
				<p class="text-lg text-neutral-600 dark:text-neutral-400 mb-6 leading-relaxed">
					Diferente de modelos genéricos, este template foi construído com base em metodologias ágeis e OKRs, adaptando-se perfeitamente a startups e empresas consolidadas.
				</p>
				<div class="flex flex-col gap-4">
					<div class="flex items-center gap-3">
						<div class="w-10 h-10 bg-primary-500/10 text-primary-500 rounded-lg flex items-center justify-center">
							<Icon name="rocket" class="w-5 h-5" />
						</div>
						<span class="font-bold text-neutral-900 dark:text-white">Implementação Imediata</span>
					</div>
					<div class="flex items-center gap-3">
						<div class="w-10 h-10 bg-primary-500/10 text-primary-500 rounded-lg flex items-center justify-center">
							<Icon name="chart-pie" class="w-5 h-5" />
						</div>
						<span class="font-bold text-neutral-900 dark:text-white">Foco Total em Dados</span>
					</div>
				</div>
			</Col>
			<Col span="12" lg="6" classes="lg:pl-16">
				<ContentList 
					title="O que você vai <strong>encontrar</strong>:" 
					items={contentItems} 
				/>
			</Col>
		</Row>
	</Section>

	<!-- Quarta Seção: Detalhes do Download (2 colunas) -->
	<Section classes="bg-white dark:bg-neutral-950 py-24 lg:py-32 border-t border-neutral-100 dark:border-neutral-800">
		<Row>
			<Col span="12" lg="6" classes="mb-16 lg:mb-0">
				<div class="mb-10">
					<h3 class="text-2xl font-bold text-neutral-900 dark:text-white mb-4">Especificações Técnicas</h3>
					<p class="text-neutral-600 dark:text-neutral-400">Dados do arquivo para garantir que você tenha a melhor experiência ao abrir e editar o material.</p>
				</div>
				<DownloadDetails {...templateDetails} />
			</Col>
			<Col span="12" lg="6" classes="lg:pl-16">
				<div class="h-full bg-neutral-900 text-white p-8 lg:p-12 rounded-[2rem] relative overflow-hidden group">
					<!-- Glow effect -->
					<div class="absolute -top-24 -right-24 w-64 h-64 bg-primary-500/20 rounded-full blur-[80px] group-hover:bg-primary-500/30 transition-all duration-700"></div>
					
					<h3 class="text-2xl font-bold mb-6 relative z-10">Como utilizar o material?</h3>
					<ul class="space-y-6 relative z-10">
						<li class="flex gap-4">
							<span class="flex-shrink-0 w-8 h-8 bg-white/10 rounded-full flex items-center justify-center text-sm font-bold">1</span>
							<p class="text-neutral-300 text-sm">Após o download, abra o PDF no seu navegador ou leitor de preferência.</p>
						</li>
						<li class="flex gap-4">
							<span class="flex-shrink-0 w-8 h-8 bg-white/10 rounded-full flex items-center justify-center text-sm font-bold">2</span>
							<p class="text-neutral-300 text-sm">O arquivo é interativo: você pode preencher os campos diretamente na tela.</p>
						</li>
						<li class="flex gap-4">
							<span class="flex-shrink-0 w-8 h-8 bg-white/10 rounded-full flex items-center justify-center text-sm font-bold">3</span>
							<p class="text-neutral-300 text-sm">Salve sua versão preenchida e compartilhe com os stakeholders do projeto.</p>
						</li>
					</ul>
					<div class="mt-10 pt-8 border-t border-white/10 relative z-10">
						<p class="text-xs text-neutral-500 italic">Dica: Recomendamos o Adobe Acrobat Reader para melhor suporte às funções interativas.</p>
					</div>
				</div>
			</Col>
		</Row>
	</Section>

	<!-- Última Seção: Slider de Imagens -->
	<ImageSlider 
		title="Conheça cada detalhe do <strong>material</strong>" 
		slides={sliderSlides} 
	/>

	<LandingFooter />
</Layout>

<style>
	html {
		scroll-behavior: smooth;
	}
</style>
