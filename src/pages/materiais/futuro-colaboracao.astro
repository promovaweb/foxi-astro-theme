---
// Webinar: Futuro da Colaboração
// ------------
import Layout from '@layouts/landing/WebinarLanding.astro'
import LandingHero from '@components/blocks/landing/LandingHero.astro'
import LandingForm from '@components/blocks/landing/LandingForm.astro'
import LandingFooter from '@components/blocks/landing/LandingFooter.astro'
import DownloadDetails from '@components/blocks/landing/DownloadDetails.astro'
import ContentList from '@components/blocks/landing/ContentList.astro'
import SocialIcon from '@components/ui/SocialIcon.astro'
import Row from '@components/ui/Row.astro'
import Col from '@components/ui/Col.astro'
import Section from '@components/ui/Section.astro'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'

// Import de imagem real para o webinar
import webinarCover from '@/assets/bg-01.png'

const metadata = {
	title: "O Futuro da Colaboração Remota",
	description: "Assista a este webinar exclusivo com especialistas do mercado sobre as trendências de trabalho para os próximos anos."
}

const webinarDetails = {
	format: "Webinar Gravado",
	size: "60 Minutos",
	version: "Português",
	lastUpdated: "Maio 2024"
}

const discussionPoints = [
	"Ferramentas essenciais para times distribuídos",
	"Como manter a cultura da empresa à distância",
	"Gestão de performance e KPIs em modelos híbridos",
	"Saúde mental e equilíbrio entre vida pessoal",
	"Comunicação assíncrona vs síncrona",
	"Futuro do escritório físico nas corporações"
]

// Configuração de redes sociais para os organizadores
const organizers = {
	host: {
		name: "Ricardo Fonseca",
		role: "Diretor de Tecnologia na TechFlow",
		image: "/blog/post-01.png",
		bio: "Com mais de 15 anos de experiência liderando times distribuídos em 3 continentes, Ricardo foca em resultados e cultura.",
		socials: [
			{ platform: 'website', link: '#' },
			{ platform: 'instagram', link: '#' },
			{ platform: 'facebook', link: '#' },
			{ platform: 'linkedin', link: '#' },
			{ platform: 'tiktok', link: '#' },
			{ platform: 'youtube', link: '#' },
			{ platform: 'whatsapp', link: '#' }
		]
	},
	speakers: [
		{
			name: "Ana Oliveira",
			role: "Head de People @ GlobalSync",
			image: "/blog/post-02.png",
			bio: "Especialista em cultura organizacional e estratégias de retenção para talentos remotos.",
			socials: [
				{ platform: 'instagram', link: '#' },
				{ platform: 'linkedin', link: '#' },
				{ platform: 'twitter', link: '#' }
			]
		},
		{
			name: "Marcus Santos",
			role: "Consultor de Operações Ágeis",
			image: "/blog/post-03.png",
			bio: "Ajuda empresas a escalarem seus processos internos usando metodologias assíncronas.",
			socials: [
				{ platform: 'website', link: '#' },
				{ platform: 'linkedin', link: '#' },
				{ platform: 'whatsapp', link: '#' }
			]
		}
	],
	team: [
		{ 
			name: "Juliana Lima", 
			role: "Moderação", 
			image: "/blog/post-04.png", 
			bio: "Especialista em engajamento de comunidades digitais.", 
			socials: [ { platform: 'instagram', link: '#' } ] 
		},
		{ 
			name: "Paulo Mendes", 
			role: "Suporte Técnico", 
			image: "/blog/post-05.png", 
			bio: "Garante a melhor experiência de áudio e vídeo.", 
			socials: [ { platform: 'whatsapp', link: '#' }, { platform: 'youtube', link: '#' } ] 
		},
		{ 
			name: "Carla Souza", 
			role: "Curadoria", 
			image: "/blog/post-06.png", 
			bio: "Responsável pela seleção dos temas e palestrantes.", 
			socials: [ { platform: 'linkedin', link: '#' }, { platform: 'facebook', link: '#' } ] 
		}
	]
}
---

<Layout {...metadata}>
	<LandingHero 
		tag="Webinar Online & Gratuito"
		title="O Futuro da <strong>Colaboração</strong> Remota"
		text={metadata.description}
	>
		<div slot="image" class="w-full max-w-lg mx-auto lg:ml-auto">
			<LandingForm 
				title="Acesse o Webinar Gratuitamente" 
				buttonText="Assistir ao conteúdo agora" 
				thankYouPage="/materiais/futuro-colaboracao-obrigado"
				contrast={true} 
			/>
		</div>

		<div slot="after-text">
			<div class="flex items-center gap-4 text-sm text-neutral-500 font-medium">
				<Icon name="check-circle" class="w-5 h-5 text-primary-500" />
				Acesso imediato após a inscrição.
			</div>
		</div>
	</LandingHero>

	<!-- Segunda Seção: Imagem 16:9 + Texto -->
	<Section classes="bg-white dark:bg-neutral-950 py-24 lg:py-32">
		<Row>
			<Col span="12" lg="6" classes="mb-12 lg:mb-0">
				<div class="relative rounded-3xl overflow-hidden aspect-video shadow-2xl border border-neutral-100 dark:border-neutral-800 group">
					<Image src={webinarCover} alt="Preview do Webinar" width={1920} height={1080} class="w-full h-full object-cover" />
					<div class="absolute inset-0 flex items-center justify-center pointer-events-none">
						<div class="w-20 h-20 bg-white/20 backdrop-blur-md rounded-full flex items-center justify-center text-white border border-white/30">
							<Icon name="bolt" class="w-10 h-10 ml-1" />
						</div>
					</div>
				</div>
			</Col>
			<Col span="12" lg="6" classes="lg:pl-16 flex flex-col justify-center">
				<h2 class="text-3xl lg:text-5xl font-black text-neutral-900 dark:text-white mb-8">Lidere seu time para a <strong>nova era</strong></h2>
				<p class="text-lg text-neutral-600 dark:text-neutral-400 mb-8 leading-relaxed">
					Neste encontro digital, exploramos as transformações profundas que estão moldando o mercado de trabalho global e como você pode preparar sua empresa para a colaboração remota de alto nível.
				</p>
				<p class="text-lg text-neutral-600 dark:text-neutral-400 mb-0 leading-relaxed italic">
					"A distância física não é mais uma barreira para a excelência organizacional quando temos os processos e a cultura corretos."
				</p>
			</Col>
		</Row>
	</Section>

	<!-- Terceira Seção: Texto em Duas Colunas -->
	<Section classes="bg-white dark:bg-neutral-950 py-24 lg:py-32 border-t border-neutral-100 dark:border-neutral-800">
		<Row>
			<Col span="12" lg="6" classes="mb-12 lg:mb-0 lg:pr-12">
				<h2 class="text-3xl lg:text-4xl font-black text-neutral-900 dark:text-white mb-6">Por que a colaboração remota é o <strong>futuro</strong>?</h2>
				<p class="text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed">
					O mercado global passou por uma mudança sem volta. Hoje, as empresas que dominam as ferramentas e a cultura do trabalho distribuído não apenas economizam custos operacionais, mas têm acesso aos melhores talentos do mundo, independentemente da localização geográfica.
				</p>
				<p class="text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed">
					Nossa missão neste webinar é desmistificar os medos comuns sobre a perda de controle e mostrar como a transparência radical pode elevar a performance do seu time.
				</p>
			</Col>
			<Col span="12" lg="6" classes="lg:pl-12 lg:border-l border-neutral-100 dark:border-neutral-800">
				<h2 class="text-3xl lg:text-4xl font-black text-neutral-900 dark:text-white mb-6">Metodologias validadas pelo <strong>mercado</strong></h2>
				<p class="text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed">
					Não falaremos apenas de teoria. Apresentaremos frameworks de comunicação assíncrona que foram testados em cenários de alta pressão e crescimento acelerado. Você entenderá como transformar reuniões improdutivas em fluxos de trabalho documentados.
				</p>
				<p class="text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed">
					Este conteúdo foi estruturado para ser um guia prático, permitindo que você saia da sessão com um plano de ação claro para implementar na sua empresa já na próxima segunda-feira.
				</p>
			</Col>
		</Row>
	</Section>

	<!-- Quarta Seção: Detalhes do Webinar (Agora abaixo do texto) -->
	<Section classes="bg-neutral-50 dark:bg-neutral-900/50 py-24 lg:py-32 border-y border-neutral-100 dark:border-neutral-800">
		<Row>
			<Col span="12" lg="6" classes="mb-16 lg:mb-0 flex flex-col justify-center">
				<div class="mb-10">
					<h3 class="text-2xl font-bold text-neutral-900 dark:text-white mb-4">Informações do Webinar</h3>
					<p class="text-neutral-600 dark:text-neutral-400">Dados técnicos sobre o conteúdo que você está prestes a assistir.</p>
				</div>
				<DownloadDetails 
					format={webinarDetails.format}
					size={webinarDetails.size}
					version={webinarDetails.version}
					lastUpdated={webinarDetails.lastUpdated}
				/>
			</Col>
			<Col span="12" lg="6" classes="lg:pl-16">
				<ContentList 
					title="O que vamos <strong>discutir</strong>:" 
					items={discussionPoints} 
				/>
			</Col>
		</Row>
	</Section>

	<!-- SEÇÃO 1: 1 Organizador -->
	<Section classes="bg-white dark:bg-neutral-950 pt-24 lg:pt-40">
		<Row>
			<Col span="12" align="center" classes="mb-12">
				<h2 class="text-3xl lg:text-5xl font-black text-neutral-900 dark:text-white mb-4">Apresentador <strong>Principal</strong></h2>
				<p class="text-lg text-neutral-600 dark:text-neutral-400 max-w-2xl mx-auto">Conheça o especialista que guiará este encontro e compartilhará sua visão estratégica.</p>
			</Col>
			<Col span="12" lg="8" align="center" classes="lg:col-start-3">
				<div class="mb-8 w-24 h-24 rounded-full overflow-hidden border-4 border-primary-500/20 mx-auto shadow-lg">
					<Image src={organizers.host.image} alt={organizers.host.name} width={200} height={200} class="w-full h-full object-cover" />
				</div>
				<h3 class="text-2xl font-bold text-neutral-900 dark:text-white mb-2">{organizers.host.name}</h3>
				<p class="text-primary-500 font-bold mb-4 uppercase tracking-widest text-sm">{organizers.host.role}</p>
				
				<div class="flex justify-center gap-4 mb-6">
					{organizers.host.socials.map(social => (
						<SocialIcon platform={social.platform as any} link={social.link} size={20} />
					))}
				</div>

				<p class="text-lg text-neutral-600 dark:text-neutral-400 max-w-2xl mx-auto leading-relaxed">
					{organizers.host.bio}
				</p>
			</Col>
		</Row>
	</Section>

	<!-- SEÇÃO 2: 2 Organizadores -->
	<Section classes="bg-white dark:bg-neutral-950 py-24">
		<Row>
			<Col span="12" align="center" classes="mb-12">
				<h2 class="text-3xl lg:text-5xl font-black text-neutral-900 dark:text-white mb-4">Palestrantes <strong>Convidados</strong></h2>
				<p class="text-lg text-neutral-600 dark:text-neutral-400 max-w-2xl mx-auto">Líderes de mercado trazendo experiências práticas e estudos de caso reais.</p>
			</Col>
			{organizers.speakers.map(speaker => (
				<Col span="12" lg="6" align="center" classes="mb-12 lg:mb-0">
					<div class="mb-8 w-24 h-24 rounded-full overflow-hidden border-4 border-primary-500/20 mx-auto shadow-lg">
						<Image src={speaker.image} alt={speaker.name} width={200} height={200} class="w-full h-full object-cover" />
					</div>
					<h3 class="text-2xl font-bold text-neutral-900 dark:text-white mb-2">{speaker.name}</h3>
					<p class="text-primary-500 font-bold mb-4 uppercase tracking-widest text-sm">{speaker.role}</p>
					
					<div class="flex justify-center gap-4 mb-6">
						{speaker.socials.map(social => (
							<SocialIcon platform={social.platform as any} link={social.link} size={20} />
						))}
					</div>

					<p class="text-lg text-neutral-600 dark:text-neutral-400 max-w-sm mx-auto leading-relaxed">
						{speaker.bio}
					</p>
				</Col>
			))}
		</Row>
	</Section>

	<!-- SEÇÃO 3: 3 Organizadores -->
	<Section classes="bg-white dark:bg-neutral-950 pb-24 lg:pb-40">
		<Row>
			<Col span="12" align="center" classes="mb-12">
				<h2 class="text-3xl lg:text-5xl font-black text-neutral-900 dark:text-white mb-4">Time de <strong>Produção</strong></h2>
				<p class="text-lg text-neutral-600 dark:text-neutral-400 max-w-2xl mx-auto">A equipe dedicada à curadoria de temas e ao suporte técnico impecável.</p>
			</Col>
			{organizers.team.map(member => (
				<Col span="12" lg="4" align="center" classes="mb-12 lg:mb-0">
					<div class="mb-8 w-24 h-24 rounded-full overflow-hidden border-4 border-primary-500/20 mx-auto shadow-lg">
						<Image src={member.image} alt={member.name} width={200} height={200} class="w-full h-full object-cover" />
					</div>
					<h3 class="text-2xl font-bold text-neutral-900 dark:text-white mb-2">{member.name}</h3>
					<p class="text-primary-500 font-bold mb-4 uppercase tracking-widest text-sm">{member.role}</p>
					
					<div class="flex justify-center gap-4 mb-6">
						{member.socials.map(social => (
							<SocialIcon platform={social.platform as any} link={social.link} size={20} />
						))}
					</div>

					<p class="text-lg text-neutral-600 dark:text-neutral-400 max-w-sm mx-auto leading-relaxed">
						{member.bio}
					</p>
				</Col>
			))}
		</Row>
	</Section>

	<LandingFooter />
</Layout>

<style>
	html {
		scroll-behavior: smooth;
	}
</style>
