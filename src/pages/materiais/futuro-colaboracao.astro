---
// Webinar: Futuro da Colaboração
// ------------
import Layout from '@layouts/landing/WebinarLanding.astro'
import LandingHero from '@components/blocks/landing/LandingHero.astro'
import LandingForm from '@components/blocks/landing/LandingForm.astro'
import LandingFooter from '@components/blocks/landing/LandingFooter.astro'
import Row from '@components/ui/Row.astro'
import Col from '@components/ui/Col.astro'
import Section from '@components/ui/Section.astro'
import { Icon } from 'astro-icon/components'

const metadata = {
	title: "O Futuro da Colaboração Remota",
	description: "Assista a este webinar exclusivo com especialistas do mercado sobre as tendências de trabalho para os próximos anos."
}
---

<Layout {...metadata}>
	<LandingHero 
		tag="Webinar Online & Gratuito"
		title="O Futuro da <strong>Colaboração</strong> Remota"
		text={metadata.description}
		classes="bg-primary-500 text-white dark:bg-primary-900/20"
	>
		<div slot="image" class="w-full h-full flex items-center justify-center">
			<div class="relative group">
				<div class="absolute -inset-1 bg-white rounded-full blur opacity-25 group-hover:opacity-50 transition duration-1000 group-hover:duration-200"></div>
				<button class="relative bg-white text-primary-500 p-10 rounded-full shadow-2xl">
					<Icon name="bolt" class="w-16 h-16" />
				</button>
			</div>
		</div>
	</LandingHero>

	<Section classes="py-24 lg:py-40">
		<Row>
			<Col span="12" lg="8">
				<h2 class="text-3xl font-bold mb-8 text-neutral-900 dark:text-white">O que vamos discutir:</h2>
				<div class="prose prose-lg dark:prose-invert max-w-none">
					<p>Neste encontro digital, vamos explorar as transformações que estão moldando o mercado de trabalho global.</p>
					<ul>
						<li>Ferramentas essenciais para times distribuídos.</li>
						<li>Como manter a cultura da empresa à distância.</li>
						<li>Gestão de performance e KPIs em modelos híbridos.</li>
						<li>Saúde mental e equilíbrio entre vida pessoal e profissional.</li>
					</ul>
				</div>
			</Col>
			<Col span="12" lg="4">
				<LandingForm title="Reserve sua vaga gratuita" buttonText="Garantir meu lugar" classes="sticky top-24" />
			</Col>
		</Row>
	</Section>

	<LandingFooter />
</Layout>
