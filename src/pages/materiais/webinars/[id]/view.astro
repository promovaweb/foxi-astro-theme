---
// Webinar Single View Page (Template Dinâmico)
// ------------
import Layout from '@layouts/Layout.astro'
import Section from '@components/ui/Section.astro'
import Row from '@components/ui/Row.astro'
import Col from '@components/ui/Col.astro'
import Button from '@components/ui/Button.astro'
import VideoPlayer from '@components/ui/VideoPlayer.astro'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'

// Import de dados
import webinars from '@data/json-files/webinars.json'

export async function getStaticPaths() {
	return webinars.map((webinar) => ({
		params: { id: webinar.id },
		props: { webinar }
	}))
}

const { webinar } = Astro.props

const metadata = {
	title: `Assistir Webinar | ${webinar.title.replace(/<\/?[^>]+(>|$)/g, "")}`,
	description: webinar.description
}
---

<Layout {...metadata}>
	<!-- Header do Webinar -->
	<Section padding="top" classes="bg-neutral-50 dark:bg-neutral-900/50 pt-32 lg:pt-48 pb-12">
		<Row justify="center">
			<Col span="12" lg="10" align="center">
				<span class="text-primary-500 font-bold uppercase tracking-widest text-sm mb-6 block">{webinar.layout?.viewPage?.label || "Webinar Exclusivo"}</span>
				<h1 class="text-4xl lg:text-7xl font-black mb-12 text-neutral-900 dark:text-white leading-tight" set:html={webinar.title} />
				
				<!-- Player em Destaque -->
				<div class="max-w-5xl mx-auto">
					<VideoPlayer videoId={webinar.videoId} title={webinar.title} />
				</div>
			</Col>
		</Row>
	</Section>

	<!-- Conteúdo e Recursos -->
	<Section classes="py-24 lg:py-32">
		<Row>
			<Col span="12" lg="7" classes="mb-16 lg:mb-0 lg:pr-16">
				<h2 class="text-3xl font-bold mb-8 text-neutral-900 dark:text-white border-b border-neutral-100 dark:border-neutral-800 pb-4">{webinar.layout?.viewPage?.aboutTitle || "Sobre este Webinar"}</h2>
				<div class="prose prose-lg dark:prose-invert max-w-none text-neutral-600 dark:text-neutral-400">
					<p>{webinar.sections[0].text}</p>
					
					<h3 class="text-2xl font-bold text-neutral-900 dark:text-white mt-12 mb-6">{webinar.layout?.viewPage?.topicsTitle || "Tópicos principais:"}</h3>
					<ul class="space-y-4">
						{webinar.discussionPoints.slice(0, 3).map(point => (
							<li class="flex gap-3">
								<Icon name="check-circle" class="w-6 h-6 text-primary-500 shrink-0" />
								<span>{point}</span>
							</li>
						))}
					</ul>
				</div>
			</Col>

			<Col span="12" lg="5">
				<div class="sticky top-24 space-y-8">
					<!-- Card do Palestrante -->
					<div class="bg-neutral-50 dark:bg-neutral-900 p-8 rounded-3xl border border-neutral-100 dark:border-neutral-800 shadow-sm">
						<div class="flex items-center gap-4 mb-6">
							<div class="w-16 h-16 rounded-full overflow-hidden border-2 border-primary-500/20">
								<img src={webinar.organizers.host.image} alt={webinar.organizers.host.name} class="w-full h-full object-cover" />
							</div>
							<div>
								<h4 class="font-bold text-neutral-900 dark:text-white">{webinar.organizers.host.name}</h4>
								<p class="text-sm text-neutral-500">{webinar.organizers.host.role}</p>
							</div>
						</div>
						<p class="text-sm text-neutral-600 dark:text-neutral-400 mb-0">{webinar.organizers.host.bio}</p>
					</div>

					<!-- Recursos para Download -->
					{webinar.resources && (
						<div class="bg-primary-500 text-white p-8 rounded-3xl shadow-xl shadow-primary-500/20">
							<h3 class="text-xl font-bold mb-6 flex items-center gap-3">
								<Icon name="document-text" class="w-6 h-6" />
								{webinar.layout?.viewPage?.resourcesTitle || "Material de Apoio"}
							</h3>
							<ul class="space-y-4">
								{webinar.resources.map(resource => (
									<li>
										<a href={resource.link} class="flex items-center justify-between p-4 bg-white/10 hover:bg-white/20 rounded-xl transition-colors font-medium text-sm group">
											{resource.name}
											<Icon name="long-arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
										</a>
									</li>
								))}
							</ul>
						</div>
					)}

					<!-- CTA Contato -->
					<div class="p-8 rounded-3xl border border-dashed border-neutral-200 dark:border-neutral-700 text-center">
						<p class="text-sm text-neutral-500 mb-4 italic">{webinar.layout?.viewPage?.ctaText || ""}</p>
						<Button link={webinar.layout?.viewPage?.ctaLink || "/contact"} style="neutral" variation="outline" classes="w-full">
							{webinar.layout?.viewPage?.ctaButtonText || "Falar com um Consultor"}
						</Button>
					</div>
				</div>
			</Col>
		</Row>
	</Section>

</Layout>
