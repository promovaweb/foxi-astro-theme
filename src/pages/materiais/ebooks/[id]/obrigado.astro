---
// Página de Agradecimento: Ebook (Template Dinâmico)
// ------------
import Layout from '@layouts/landing/EbookLanding.astro'
import Section from '@components/ui/Section.astro'
import Row from '@components/ui/Row.astro'
import Col from '@components/ui/Col.astro'
import Button from '@components/ui/Button.astro'
import EbookCover from '@components/ui/EbookCover.astro'
import { Icon } from 'astro-icon/components'

// Import de dados
import ebooks from '@data/json-files/ebooks.json'

export async function getStaticPaths() {
	return ebooks.map((ebook) => ({
		params: { id: ebook.id },
		props: { ebook }
	}))
}

const { ebook } = Astro.props
const { thankYou } = ebook

const metadata = {
	title: `Obrigado | ${ebook.title.replace(/<\/?[^>]+(>|$)/g, "")}`,
	description: thankYou.text
}
---

<Layout {...metadata}>
	<Section padding="both" classes="bg-white dark:bg-neutral-950 pt-32 lg:pt-48">
		<Row>
			<Col span="12" lg="6" classes="mb-16 lg:mb-0 flex items-center justify-center">
				<EbookCover title={ebook.title} mainColor={ebook.color} classes="max-w-md" />
			</Col>
			<Col span="12" lg="6" classes="lg:pl-16 flex flex-col justify-center">
				<div class="mb-8 inline-flex items-center justify-center w-16 h-16 bg-primary-100 dark:bg-primary-900/30 text-primary-500 rounded-2xl">
					<Icon name="check-circle" class="w-8 h-8" />
				</div>
				<h1 class="text-4xl lg:text-6xl font-black mb-6 text-neutral-900 dark:text-white leading-tight" set:html={thankYou.title} />
				<p class="text-xl text-neutral-600 dark:text-neutral-400 mb-8 max-w-xl">
					{thankYou.text}
				</p>
				
				<div class="space-y-6 mb-12">
					<div class="flex items-start gap-4">
						<Icon name="bell" class="w-6 h-6 text-primary-500 mt-1" />
						<div>
							<h4 class="font-bold text-neutral-900 dark:text-white">{thankYou.tipTitle}</h4>
							<p class="text-neutral-500 text-sm">{thankYou.tipText}</p>
						</div>
					</div>
				</div>

				<div class="flex flex-wrap gap-4">
					<Button link="/blog" style="primary">
						Ler Artigos Relacionados
					</Button>
					<Button link="/" style="neutral" variation="outline">
						Voltar para Home
					</Button>
				</div>
			</Col>
		</Row>
	</Section>

	<!-- Seção de Comunidade -->
	<Section classes="bg-neutral-50 dark:bg-neutral-900/50 py-24 border-t border-neutral-100 dark:border-neutral-800">
		<Row justify="center">
			<Col span="12" lg="8" align="center">
				<h2 class="text-3xl font-bold mb-6 text-neutral-900 dark:text-white">{thankYou.communityTitle}</h2>
				<p class="text-lg text-neutral-600 dark:text-neutral-400 mb-10">{thankYou.communityText}</p>
				<Button link={thankYou.communityLink} style="neutral" size="lg">
					<Icon name="user-group" class="w-6 h-6 mr-2" />
					Entrar na Comunidade
				</Button>
			</Col>
		</Row>
	</Section>
</Layout>
