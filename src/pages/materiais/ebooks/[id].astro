---
// Ebook Landing Page (Template Dinâmico)
// ------------
import Layout from '@layouts/landing/EbookLanding.astro'
import EbookCover from '@components/ui/EbookCover.astro'
import LandingHero from '@components/blocks/landing/LandingHero.astro'
import LandingForm from '@components/blocks/landing/LandingForm.astro'
import LandingFooter from '@components/blocks/landing/LandingFooter.astro'
import SocialProof from '@components/blocks/socialproof/Basic.astro'
import Section from '@components/ui/Section.astro'
import Row from '@components/ui/Row.astro'
import Col from '@components/ui/Col.astro'
import { Icon } from 'astro-icon/components'

// Import de dados
import ebooks from '@data/json-files/ebooks.json'

export async function getStaticPaths() {
	return ebooks.map((ebook) => ({
		params: { id: ebook.id },
		props: { ebook }
	}))
}

const { ebook } = Astro.props

const metadata = {
	title: ebook.title.replace(/<\/?[^>]+(>|$)/g, ""),
	description: ebook.description
}
---

<Layout
	{...metadata}
	dataLayer={{
		pageType: 'material',
		pageTitle: ebook.title,
		pageDescription: ebook.description,
		materialType: 'ebook',
		category: ebook.tag
	}}
>
	<LandingHero 
		tag={ebook.tag}
		title={ebook.heroTitle}
		text={ebook.heroText}
	>
		<div slot="image" class="w-full max-w-lg mx-auto lg:ml-auto">
			<LandingForm 
				title={ebook.formTitle} 
				buttonText={ebook.formButtonText} 
				thankYouPage={`/materiais/ebooks/${ebook.id}/obrigado`}
				formUrl={ebook.formUrl}
				contrast={true} 
			/>
		</div>
	</LandingHero>

	<Section classes="bg-neutral-50 dark:bg-neutral-900/50 py-24 lg:py-40">
		<Row>
			<Col span="12" lg="5">
				<EbookCover title={ebook.title} mainColor={ebook.color} classes="max-w-sm" />
			</Col>
			<Col span="12" lg="7" classes="flex flex-col justify-center pt-12 lg:pt-0 lg:pl-16">
				<h2 class="text-3xl lg:text-4xl font-bold mb-6 text-neutral-900 dark:text-white" set:html={ebook.contentTitle} />
				<p class="text-lg text-neutral-600 dark:text-neutral-400 mb-8">
					{ebook.contentText}
				</p>
				
				<div class="grid sm:grid-cols-2 gap-x-8 gap-y-4">
					{ebook.benefits.map(benefit => (
						<div class="flex items-center gap-3">
							<Icon name="check-circle" class="w-5 h-5 text-primary-500 shrink-0" />
							<span class="text-neutral-700 dark:text-neutral-300 font-medium">{benefit}</span>
						</div>
					))}
				</div>

				<div class="mt-12 p-6 rounded-2xl bg-primary-500/10 border border-primary-500/20">
					<p class="text-primary-700 dark:text-primary-400 font-semibold italic">
						"{ebook.testimonial.text}"
					</p>
					<span class="block mt-2 text-sm font-bold text-neutral-900 dark:text-white">— {ebook.testimonial.author}</span>
				</div>
			</Col>
		</Row>
	</Section>

	<SocialProof classes="pt-24 lg:pt-32" />
	<LandingFooter />
</Layout>
