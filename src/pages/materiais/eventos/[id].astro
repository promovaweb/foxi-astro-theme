---
// Event Landing Page (Template Dinâmico)
// ------------
import Layout from '@layouts/landing/EventLanding.astro'
import LandingHero from '@components/blocks/landing/LandingHero.astro'
import LandingForm from '@components/blocks/landing/LandingForm.astro'
import LandingFooter from '@components/blocks/landing/LandingFooter.astro'
import Row from '@components/ui/Row.astro'
import Col from '@components/ui/Col.astro'
import Section from '@components/ui/Section.astro'
import { Icon } from 'astro-icon/components'

// Import de dados
import events from '@data/json-files/events.json'

export async function getStaticPaths() {
	return events.map((event) => ({
		params: { id: event.id },
		props: { event }
	}))
}

const { event } = Astro.props

const metadata = {
	title: event.title,
	description: event.description
}
---

<Layout {...metadata}>
	<LandingHero 
		tag={event.tag}
		title={event.heroTitle}
		text={event.description}
		classes="bg-neutral-900 text-white"
	>
		<div slot="image" class="w-full h-full flex flex-col items-center justify-center gap-6">
			<div class="bg-primary-500 p-8 rounded-3xl rotate-3 shadow-2xl">
				<Icon name={event.heroIcon} class="w-24 h-24 text-white" />
			</div>
			<span class="text-2xl font-bold tracking-widest text-primary-400">{event.heroHashtag}</span>
		</div>
	</LandingHero>

	<Section classes="bg-white dark:bg-neutral-950 py-24">
		<Row>
			<Col span="12" lg="8">
				<h2 class="text-3xl font-bold mb-8 text-neutral-900 dark:text-white" set:html={event.whyJoinTitle} />
				<div class="grid md:grid-cols-2 gap-8">
					{event.benefits.map((benefit: any) => (
						<div class="p-6 rounded-2xl border border-neutral-100 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900/50 group hover:border-primary-500 transition-colors">
							<Icon name={benefit.icon} class="w-8 h-8 text-primary-500 mb-4 group-hover:scale-110 transition-transform" />
							<h3 class="font-bold mb-2 text-neutral-900 dark:text-white">{benefit.title}</h3>
							<p class="text-sm text-neutral-600 dark:text-neutral-400">{benefit.text}</p>
						</div>
					))}
				</div>
			</Col>
			<Col span="12" lg="4">
				<LandingForm 
					title={event.formTitle} 
					buttonText={event.formButtonText} 
					thankYouPage={`/materiais/eventos/${event.id}/obrigado`}
					formUrl={event.formUrl}
					classes="sticky top-24" 
				/>
			</Col>
		</Row>
	</Section>

	{event.stats && (
		<Section classes="bg-neutral-50 dark:bg-neutral-900/50 py-16 border-t border-neutral-100 dark:border-neutral-800">
			<Row justify="center">
				<Col span="12" lg="10" align="center">
					<div class="flex flex-col md:flex-row items-center justify-center gap-12 md:gap-24">
						{event.stats.map((stat: any) => (
							<div class="text-center">
								<span class="block text-5xl font-black text-primary-500 mb-2">{stat.value}</span>
								<span class="text-neutral-600 dark:text-neutral-400 font-medium">{stat.label}</span>
							</div>
						))}
					</div>
				</Col>
			</Row>
		</Section>
	)}

	<LandingFooter />
</Layout>
