---
// Ebook: Guia de Produtividade
// ------------
import Layout from '@layouts/landing/EbookLanding.astro'
import LandingHero from '@components/blocks/landing/LandingHero.astro'
import LandingForm from '@components/blocks/landing/LandingForm.astro'
import LandingFooter from '@components/blocks/landing/LandingFooter.astro'
import Row from '@components/ui/Row.astro'
import Col from '@components/ui/Col.astro'
import Section from '@components/ui/Section.astro'
import materials from '@data/json-files/materialsData.json'

const material = materials.find(m => m.id === "guia-produtividade")!

const metadata = {
	title: material.title,
	description: material.description
}
---

<Layout {...metadata}>
	<LandingHero 
		tag="Ebook Gratuito"
		title="Extraia o máximo da sua <strong>equipe</strong>"
		text={metadata.description}
		image={material.image}
	>
		<div slot="after-text" class="mt-8 lg:hidden">
			<LandingForm title="Receba o ebook" buttonText="Baixar agora" />
		</div>
	</LandingHero>

	<Section classes="bg-neutral-50 dark:bg-neutral-900/50">
		<Row>
			<Col span="12" lg="7">
				<h2 class="text-3xl font-bold mb-8">O que você vai encontrar neste guia:</h2>
				<ul class="grid gap-6">
					<li class="flex gap-4">
						<div class="w-6 h-6 bg-primary-500 rounded-full flex-shrink-0" />
						<div>
							<strong class="block text-lg">Metodologias Ágeis</strong>
							<p class="text-neutral-600 dark:text-neutral-400">Como aplicar Scrum e Kanban no seu dia a dia.</p>
						</div>
					</li>
					<li class="flex gap-4">
						<div class="w-6 h-6 bg-primary-500 rounded-full flex-shrink-0" />
						<div>
							<strong class="block text-lg">Gestão de Tempo</strong>
							<p class="text-neutral-600 dark:text-neutral-400">Técnicas de Pomodoro e blocos de tempo para foco total.</p>
						</div>
					</li>
					<li class="flex gap-4">
						<div class="w-6 h-6 bg-primary-500 rounded-full flex-shrink-0" />
						<div>
							<strong class="block text-lg">Automação de Processos</strong>
							<p class="text-neutral-600 dark:text-neutral-400">Como eliminar tarefas repetitivas usando IA.</p>
						</div>
					</li>
				</ul>
			</Col>
			<Col span="12" lg="5" classes="hidden lg:block">
				<LandingForm title="Receba por e-mail" buttonText="Baixar Ebook Agora" classes="-mt-32 relative z-10" />
			</Col>
		</Row>
	</Section>

	<LandingFooter />
</Layout>
