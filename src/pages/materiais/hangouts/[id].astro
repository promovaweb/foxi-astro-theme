---
// Hangout/Live Landing Page (Template Dinâmico)
// ------------
import Layout from '@layouts/landing/WebinarLanding.astro'
import LandingHero from '@components/blocks/landing/LandingHero.astro'
import LandingForm from '@components/blocks/landing/LandingForm.astro'
import LandingFooter from '@components/blocks/landing/LandingFooter.astro'
import DownloadDetails from '@components/blocks/landing/DownloadDetails.astro'
import ContentList from '@components/blocks/landing/ContentList.astro'
import SocialIcon from '@components/ui/SocialIcon.astro'
import Row from '@components/ui/Row.astro'
import Col from '@components/ui/Col.astro'
import Section from '@components/ui/Section.astro'
import { Icon } from 'astro-icon/components'

import { Image } from 'astro:assets'

// Import de dados
import hangouts from '@data/json-files/hangouts.json'

export async function getStaticPaths() {
	return hangouts.map((hangout) => ({
		params: { id: hangout.id },
		props: { hangout }
	}))
}

const { hangout } = Astro.props

const metadata = {
	title: hangout.title.replace(/<\/?[^>]+(>|$)/g, ""),
	description: hangout.description
}

const organizers = hangout.organizers
---

<Layout {...metadata}>
	<LandingHero 
		tag={hangout.tag}
		title={hangout.title}
		text={hangout.description}
	>
		<div slot="image" class="w-full max-w-lg mx-auto lg:ml-auto">
			<LandingForm 
				title={hangout.layout?.hero?.formTitle || "Garanta sua Vaga"} 
				buttonText={hangout.layout?.hero?.formButtonText || "Realizar Inscrição"} 
				thankYouPage={hangout.thankYouPage}
				formUrl={hangout.formUrl}
				contrast={true} 
			/>
		</div>

		<div slot="after-text">
			<div class="flex items-center gap-4 text-sm text-neutral-500 font-medium">
				<Icon name="check-circle" class="w-5 h-5 text-primary-500" />
				{hangout.layout?.hero?.accessNote || "O link será enviado por e-mail"}
			</div>
		</div>
	</LandingHero>

	<!-- Detalhes da Live (Data/Hora) -->
	{hangout.liveDetails && (
		<Section classes="bg-primary-500 py-12 lg:py-16 text-white relative overflow-hidden">
			<div class="absolute top-0 left-0 w-full h-full opacity-10 pointer-events-none">
				<div class="absolute top-[-50%] left-[-10%] w-[60%] h-[200%] bg-white rotate-12 blur-[100px]" />
			</div>
			<Row classes="relative z-10">
				<Col span="12" align="center">
					<div class="flex flex-col md:flex-row items-center justify-center gap-8 md:gap-16">
						<div class="flex items-center gap-6">
							<div class="flex flex-col items-center">
								<span class="text-5xl lg:text-7xl font-black leading-none">{hangout.liveDetails.day}</span>
								<span class="text-sm font-bold uppercase tracking-tighter opacity-80">{hangout.liveDetails.month}</span>
							</div>
							<div class="w-px h-16 bg-white/20 hidden md:block" />
							<div class="flex flex-col">
								<span class="text-2xl lg:text-3xl font-black">{hangout.liveDetails.time}</span>
								<span class="text-sm font-bold opacity-80">{hangout.liveDetails.timezone}</span>
							</div>
						</div>
						<div class="flex flex-wrap justify-center gap-4">
							{hangout.liveDetails.features.map((feature: string) => (
								<div class="flex items-center gap-2 px-4 py-2 bg-white/10 rounded-full border border-white/20 text-xs font-bold uppercase tracking-widest">
									<Icon name="check-circle" class="w-4 h-4" />
									{feature}
								</div>
							))}
						</div>
					</div>
				</Col>
			</Row>
		</Section>
	)}

	<!-- Seções de Conteúdo -->
	{hangout.sections.map((section: any, index: number) => (
		<Section classes={`py-24 lg:py-32 ${index % 2 !== 0 ? 'bg-neutral-50 dark:bg-neutral-900/50' : 'bg-white dark:bg-neutral-950'}`}>
			<Row>
				<Col span="12" lg="6" classes={`${index % 2 !== 0 ? 'lg:order-2 lg:pl-16' : 'lg:pr-16'} flex flex-col justify-center`}>
					<h2 class="text-3xl lg:text-5xl font-black text-neutral-900 dark:text-white mb-8" set:html={section.title} />
					<p class="text-lg text-neutral-600 dark:text-neutral-400 mb-8 leading-relaxed">
						{section.text}
					</p>
					{section.quote && (
						<p class="text-lg text-neutral-600 dark:text-neutral-400 mb-0 leading-relaxed italic">
							"{section.quote}"
						</p>
					)}
				</Col>
				<Col span="12" lg="6" classes={`${index % 2 !== 0 ? 'lg:order-1' : ''}`}>
					<div class="relative rounded-3xl overflow-hidden aspect-video shadow-2xl border border-neutral-100 dark:border-neutral-800">
						<Image 
							src={hangout.heroImage} 
							alt={section.title} 
							width={800} 
							height={450} 
							class="w-full h-full object-cover" 
						/>
						{index === 0 && (
							<div class="absolute inset-0 flex items-center justify-center">
								<div class="w-20 h-20 bg-primary-500 rounded-full flex items-center justify-center text-white shadow-2xl animate-pulse">
									<Icon name="bolt" class="w-10 h-10 ml-1" />
								</div>
							</div>
						)}
					</div>
				</Col>
			</Row>
		</Section>
	))}

	<!-- Detalhes Técnicos e Tópicos -->
	<Section classes="bg-neutral-50 dark:bg-neutral-900/50 py-24 lg:py-32 border-y border-neutral-100 dark:border-neutral-800">
		<Row>
			<Col span="12" lg="6" classes="mb-16 lg:mb-0 flex flex-col justify-center">
				<div class="mb-10">
					<h3 class="text-2xl font-bold text-neutral-900 dark:text-white mb-4">{hangout.layout?.infoSection?.title || "Detalhes do Hangout"}</h3>
					<p class="text-neutral-600 dark:text-neutral-400">{hangout.layout?.infoSection?.subtitle || ""}</p>
				</div>
				<DownloadDetails {...hangout.details} />
			</Col>
			<Col span="12" lg="6" classes="lg:pl-16">
				<ContentList 
					title={hangout.layout?.infoSection?.discussionTitle || "O que vamos aprender:"} 
					items={hangout.discussionPoints} 
				/>
			</Col>
		</Row>
	</Section>

	<!-- Especialistas -->
	<Section classes="bg-white dark:bg-neutral-950 pt-24 lg:pt-40 pb-24 lg:pb-40">
		<Row>
			<Col span="12" align="center" classes="mb-24">
				<h2 class="text-3xl lg:text-5xl font-black text-neutral-900 dark:text-white mb-4" set:html={hangout.layout?.expertsSection?.title || "Convidados Especiais"} />
				<p class="text-lg text-neutral-600 dark:text-neutral-400 max-w-2xl mx-auto">{hangout.layout?.expertsSection?.subtitle || ""}</p>
			</Col>
			
			<Col span="12" lg="8" align="center" classes="lg:col-start-3 mb-24">
				<div class="mb-8 w-24 h-24 rounded-full overflow-hidden border-4 border-primary-500/20 mx-auto shadow-lg">
					<Image 
						src={organizers.host.image} 
						alt={organizers.host.name} 
						width={200} 
						height={200} 
						class="w-full h-full object-cover" 
					/>
				</div>
				<h3 class="text-2xl font-bold text-neutral-900 dark:text-white mb-2">{organizers.host.name}</h3>
				<p class="text-primary-500 font-bold mb-4 uppercase tracking-widest text-sm">{organizers.host.role}</p>
				<div class="flex justify-center gap-4 mb-6">
					{organizers.host.socials.map((social: any) => (
						<SocialIcon platform={social.platform} link={social.link} size={20} />
					))}
				</div>
				<p class="text-lg text-neutral-600 dark:text-neutral-400 max-w-2xl mx-auto leading-relaxed">
					{organizers.host.bio}
				</p>
			</Col>

			{organizers.speakers.map((speaker: any) => (
				<Col span="12" lg="6" align="center" classes="mb-12 lg:mb-0">
					<div class="mb-8 w-24 h-24 rounded-full overflow-hidden border-4 border-primary-500/20 mx-auto shadow-lg">
						<Image 
							src={speaker.image} 
							alt={speaker.name} 
							width={200} 
							height={200} 
							class="w-full h-full object-cover" 
						/>
					</div>
					<h3 class="text-2xl font-bold text-neutral-900 dark:text-white mb-2">{speaker.name}</h3>
					<p class="text-primary-500 font-bold mb-4 uppercase tracking-widest text-sm">{speaker.role}</p>
					<div class="flex justify-center gap-4 mb-6">
						{speaker.socials.map((social: any) => (
							<SocialIcon platform={social.platform} link={social.link} size={20} />
						))}
					</div>
					<p class="text-lg text-neutral-600 dark:text-neutral-400 max-w-sm mx-auto leading-relaxed">
						{speaker.bio}
					</p>
				</Col>
			))}
		</Row>
	</Section>

	<LandingFooter />
</Layout>
