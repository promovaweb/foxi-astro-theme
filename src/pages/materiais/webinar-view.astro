---
// Webinar Single View Page
// ------------
import Layout from '@layouts/Layout.astro'
import Section from '@components/ui/Section.astro'
import Row from '@components/ui/Row.astro'
import Col from '@components/ui/Col.astro'
import Button from '@components/ui/Button.astro'
import VideoPlayer from '@components/ui/VideoPlayer.astro'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'

const metadata = {
	title: "Assistir Webinar | Futuro da Colaboração Remota",
	description: "Assista ao conteúdo exclusivo sobre as tendências do mercado de trabalho remoto."
}

// Dados do Webinar (podem vir de um JSON futuramente)
const webinar = {
	id: "futuro-colaboracao",
	title: "O Futuro da <strong>Colaboração</strong> Remota",
	videoId: "dQw4w9WgXcQ", // ID do YouTube (exemplo)
	speaker: {
		name: "Ricardo Fonseca",
		role: "Diretor de Tecnologia na TechFlow",
		avatar: "/blog/post-01.png"
	},
	resources: [
		{ name: "Apresentação em PDF", link: "#" },
		{ name: "Checklist de Ferramentas", link: "#" },
		{ name: "Guia de Boas Práticas", link: "#" }
	]
}
---

<Layout {...metadata}>
	<!-- Header do Webinar -->
	<Section padding="top" classes="bg-neutral-50 dark:bg-neutral-900/50 pt-32 lg:pt-48 pb-12">
		<Row justify="center">
			<Col span="12" lg="10" align="center">
				<span class="text-primary-500 font-bold uppercase tracking-widest text-sm mb-6 block">Webinar Exclusivo</span>
				<h1 class="text-4xl lg:text-7xl font-black mb-12 text-neutral-900 dark:text-white leading-tight" set:html={webinar.title} />
				
				<!-- Player em Destaque -->
				<div class="max-w-5xl mx-auto">
					<VideoPlayer videoId={webinar.videoId} title={webinar.title} />
				</div>
			</Col>
		</Row>
	</Section>

	<!-- Conteúdo e Recursos -->
	<Section classes="py-24 lg:py-32">
		<Row>
			<Col span="12" lg="7" classes="mb-16 lg:mb-0 lg:pr-16">
				<h2 class="text-3xl font-bold mb-8 text-neutral-900 dark:text-white border-b border-neutral-100 dark:border-neutral-800 pb-4">Sobre este Webinar</h2>
				<div class="prose prose-lg dark:prose-invert max-w-none text-neutral-600 dark:text-neutral-400">
					<p>Neste encontro, Ricardo Fonseca mergulha nas estratégias e ferramentas que as empresas mais inovadoras do mundo estão utilizando para manter a cultura e a produtividade em alta, mesmo com times 100% distribuídos.</p>
					<p>Você aprenderá como estruturar fluxos de comunicação que eliminam a fadiga de reuniões e como criar rituais de equipe que fortalecem o senso de pertencimento.</p>
					
					<h3 class="text-2xl font-bold text-neutral-900 dark:text-white mt-12 mb-6">Tópicos principais:</h3>
					<ul class="space-y-4">
						<li class="flex gap-3">
							<Icon name="check-circle" class="w-6 h-6 text-primary-500 shrink-0" />
							<span>Framework de comunicação assíncrona.</span>
						</li>
						<li class="flex gap-3">
							<Icon name="check-circle" class="w-6 h-6 text-primary-500 shrink-0" />
							<span>Ferramentas de gestão de conhecimento.</span>
						</li>
						<li class="flex gap-3">
							<Icon name="check-circle" class="w-6 h-6 text-primary-500 shrink-0" />
							<span>Rituais de cultura para times remotos.</span>
						</li>
					</ul>
				</div>
			</Col>

			<Col span="12" lg="5">
				<div class="sticky top-24 space-y-8">
					<!-- Card do Palestrante -->
					<div class="bg-neutral-50 dark:bg-neutral-900 p-8 rounded-3xl border border-neutral-100 dark:border-neutral-800 shadow-sm">
						<div class="flex items-center gap-4 mb-6">
							<div class="w-16 h-16 rounded-full overflow-hidden border-2 border-primary-500/20">
								<Image src={webinar.speaker.avatar} alt={webinar.speaker.name} width={128} height={128} class="w-full h-full object-cover" />
							</div>
							<div>
								<h4 class="font-bold text-neutral-900 dark:text-white">{webinar.speaker.name}</h4>
								<p class="text-sm text-neutral-500">{webinar.speaker.role}</p>
							</div>
						</div>
						<p class="text-sm text-neutral-600 dark:text-neutral-400 mb-0">Especialista em liderança remota com foco em cultura e performance organizacional.</p>
					</div>

					<!-- Recursos para Download -->
					<div class="bg-primary-500 text-white p-8 rounded-3xl shadow-xl shadow-primary-500/20">
						<h3 class="text-xl font-bold mb-6 flex items-center gap-3">
							<Icon name="document-text" class="w-6 h-6" />
							Material de Apoio
						</h3>
						<ul class="space-y-4">
							{webinar.resources.map(resource => (
								<li>
									<a href={resource.link} class="flex items-center justify-between p-4 bg-white/10 hover:bg-white/20 rounded-xl transition-colors font-medium text-sm group">
										{resource.name}
										<Icon name="long-arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
									</a>
								</li>
							))}
						</ul>
					</div>

					<!-- CTA Contato -->
					<div class="p-8 rounded-3xl border border-dashed border-neutral-200 dark:border-neutral-700 text-center">
						<p class="text-sm text-neutral-500 mb-4 italic">Ficou com alguma dúvida sobre o conteúdo?</p>
						<Button link="/contact" style="neutral" variation="outline" classes="w-full">
							Falar com um Consultor
						</Button>
					</div>
				</div>
			</Col>
		</Row>
	</Section>

</Layout>
