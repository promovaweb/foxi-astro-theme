---
// Materiais Index Page
// ------------
import Layout from '@layouts/Layout.astro'
import Hero from '@components/blocks/hero/PageHeader.astro'
import Section from '@components/ui/Section.astro'
import Row from '@components/ui/Row.astro'
import Col from '@components/ui/Col.astro'
import Button from '@components/ui/Button.astro'
import { Icon } from 'astro-icon/components'
import materials from '@data/json-files/materialsData.json'

const SEO = {
	title: 'Materiais Gratuitos | Foxi Marketing',
	description: 'Explore nossa biblioteca de ebooks, webinars, templates e eventos exclusivos para impulsionar sua produtividade.'
}
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero 
		title="Central de <strong>Materiais</strong>" 
		text="Conteúdo exclusivo e gratuito para ajudar você e sua empresa a crescerem com inteligência e eficiência."
	/>

	<Section classes="bg-neutral-50 dark:bg-neutral-900/50">
		<Row>
			<Col span="12" classes="mb-12">
				<h2 class="text-3xl font-bold text-neutral-900 dark:text-white">Recursos em Destaque</h2>
			</Col>
		</Row>
		
		<!-- Bento Grid Layout -->
		<div class="grid grid-cols-1 md:grid-cols-12 gap-6 auto-rows-[minmax(200px,auto)]">
			
			<!-- Item 1: Principal (Ebook) - Grande -->
			<a href={materials[0].link} class="md:col-span-8 md:row-span-2 group relative overflow-hidden rounded-3xl bg-neutral-900 border border-neutral-100 dark:border-neutral-800 shadow-lg hover:shadow-2xl transition-all duration-500">
				<img src={materials[0].image} alt={materials[0].title} class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-105 transition-transform duration-700" />
				<div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-900/20 to-transparent" />
				<div class="relative h-full p-8 lg:p-12 flex flex-col justify-end">
					<span class={`${materials[0].color} text-white text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-widest w-fit mb-4`}>
						{materials[0].typeName}
					</span>
					<h3 class="text-3xl lg:text-5xl font-black text-white mb-4 max-w-2xl">{materials[0].title}</h3>
					<p class="text-neutral-300 text-lg max-w-xl group-hover:text-white transition-colors">{materials[0].description}</p>
				</div>
			</a>

			<!-- Item 2: Download - Médio -->
			<a href={materials[1].link} class="md:col-span-4 md:row-span-1 group relative overflow-hidden rounded-3xl bg-emerald-600 border border-neutral-100 dark:border-neutral-800 shadow-lg hover:shadow-2xl transition-all duration-500">
				<div class="absolute inset-0 bg-gradient-to-br from-emerald-400/20 to-transparent" />
				<div class="relative h-full p-8 flex flex-col justify-between">
					<div class="flex justify-between items-start">
						<span class="bg-white/20 text-white text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-widest">
							{materials[1].typeName}
						</span>
						<Icon name="document-text" class="w-8 h-8 text-white/50" />
					</div>
					<div>
						<h3 class="text-2xl font-bold text-white mb-2">{materials[1].title}</h3>
						<p class="text-emerald-100 text-sm line-clamp-2">{materials[1].description}</p>
					</div>
				</div>
			</a>

			<!-- Item 3: Webinar Gravado (Acesso Imediato) -->
			<a href={materials[2].link} class="md:col-span-4 md:row-span-1 group relative overflow-hidden rounded-3xl bg-white dark:bg-neutral-800 border border-neutral-100 dark:border-neutral-700 shadow-lg hover:shadow-2xl transition-all duration-500">
				<div class="p-8 h-full flex flex-col">
					<span class={`${materials[2].color} text-white text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-widest w-fit mb-6`}>
						{materials[2].typeName}
					</span>
					<h3 class="text-2xl font-bold text-neutral-900 dark:text-white mb-3 group-hover:text-primary-500 transition-colors">{materials[2].title}</h3>
					<p class="text-neutral-600 dark:text-neutral-400 text-sm mb-6 flex-1">{materials[2].description}</p>
					<div class="flex items-center gap-2 text-primary-500 font-bold text-sm">
						Assistir Imediatamente <Icon name="long-arrow-right" class="w-4 h-4" />
					</div>
				</div>
			</a>

			<!-- Item 4: Webinar Futuro (Ao Vivo) - Novo -->
			<a href={materials[4].link} class="md:col-span-6 group relative overflow-hidden rounded-3xl bg-neutral-900 border border-neutral-100 dark:border-neutral-800 shadow-lg hover:shadow-2xl transition-all duration-500">
				<div class="absolute inset-0 bg-red-600 opacity-10 group-hover:opacity-20 transition-opacity" />
				<div class="relative p-8 lg:p-10 flex flex-col h-full">
					<div class="flex justify-between items-center mb-6">
						<span class={`${materials[4].color} text-white text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-widest w-fit`}>
							{materials[4].typeName}
						</span>
						<div class="flex items-center gap-2 text-red-500 font-black text-[10px] uppercase tracking-tighter animate-pulse">
							<span class="w-2 h-2 rounded-full bg-red-500"></span>
							Inscrições Abertas
						</div>
					</div>
					<h3 class="text-3xl font-black text-white mb-4">{materials[4].title}</h3>
					<p class="text-neutral-400 text-sm group-hover:text-neutral-200 transition-colors mb-6 flex-1">{materials[4].description}</p>
					<div class="flex items-center gap-2 text-white font-bold text-sm">
						Garantir minha vaga <Icon name="long-arrow-right" class="w-4 h-4 text-primary-500" />
					</div>
				</div>
			</a>

			<!-- Item 5: Evento - Antes md:col-span-12, agora md:col-span-6 para balancear -->
			<a href={materials[3].link} class="md:col-span-6 group relative overflow-hidden rounded-3xl bg-neutral-900 border border-neutral-100 dark:border-neutral-800 shadow-lg hover:shadow-2xl transition-all duration-500">
				<img src={materials[3].image} alt={materials[3].title} class="absolute inset-0 w-full h-full object-cover opacity-40 group-hover:scale-110 transition-transform duration-700" />
				<div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-900/20 to-transparent md:block hidden" />
				<div class="relative p-8 lg:p-10 flex flex-col h-full justify-end">
					<span class={`${materials[3].color} text-white text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-widest w-fit mb-6`}>
						{materials[3].typeName}
					</span>
					<h3 class="text-3xl font-black text-white mb-2">{materials[3].title}</h3>
					<p class="text-neutral-400 text-sm group-hover:text-neutral-200 transition-colors">{materials[3].description}</p>
				</div>
			</a>

		</div>
	</Section>

	<Section padding="bottom">
		<Row>
			<Col span="12" align="center">
				<div class="bg-neutral-900 rounded-[3rem] p-12 lg:p-24 relative overflow-hidden text-center">
					<div class="absolute top-0 left-0 w-full h-full opacity-10 pointer-events-none">
						<div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-primary-500 rounded-full blur-[120px]" />
						<div class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-emerald-500 rounded-full blur-[120px]" />
					</div>
					
					<h2 class="text-3xl lg:text-5xl font-black mb-8 text-white relative z-10">Navegue por <strong>Categoria</strong></h2>
					<p class="text-neutral-400 text-lg mb-12 max-w-2xl mx-auto relative z-10">Escolha o formato que melhor se adapta ao seu momento de aprendizado.</p>
					
					<div class="flex flex-wrap justify-center gap-4 relative z-10">
						<Button link="/materiais/ebooks" style="primary" size="lg">Ebooks</Button>
						<Button link="/materiais/webinars" style="primary" variation="outline" size="lg">Webinars</Button>
						<Button link="/materiais/hangouts" style="primary" variation="outline" size="lg">Hangouts</Button>
						<Button link="/materiais/downloads" style="primary" variation="outline" size="lg">Downloads</Button>
						<Button link="/materiais/eventos" style="primary" variation="outline" size="lg">Eventos</Button>
					</div>
				</div>
			</Col>
		</Row>
	</Section>
</Layout>
