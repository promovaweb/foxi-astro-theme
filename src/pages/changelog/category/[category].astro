---
// Components
// - Layout
import Layout from '@layouts/Layout.astro'
import StickySidebar from '@components/blocks/basic/StickySidebar.astro'
// - UI
import Hero from '@components/blocks/hero/PageHeader.astro'
import Breadcrumbs from '@components/ui/Breadcrumbs.astro'
import Feed from '@components/ui/Feed.astro'
import CTA from '@components/blocks/CTA/BasicLight.astro'
import ChangelogSidebar from '@components/blocks/changelog/ChangelogSidebar.astro'
import ChangelogFilter from '@components/ui/ChangelogFilter.astro'

// Data
import { getCollection } from 'astro:content'

export async function getStaticPaths() {
	const changelogEntries = await getCollection('changelog')
	const categories = [...new Set(changelogEntries.map((entry) => entry.data.category))]

	return categories.map((category) => {
		const filteredEntries = changelogEntries
			.filter((entry) => entry.data.category === category)
			.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())

		return {
			params: { category },
			props: { entries: filteredEntries }
		}
	})
}

const { category } = Astro.params
const { entries } = Astro.props

// Content
// - SEO
const SEO = {
	title: `Foxi | Changelog: ${category}`,
	description: `Explore as atualizações da categoria ${category} do Foxi.`
}
// - Page Header
const header = {
	title: `Atualizações de <strong>${category}</strong>`,
	text: `Fique por dentro das melhorias em ${category} no Foxi.`
}
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={header.title} text={header.text}>
		<Breadcrumbs 
			slot="breadcrumbs" 
			classes="mb-8" 
			customSegments={[
				{ label: 'Changelog', link: '/changelog' },
				{ label: category, link: `/changelog/category/${category}` }
			]} 
		/>
	</Hero>
	
	<ChangelogFilter currentCategory={category} />

	<StickySidebar type="right" classes="bg-white dark:bg-neutral-950" padding="none">
		<div slot="sidebar" class="py-12 lg:pt-12 lg:pb-24">
			<ChangelogSidebar currentCategory={category} />
		</div>
		
		<div class="py-12 lg:pt-12 lg:pb-24 lg:pr-12">
			<Feed data={entries} />
		</div>
	</StickySidebar>

	<CTA />
</Layout>
