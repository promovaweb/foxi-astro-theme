---
// Components
// - Layout
import Layout from '@layouts/Layout.astro'
import StickySidebar from '@components/blocks/basic/StickySidebar.astro'
// - UI
import Hero from '@components/blocks/hero/PageHeader.astro'
import Breadcrumbs from '@components/ui/Breadcrumbs.astro'
import Feed from '@components/ui/Feed.astro'
import CTA from '@components/blocks/CTA/BasicLight.astro'
import Pagination from '@components/ui/Pagination.astro'
import ChangelogSidebar from '@components/blocks/changelog/ChangelogSidebar.astro'
import ChangelogFilter from '@components/ui/ChangelogFilter.astro'

// Data
import { getCollection } from 'astro:content'
import { configData } from '@config'
import type { Page } from 'astro'

export async function getStaticPaths({ paginate }: any) {
	const changelogEntries = await getCollection('changelog')

	// Sort entries by date descending
	const sortedEntries = changelogEntries.sort(
		(a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
	)

	return paginate(sortedEntries, { pageSize: configData.changelogPageSize })
}

type Props = {
	page: Page<any>
}

const { page } = Astro.props

// Content
// - SEO
const SEO = {
	title: `Foxi | Atualizações de Versão e Melhorias - Página ${page.currentPage}`,
	description:
		'Explore os poderosos recursos do Foxi projetados para aumentar a produtividade, garantir segurança de alto nível e integrar-se perfeitamente com suas ferramentas favoritas. Junte-se a milhares de usuários satisfeitos e transforme seu fluxo de trabalho com o Foxi hoje!'
}
// - Page Header
const header = {
	title: 'Atualizações de Versão e <strong>Melhorias</strong> do Foxi',
	text: 'Fique por dentro de todas as novas atualizações e melhorias no Foxi.'
}
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={header.title} text={header.text}>
		<Breadcrumbs 
			slot="breadcrumbs" 
			classes="mb-8" 
			customSegments={[{ label: 'Changelog', link: '/changelog' }]} 
		/>
	</Hero>
	
	<ChangelogFilter />

	<StickySidebar type="right" classes="bg-white dark:bg-neutral-950" padding="none">
		<div slot="sidebar" class="py-12 lg:pt-12 lg:pb-24">
			<ChangelogSidebar />
		</div>
		
		<div class="py-12 lg:pt-12 lg:pb-24 lg:pr-12">
			<Feed data={page.data} />
			<div class="mt-12">
				<Pagination page={page} />
			</div>
		</div>
	</StickySidebar>

	<CTA />
</Layout>
