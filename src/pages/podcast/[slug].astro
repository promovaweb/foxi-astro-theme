---
// Página do Episódio do Podcast
// Descrição: Exibe o conteúdo completo do episódio a partir da coleção de Markdown

import Layout from '@layouts/PodcastLayout.astro'
import { Icon } from 'astro-icon/components'
import { getCollection, render } from 'astro:content'

export async function getStaticPaths() {
  const episodes = await getCollection('podcast')
  return episodes.map((episode) => ({
    params: { slug: episode.id },
    props: { episode },
  }))
}

const { episode } = Astro.props
const { title, description, pubDate, youtubeId, cover } = episode.data
const { Content } = await render(episode)

const seoTitle = `${title} - Their Side`
const formattedDate = pubDate.toLocaleDateString('pt-BR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
})
---

<Layout title={seoTitle} description={description} ogImage={cover}>
  <article class="py-16 px-4 sm:px-6 lg:px-12 xl:px-16">
    <div class="w-full">
      <header class="md:flex md:items-center md:justify-between mb-10">
        <div class="min-w-0 flex-1">
          <time
            datetime={pubDate.toISOString()}
            class="block font-mono text-sm leading-7 text-neutral-500 dark:text-neutral-400"
          >
            {formattedDate}
          </time>
          <h1 class="mt-2 text-4xl font-bold text-neutral-900 dark:text-neutral-50 sm:text-5xl lg:text-6xl sm:tracking-tight font-headings">
            {title}
          </h1>
        </div>
        <div class="mt-4 flex md:mt-0 md:ml-4">
          <a
            href="/podcast"
            class="inline-flex items-center gap-2 rounded-md bg-neutral-200 dark:bg-white/10 px-3 py-2 text-sm font-semibold text-neutral-900 dark:text-white hover:bg-neutral-300 dark:hover:bg-white/20 transition shadow-sm"
          >
            <Icon name="chevron-left" class="size-4" />
            Voltar
          </a>
          <a
            href={`https://www.youtube.com/watch?v=${youtubeId}`}
            target="_blank"
            rel="noopener noreferrer"
            class="ml-3 inline-flex items-center gap-2 rounded-md bg-primary-500 px-3 py-2 text-sm font-semibold text-white hover:bg-primary-600 transition shadow-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500"
          >
            <Icon name="youtube-icon" class="size-5" />
            Ver no Youtube
          </a>
        </div>
      </header>

      <!-- YouTube Video em Destaque -->
      <div class="mt-8 aspect-video overflow-hidden rounded-xl bg-neutral-100 dark:bg-neutral-800 shadow-lg">
        <iframe
          class="h-full w-full"
          src={`https://www.youtube.com/embed/${youtubeId}`}
          title="YouTube video player"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      </div>

      <div class="mt-10 prose prose-neutral dark:prose-invert max-w-none w-full">
        <Content />
      </div>

      <div class="mt-12 pt-12 border-t border-neutral-200 dark:border-neutral-800">
        <a 
          href="/podcast" 
          class="text-sm font-bold text-neutral-900 dark:text-neutral-50 hover:text-primary-500 flex items-center gap-2 transition"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Voltar para a lista de episódios
        </a>
      </div>
    </div>
  </article>
</Layout>
