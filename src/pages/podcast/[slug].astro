---
// Página do Episódio do Podcast
// Descrição: Exibe o conteúdo completo do episódio a partir da coleção de Markdown

import Layout from '@layouts/PodcastLayout.astro'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import { getCollection, render } from 'astro:content'
import TinyWaveFormIcon from '@components/ui/podcast/TinyWaveFormIcon.astro'
import NewsletterWidget from '@components/ui/podcast/NewsletterWidget.astro'
import RelatedEpisodes from '@components/ui/podcast/RelatedEpisodes.astro'

export async function getStaticPaths() {
  const episodes = await getCollection('podcast')
  return episodes.map((episode) => ({
    params: { slug: episode.id },
    props: { episode },
  }))
}

const { episode } = Astro.props
const { title, description, pubDate, youtubeId, cover } = episode.data
const { Content } = await render(episode)

// Buscar outros episódios para a seção de recomendação de forma aleatória
const allEpisodes = await getCollection('podcast')
const randomEpisodes = (allEpisodes || [])
  .filter((ep) => ep.id !== episode.id)
  .sort(() => Math.random() - 0.5)
  .slice(0, 4)

const seoTitle = `${title} - Their Side`
const formattedDate = pubDate.toLocaleDateString('pt-BR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
})
---

<Layout title={seoTitle} description={description} ogImage={cover}>
  <article class="py-8 lg:py-12 px-4 sm:px-6 lg:px-12 xl:px-16">
    <div class="max-w-6xl mx-auto">
      <!-- Hero Section -->
      <header class="flex flex-col md:flex-row gap-8 lg:gap-12 items-center md:items-start mb-10 lg:mb-12">
        <div class="flex-none w-64 h-64 sm:w-72 sm:h-72 lg:w-80 lg:h-80 relative group">
          <div class="absolute inset-0 bg-primary-500/10 rounded-2xl transform rotate-3 transition-transform group-hover:rotate-6 duration-300"></div>
          <div class="relative overflow-hidden rounded-2xl bg-neutral-200 dark:bg-neutral-800 shadow-2xl transition-transform group-hover:-translate-y-2 duration-300">
            <Image
              class="w-full h-full object-cover aspect-square"
              src={cover}
              alt={`Capa do episódio: ${title}`}
              width={1024}
              height={1024}
              loading="eager"
            />
            <div class="absolute inset-0 ring-1 ring-inset ring-black/10 rounded-2xl"></div>
          </div>
        </div>

        <div class="flex-1 flex flex-col items-center md:items-start text-center md:text-left pt-1">
          <time
            datetime={pubDate.toISOString()}
            class="inline-flex items-center gap-2 font-mono text-[10px] font-bold tracking-[0.2em] text-primary-600 dark:text-primary-400 uppercase"
          >
            <span class="w-6 h-px bg-primary-500/50 hidden md:block"></span>
            {formattedDate}
          </time>
          
          <h1 class="mt-1 text-2xl font-extrabold text-neutral-900 dark:text-neutral-50 sm:text-3xl lg:text-4xl tracking-tight font-headings leading-[1.1]">
            {title}
          </h1>
          
          <p class="mt-3 text-base lg:text-lg leading-relaxed text-neutral-700 dark:text-neutral-300 font-medium max-w-2xl">
            {description}
          </p>

          <div class="mt-5 flex flex-wrap items-center justify-center md:justify-start gap-3">
            <a
              href={`https://www.youtube.com/watch?v=${youtubeId}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-full bg-primary-500 px-5 py-2 text-sm font-bold text-white hover:bg-primary-600 transition shadow-lg shadow-primary-500/25"
            >
              <Icon name="youtube-icon" class="size-4" />
              Ver no Youtube
            </a>
            <a
              href="/podcast"
              class="inline-flex items-center gap-2 rounded-full bg-neutral-200 dark:bg-white/10 px-5 py-2 text-sm font-bold text-neutral-900 dark:text-white hover:bg-neutral-300 dark:hover:bg-white/20 transition"
            >
              <Icon name="chevron-left" class="size-4" />
              Voltar
            </a>
          </div>
        </div>
      </header>

      <!-- Player Section -->
      <section class="relative mt-12 lg:mt-16 mb-10">
        <div class="flex items-center gap-4 mb-6">
          <div class="flex-none flex items-center gap-2.5 text-primary-600 dark:text-primary-400 bg-primary-500/5 dark:bg-primary-500/10 px-3 py-1.5 rounded-full ring-1 ring-inset ring-primary-500/20">
            <Icon name="youtube-icon" class="size-4 animate-pulse" />
            <span class="text-[11px] font-black uppercase tracking-[0.1em]">Assista agora</span>
          </div>
          <div class="h-px flex-1 bg-gradient-to-r from-neutral-200 via-neutral-200 to-transparent dark:from-neutral-800 dark:via-neutral-800"></div>
          <div class="hidden xs:block opacity-40">
            <TinyWaveFormIcon colors={['fill-neutral-400', 'fill-neutral-500']} className="h-3 w-10" />
          </div>
        </div>

        <div class="relative group">

        <div class="relative group">
          <!-- Efeito de brilho ao fundo -->
          <div class="absolute -inset-1 bg-gradient-to-r from-primary-500 to-primary-600 rounded-2xl blur opacity-10 group-hover:opacity-20 transition duration-1000 group-hover:duration-200"></div>
          
          <!-- YouTube Video -->
          <div class="relative aspect-video overflow-hidden rounded-2xl bg-black shadow-2xl ring-1 ring-black/5 dark:ring-white/5">
            <iframe
              class="h-full w-full"
              src={`https://www.youtube.com/embed/${youtubeId}`}
              title="YouTube video player"
              style="border: 0;"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>
          </div>
        </div>
      </section>

      <div class="mt-12 prose prose-neutral dark:prose-invert max-w-none w-full prose-headings:font-headings prose-headings:font-bold prose-a:text-primary-500 hover:prose-a:text-primary-600 prose-img:rounded-xl">
        <Content />
      </div>

      <NewsletterWidget />

      <!-- Latest Episodes Section -->
      <RelatedEpisodes episodes={randomEpisodes} />

      <footer class="mt-16 pt-12 border-t border-neutral-200 dark:border-neutral-800">
        <a 
          href="/podcast" 
          class="inline-flex items-center gap-2 text-sm font-bold text-neutral-600 dark:text-neutral-400 hover:text-primary-500 transition group"
        >
          <Icon name="chevron-left" class="size-4 transition-transform group-hover:-translate-x-1" />
          Ver todos os episódios
        </a>
      </footer>
    </div>
  </article>
</Layout>
