---
// Components
// - Layout
import Layout from '@layouts/Layout.astro'
// - UI
import FormHero from '@components/blocks/hero/ContactHero.astro'
import CTA from '@components/blocks/CTA/BasicDark.astro'
import ContactCards from '@components/blocks/contact/ContactCards.astro'
import SocialProof from '@components/blocks/socialproof/Basic.astro'

// Content
// - SEO
const SEO = {
	title: 'Foxi | Entre em Contato Conosco',
	description:
		'Tem dúvidas ou precisa de assistência? Entre em contato com o Foxi hoje para suporte, consultas ou feedback. Nossa equipe está aqui para ajudar você a aproveitar ao máximo sua experiência com o Foxi.'
}
// - Page Header
const header = {
	title: 'Obtenha Respostas para Suas Perguntas sobre o <strong>Foxi</strong>.',
	text: "Se você tem uma pergunta, precisa de suporte ou apenas quer compartilhar seu feedback, estamos à disposição. Entre em contato conosco e retornaremos o mais rápido possível."
}
---

<Layout title={SEO.title} description={SEO.description}>
	<FormHero
		title={header.title}
		text={header.text}
		id="contact"
		classes="bg-neutral-50 dark:bg-neutral-950/80"
	/>
	<ContactCards classes="dark:bg-neutral-950/80" />
	<SocialProof classes="dark:bg-neutral-950/80" />
	<CTA />
</Layout>
