---
import Layout from '@layouts/Layout.astro'
import PageHeader from '@components/blocks/hero/PageHeader.astro'
import FAQBasic from '@components/blocks/FAQ/Basic.astro'
import FAQSticky from '@components/blocks/FAQ/FaqSticky.astro'
import Section from '@components/ui/Section.astro'
import Row from '@components/ui/Row.astro'
import Col from '@components/ui/Col.astro'

// Content
import faqData from '@data/json-files/faqData.json'
const faqIntegrations = faqData.filter((faq) => faq.category === 'integrations')

const SEO = {
	title: 'Componentes de FAQ | Foxi Astro Theme',
	description: 'Exemplos de blocos de Perguntas Frequentes (FAQ) disponíveis no Foxi Astro Theme.'
}

const header = {
	title: 'Componentes de <strong>FAQ</strong>',
	text: 'Responda às dúvidas dos seus clientes de forma clara e organizada.'
}
---

<Layout title={SEO.title} description={SEO.description}>
	<PageHeader title={header.title} text={header.text} />
	
	<Section>
		<Row>
			<Col span="12" align="center">
				<h2 class="mb-12">FAQ Sticky</h2>
			</Col>
		</Row>
	</Section>
	<FAQSticky 
		title="Integrações Facilitadas"
		text="Descubra como o Foxi se integra perfeitamente com suas ferramentas favoritas."
		data={faqIntegrations}
	/>

	<Section classes="bg-neutral-50 dark:bg-neutral-900">
		<Row>
			<Col span="12" align="center">
				<h2 class="mb-12">FAQ Básico</h2>
			</Col>
		</Row>
	</Section>
	<FAQBasic />
</Layout>
