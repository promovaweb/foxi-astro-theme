---
// Página de Comparação
// ------------
// Descrição: Comparação detalhada de recursos e planos de preços.

import Layout from '@layouts/Layout.astro'
import PageHeader from '@components/blocks/hero/PageHeader.astro'
import PricingComparison from '@components/blocks/pricing/PricingComparison.astro'
import PricingThreeColumns from '@components/blocks/pricing/PricingThreeColumns.astro'
import Section from '@components/ui/Section.astro'
import Row from '@components/ui/Row.astro'
import Col from '@components/ui/Col.astro'
import CTA from '@components/ui/CTA.astro'
import Button from '@components/ui/Button.astro'

const title = "Compare os Planos Foxi Pro"
const description = "Encontre o plano perfeito para sua equipe. Compare recursos, limites e preços de forma transparente."
---

<Layout 
	title={title} 
	description={description}
	dataLayer={{
		pageType: 'page',
		pageTitle: title,
		pageDescription: description,
		category: 'Preços'
	}}
>
	<PageHeader 
		title="Escolha o plano ideal para <strong>seu crescimento</strong>"
		text="Transparência total em recursos e preços. Escolha a opção que melhor se adapta ao momento da sua empresa."
	/>

	<PricingThreeColumns classes="bg-white dark:bg-neutral-950" />

	<Section id="detailed-comparison" classes="bg-neutral-50 dark:bg-neutral-900 border-t border-neutral-100 dark:border-neutral-800">
		<Row>
			<Col span="12" align="center" classes="mb-12">
				<h2 class="text-pretty">Comparação <strong>Detalhada</strong></h2>
				<p class="text-lg">Analise cada funcionalidade lado a lado para tomar a melhor decisão.</p>
			</Col>
		</Row>
		<PricingComparison />
	</Section>

	<Section id="guarantee" classes="bg-white dark:bg-neutral-950">
		<Row>
			<Col span="4" align="center">
				<div class="p-8 rounded-3xl bg-primary-500/5 border border-primary-500/10">
					<div class="w-12 h-12 bg-primary-500 rounded-full flex items-center justify-center text-white mb-6 mx-auto">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04kM12 21.48V22" /></svg>
					</div>
					<h3 class="text-xl font-bold mb-3">Garantia de 30 dias</h3>
					<p class="text-neutral-600 dark:text-neutral-400">Teste sem riscos. Se não estiver satisfeito, devolvemos seu dinheiro.</p>
				</div>
			</Col>
			<Col span="4" align="center">
				<div class="p-8 rounded-3xl bg-primary-500/5 border border-primary-500/10">
					<div class="w-12 h-12 bg-primary-500 rounded-full flex items-center justify-center text-white mb-6 mx-auto">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
					</div>
					<h3 class="text-xl font-bold mb-3">Migração Gratuita</h3>
					<p class="text-neutral-600 dark:text-neutral-400">Nossa equipe ajuda você a importar todos os seus dados sem custo.</p>
				</div>
			</Col>
			<Col span="4" align="center">
				<div class="p-8 rounded-3xl bg-primary-500/5 border border-primary-500/10">
					<div class="w-12 h-12 bg-primary-500 rounded-full flex items-center justify-center text-white mb-6 mx-auto">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
					</div>
					<h3 class="text-xl font-bold mb-3">Segurança Nível Enterprise</h3>
					<p class="text-neutral-600 dark:text-neutral-400">Criptografia de ponta a ponta e conformidade com LGPD/GDPR.</p>
				</div>
			</Col>
		</Row>
	</Section>

	<Section id="sales-cta">
		<Row>
			<Col span="12">
				<CTA 
					title="Dúvidas sobre o <strong>plano ideal?</strong>"
					text="Fale com um de nossos especialistas agora mesmo e receba uma proposta personalizada."
				>
					<Button size="lg" link="/contact" style="primary">Falar com Consultor</Button>
				</CTA>
			</Col>
		</Row>
	</Section>
</Layout>
