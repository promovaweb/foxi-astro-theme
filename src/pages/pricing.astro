---
// Components
// - Layout
import Layout from '@layouts/Layout.astro'
// - UI
import Hero from '@components/blocks/hero/PageHeader.astro'
import Price from '@components/blocks/pricing/PricingColumns.astro'
import SocialProof from '@components/blocks/socialproof/Basic.astro'
import FAQ from '@components/blocks/FAQ/Basic.astro'
import Testimonial from '@components/blocks/testimonials/BasicDark.astro'
import Feature from '@components/blocks/features/FeatureList.astro'
import CTA from '@components/blocks/CTA/BasicDark.astro'

// Content
// - SEO
const SEO = {
	title: 'Foxi | Preços simplificados',
	description:
		'Descubra o plano de preços SaaS perfeito para o seu negócio. De startups a grandes empresas, nossas soluções escaláveis oferecem recursos incomparáveis e suporte 24/7.'
}
// - Page Header
const header = {
	title: 'Escolha o plano que melhor se adapta às <strong>suas</strong> necessidades',
	text: 'Todos os planos vêm com garantia de reembolso de 30 dias.'
}
// - Testimonial data
import testimonialBackground from '@/assets/testimonial-bg-02.webp'
const testimonialData = {
	blockquote:
		"O Foxi não é apenas um aplicativo — é como ter um parceiro travesso, porém brilhante, para o seu negócio. Ele simplifica as tarefas e também faz piadas para manter o ânimo elevado",
	figcaption: 'Max Widgetson',
	cite: ' CEO, Widgetify Ltd'
}
---

<Layout 
	title={SEO.title} 
	description={SEO.description}
	dataLayer={{
		pageType: 'page',
		pageTitle: SEO.title,
		pageDescription: SEO.description,
		category: 'Preços'
	}}
>
	<Hero title={header.title} text={header.text} />
	<Price />
	<SocialProof />
	<Feature />
	<Testimonial
		bg={testimonialBackground}
		bgPosition="left"
		blockquote={testimonialData.blockquote}
		figcaption={testimonialData.figcaption}
		cite={testimonialData.cite}
	/>
	<FAQ classes="bg-slate-50 dark:bg-neutral-900/40" />
	<CTA />
</Layout>
