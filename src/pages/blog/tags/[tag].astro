---
// Blog Tag Page
// ------------
// Descrição: A página de tag do blog.

// Components
// - Layout
import Layout from '@layouts/Layout.astro'
// - UI
import Hero from '@components/blocks/hero/PageHeader.astro'
import BlogPosts from '@components/blocks/blog/BlogPosts.astro'

// Data
import { getCollection } from 'astro:content'
export async function getStaticPaths() {
	const allPosts = await getCollection('blog')
	const uniqueTags = [...new Set(allPosts.map((post) => post.data.tags).flat())].filter(tag => tag !== undefined) as string[]

	return uniqueTags.map((tag) => {
		const filteredPosts = allPosts.filter((post) => post.data.tags?.includes(tag))
		return {
			params: { tag },
			props: { posts: filteredPosts }
		}
	})
}
const { tag } = Astro.params
const { posts } = Astro.props

// Content
// - SEO
const SEO = {
	title: `Foxi | posts marcados com ` + tag,
	description:
		'Explore as últimas notícias da Foxi projetadas para aumentar a produtividade, garantir segurança de alto nível e integrar-se perfeitamente às suas ferramentas favoritas. Junte-se a milhares de usuários satisfeitos e transforme seu fluxo de trabalho com a Foxi hoje mesmo!'
}

// - Page Header
const header = {
	title: `Posts da Foxi sobre <br><strong>` + tag + `</strong>`,
	text: `Mantenha-se informado, mantenha-se produtivo com todas as novidades da Foxi.`
}
---

<Layout 
	title={SEO.title} 
	description={SEO.description} 
	noindex={true}
	dataLayer={{
		pageType: 'blog',
		pageTitle: SEO.title,
		pageDescription: SEO.description,
		category: tag
	}}
>
	<Hero title={header.title} text={header.text} />
	<BlogPosts data={posts} />
</Layout>
