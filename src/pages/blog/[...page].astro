---
// Blog Index Page with Pagination
// ------------
// Descrição: A página de índice do blog com suporte a paginação.

// Components
// - Layout
import Layout from '@layouts/Layout.astro'
// - UI
import Hero from '@components/blocks/hero/PageHeader.astro'
import BlogPosts from '@components/blocks/blog/BlogPosts.astro'
import PodcastBento from '@components/blocks/podcast/PodcastBento.astro'

// Data
import { getCollection } from 'astro:content'
import { configData } from '@config'

export async function getStaticPaths({ paginate }: any) {
	const allPosts = await getCollection('blog')
	
	// Sort posts by date before paginating
	const sortedPosts = allPosts.sort((a, b) => {
		return new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
	})

	return paginate(sortedPosts, { pageSize: configData.blogPageSize || 6 })
}

const { page } = Astro.props

// Content
// - SEO
const SEO = {
	title: 'Foxi | Últimas Notícias e atualizações da Foxi',
	description:
		'Explore as últimas notícias da Foxi projetadas para aumentar a produtividade, garantir segurança de alto nível e integrar-se perfeitamente às suas ferramentas favoritas. Junte-se a milhares de usuários satisfeitos e transforme seu fluxo de trabalho com a Foxi hoje mesmo!'
}
// - Page Header
const header = {
	title: 'O Blog <strong>Foxi</strong>. Dicas, Atualizações e Histórias',
	text: 'Mantenha-se informado, mantenha-se produtivo. Todas as novidades do mundo Foxi.'
}
---

<Layout
	title={SEO.title}
	description={SEO.description}
	dataLayer={{ pageType: 'blog', pageTitle: SEO.title, pageDescription: SEO.description }}
>
	<Hero title={header.title} text={header.text} />
	<BlogPosts page={page} />
	{page.currentPage === 1 && <PodcastBento />}
</Layout>
