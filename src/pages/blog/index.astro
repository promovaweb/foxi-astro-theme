---
// Blog Index Page
// ------------
// Descrição: A página de índice do blog.

// Components
// - Layout
import Layout from '@layouts/Layout.astro'
// - UI
import Hero from '@components/blocks/hero/PageHeader.astro'
import BlogPosts from '@components/blocks/blog/BlogPosts.astro'

// Data
import { getCollection } from 'astro:content'

// Content
// - SEO
const SEO = {
	title: 'Foxi | Últimas Notícias e atualizações da Foxi',
	description:
		'Explore as últimas notícias da Foxi projetadas para aumentar a produtividade, garantir segurança de alto nível e integrar-se perfeitamente às suas ferramentas favoritas. Junte-se a milhares de usuários satisfeitos e transforme seu fluxo de trabalho com a Foxi hoje mesmo!'
}
// - Page Header
const header = {
	title: 'O Blog <strong>Foxi</strong>. Dicas, Atualizações e Histórias',
	text: 'Mantenha-se informado, mantenha-se produtivo. Todas as novidades do mundo Foxi.'
}

const allPosts = await getCollection('blog')
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={header.title} text={header.text} />
	<BlogPosts data={allPosts} />
</Layout>
