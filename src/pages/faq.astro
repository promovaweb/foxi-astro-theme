---
// Components
// - Layout
import Layout from '@layouts/Layout.astro'
// - UI
import Hero from '@components/blocks/hero/PageHeader.astro'
import FAQ from '@components/blocks/FAQ/FaqSticky.astro'
import TextImage from '@components/blocks/basic/TextImage.astro'
import CTA from '@components/blocks/CTA/BasicDark.astro'

// Data
import faqData from '@data/json-files/faqData.json'
// - FAQ Categories
const faqPricing = faqData.filter((faq) => faq.category === 'pricing')
const faqIntegrations = faqData.filter((faq) => faq.category === 'integrations')

// Content
import faqImage1 from '@/assets/faq/faq-01.png'
// - SEO
const SEO = {
	title: 'Foxi | Tire Suas Dúvidas com um Sorriso',
	description:
		'Mergulhe na Central de Perguntas Frequentes do Foxi para obter respostas a todas as suas dúvidas sobre preços, integrações, recursos e muito mais. Descubra como o Foxi pode tornar sua vida profissional mais produtiva e agradável.'
}
// - Page Header
const header = {
	title: 'Obtenha Respostas para Suas Perguntas sobre o <strong>Foxi</strong>.',
	text: 'Encontre respostas para as perguntas mais comuns sobre o Foxi'
}
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={header.title} text={header.text} />
	<FAQ
		title="Entendendo Nossos Planos de Preços"
		text="Obtenha todos os detalhes sobre os planos de preços do Foxi. Saiba mais sobre custos, descontos e opções de assinatura para encontrar o melhor plano que se adapta às suas necessidades e orçamento."
		data={faqPricing}
	/>
	<TextImage
		title="Por que os Planos de Preços do Foxi Oferecem Grande Valor"
		text="No Foxi, acreditamos em fornecer um valor excepcional em todos os níveis de preço. Nossos planos de preços são projetados para atender a uma variedade de necessidades, de indivíduos e pequenas equipes a grandes empresas. Cada plano inclui acesso aos nossos recursos poderosos, integrações perfeitas e suporte ao cliente de primeira classe. "
		image={faqImage1}
		mobileImage={faqImage1}
		imagePosition="left"
		offsetImage
		classes="bg-neutral-50 dark:bg-neutral-900 lg:!py-64"
	/>
	<FAQ
		title="Integrações Facilitadas"
		text="Descubra como o Foxi se integra perfeitamente com suas ferramentas e plataformas favoritas. Do Google Calendar ao Slack, saiba como se conectar e aumentar sua produtividade com integrações poderosas."
		data={faqIntegrations}
	/>
	<CTA />
</Layout>
