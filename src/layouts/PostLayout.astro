---
// Imports
const { frontmatter } = Astro.props

//Layout Components
import Layout from '@layouts/Layout.astro'

// Section Components
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import Section from '@components/ui/Section.astro'
import Row from '@components/ui/Row.astro'
import Col from '@components/ui/Col.astro'
import BlogPostHero from '@components/blocks/blog/BlogPostHero.astro'
import AuthorWidget from '@components/ui/blog/AuthorWidget.astro'
import BlogCard from '@components/ui/cards/BlogCard.astro'
import StickySidebar from '@components/blocks/basic/StickySidebar.astro'

// Data
import { getCollection } from 'astro:content'

// Fetch data for the sidebar and footer
const allPosts = await getCollection('blog')
const sortedPosts = (allPosts || []).sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())

// Related posts (3 random excluding current)
const relatedPosts = (allPosts || [])
	.filter((post) => post.data.title !== frontmatter.title)
	.sort(() => Math.random() - 0.5)
	.slice(0, 3)

// Recent posts for sidebar (3 excluding current)
const recentPosts = (sortedPosts || [])
	.filter((post) => post.data.title !== frontmatter.title)
	.slice(0, 3)

// Content
// - SEO
const SEO = {
	title: `${frontmatter.title} | Foxi`,
	description: `${frontmatter.description}`
}
---

<Layout title={SEO.title} description={SEO.description}>
	<BlogPostHero
		tags={frontmatter.tags}
		title={frontmatter.title}
		author={frontmatter.author}
		publishDate={frontmatter.pubDate.toLocaleDateString('pt-BR', {
			year: 'numeric',
			month: 'long',
			day: 'numeric'
		})}
	/>

	<StickySidebar type="right" padding="bottom" classes="bg-white dark:bg-neutral-950 border-b border-neutral-100 dark:border-neutral-800">
		<div slot="sidebar" class:list={['flex flex-col gap-10 lg:pl-8 lg:border-l border-neutral-100 dark:border-neutral-800']}>
			<!-- Author Widget -->
			<div class="flex flex-col gap-4">
				<h3 class="text-xs font-bold uppercase tracking-widest text-neutral-400 dark:text-neutral-500">Sobre o Autor</h3>
				<AuthorWidget authorSlug={frontmatter.author} />
			</div>

			<!-- Recent Posts Widget -->
			{recentPosts.length > 0 && (
				<div class="flex flex-col gap-6">
					<h3 class="text-xs font-bold uppercase tracking-widest text-neutral-400 dark:text-neutral-500">Mais Recentes</h3>
					<div class="flex flex-col gap-6">
						{recentPosts.map((post) => (
							<a href={`/blog/${post.id}`} class:list={['group flex flex-col gap-2']}>
								<h4 class:list={['text-sm font-bold text-neutral-900 dark:text-neutral-50 group-hover:text-primary-500 transition-colors line-clamp-2']}>
									{post.data.title}
								</h4>
								<time class:list={['text-xs text-neutral-400 uppercase tracking-tighter']}>
									{new Date(post.data.pubDate).toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' })}
								</time>
							</a>
						))}
					</div>
				</div>
			)}
		</div>

		<div class:list={['post-body basic-text basic-text--lg lg:pr-12']}>
			{frontmatter.image && (
				<div class="mb-12 overflow-hidden rounded-3xl shadow-xl shadow-neutral-950/10">
					<Image 
						src={frontmatter.image} 
						alt={frontmatter.title} 
						width={1000} 
						height={500} 
						class:list={['w-full h-auto object-cover aspect-video']}
						loading="eager"
					/>
				</div>
			)}
			
			<slot />

			<!-- Newsletter Widget -->
			<div class="mt-16 p-8 lg:p-12 rounded-3xl bg-neutral-900 dark:bg-primary-500 text-white shadow-2xl shadow-neutral-950/20 transition-all duration-500 overflow-hidden relative" id="newsletter-container">
				<div class="flex flex-col md:flex-row md:items-center gap-8 md:gap-12" id="newsletter-form-content">
					<div class="flex-1">
						<h3 class="text-2xl lg:text-3xl font-bold font-headings mb-3">Gostou do conteúdo?</h3>
						<p class="text-lg opacity-80">Receba atualizações e conteúdos exclusivos diretamente no seu e-mail.</p>
					</div>
					<div class="flex-1 w-full max-w-md">
						<form class="space-y-3" id="post-newsletter-form">
							<input 
								type="email" 
								required
								placeholder="Seu melhor e-mail" 
								class:list={['w-full px-6 py-4 rounded-xl bg-white/10 border border-white/10 text-white text-lg focus:outline-none focus:ring-2 focus:ring-white/30 transition-all placeholder:text-white/40']}
							/>
							<button type="submit" class:list={['w-full py-4 px-6 bg-white dark:bg-neutral-950 text-neutral-900 dark:text-white font-bold rounded-xl hover:scale-[1.02] transition-transform text-lg']}>
								Inscrever-se na Newsletter
							</button>
						</form>
					</div>
				</div>

				<!-- Mensagem de Sucesso (Escondida por padrão) -->
				<div class="hidden flex-col items-center text-center py-8 animate-fadeUp" id="newsletter-success-content">
					<h3 class="text-2xl lg:text-3xl font-bold font-headings mb-2">Obrigado por se inscrever!</h3>
					<p class="text-lg opacity-80">Você agora faz parte da nossa comunidade. Fique atento à sua caixa de entrada!</p>
				</div>
			</div>
		</div>
	</StickySidebar>

	{
		relatedPosts.length > 0 && (
			<Section classes="bg-neutral-50 dark:bg-neutral-900" padding="both">
				<div class:list={['mb-12 flex flex-col items-center text-center']}>
					<h2 class:list={['text-3xl font-bold font-headings text-neutral-900 dark:text-neutral-50 mb-2']}>
						Veja também
					</h2>
					<div class:list={['h-1 w-12 bg-primary-500 rounded-full']}></div>
				</div>
				<Row>
					{relatedPosts.map((post) => (
						<Col span="4">
							<BlogCard
								link={`/blog/${post.id}`}
								title={post.data.title}
								subtitle={`Por ${post.data.author} em ${new Date(post.data.pubDate).toLocaleDateString('pt-BR', { year: 'numeric', month: 'long', day: 'numeric' })}`}
								image={post.data.image}
								tags={post.data.tags}
							/>
						</Col>
					))}
				</Row>
			</Section>
		)
	}
</Layout>

<script>
	const form = document.getElementById('post-newsletter-form');
	const formContent = document.getElementById('newsletter-form-content');
	const successContent = document.getElementById('newsletter-success-content');

	if (form && formContent && successContent) {
		form.addEventListener('submit', (e) => {
			e.preventDefault();
			
			// Simulação de envio com sucesso:
			formContent.classList.add('hidden');
			successContent.classList.remove('hidden');
			successContent.classList.add('flex');
		});
	}
</script>

<style>
	.post-body {
		@apply w-full;
	}
</style>
