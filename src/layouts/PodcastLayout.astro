---
// Podcast Layout
// Descrição: Layout inspirado no template Transmit para podcasts
// Propriedades:
// - title: Título SEO da página
// - description: Descrição SEO da página
// - ogImage: Imagem Open Graph

import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import Header from '@components/blocks/head/Header.astro'
import Scripts from '@components/scripts/LocalScripts.astro'
import GoogleTagManagerBody from '@components/scripts/googleTagManagerBody.astro'
import AboutSection from '@components/ui/podcast/AboutSection.astro'
import TinyWaveFormIcon from '@components/ui/podcast/TinyWaveFormIcon.astro'
import posterImage from '@/assets/podcast-poster.png'
import '@styles/global.css'
import '@fontsource-variable/inter'
import '@fontsource-variable/outfit'

type Props = {
  title?: string
  description?: string
  ogImage?: string
}

const { title, description, ogImage } = Astro.props
const hosts = ['Eric Gordon', 'Wes Mantooth']
---

<!doctype html>
<html lang="pt-BR" class="scroll-animation mode-auto relative">
  <Header title={title} description={description} ogImage={ogImage} />
  <body class="bg-neutral-50 dark:bg-neutral-950">
    <GoogleTagManagerBody />
    
    <div class="podcast-layout min-h-screen">
      <!-- Sidebar Desktop / Header Mobile -->
      <header class="podcast-sidebar bg-neutral-50 dark:bg-neutral-900 lg:fixed lg:inset-y-0 lg:left-0 lg:flex lg:w-[28rem] lg:items-start lg:overflow-y-auto xl:w-[30rem] border-b lg:border-r border-neutral-200 dark:border-neutral-800 transition-colors duration-300">
        <div class="relative z-10 mx-auto px-4 pt-10 pb-4 sm:px-6 md:max-w-2xl md:px-4 lg:min-h-full lg:flex-auto lg:px-8 lg:py-12 xl:px-12">
          <!-- Poster / Cover -->
          <a href="/podcast" class="podcast-sidebar__poster relative mx-auto block w-48 overflow-hidden rounded-lg bg-neutral-200 dark:bg-neutral-800 shadow-xl shadow-neutral-200 dark:shadow-neutral-900 sm:w-64 sm:rounded-xl lg:w-auto lg:rounded-2xl transition-transform hover:scale-[1.02] duration-300" aria-label="Podcast Início">
            <Image
              class="w-full h-auto object-cover"
              src={posterImage}
              alt="Podcast Cover"
              widths={[200, 400, 600]}
              sizes="(min-width: 1024px) 20rem, (min-width: 640px) 16rem, 12rem"
              loading="eager"
            />
            <div class="absolute inset-0 rounded-lg ring-1 ring-black/10 ring-inset sm:rounded-xl lg:rounded-2xl" />
          </a>

          <div class="mt-10 text-center lg:mt-12 lg:text-left">
            <p class="text-xl font-bold text-neutral-900 dark:text-neutral-50 font-headings">
              <a href="/podcast">Their Side</a>
            </p>
            <p class="mt-3 text-lg leading-relaxed font-medium text-neutral-700 dark:text-neutral-300">
              Conversas com as pessoas mais tragicamente incompreendidas do nosso tempo.
            </p>
          </div>

          <AboutSection className="mt-12 hidden lg:block" />
        </div>
      </header>

      <!-- Main Content -->
      <main class="podcast-main border-t border-neutral-200 dark:border-neutral-800 lg:relative lg:ml-[28rem] lg:border-t-0 xl:ml-[30rem]">
        <!-- Waveform Background Decor -->
        <div class="absolute left-0 top-0 h-20 w-full overflow-hidden opacity-10 dark:opacity-20 pointer-events-none">
          <svg aria-hidden="true" class="h-full w-full" preserveAspectRatio="none">
            <defs>
              <linearGradient id="waveform-gradient" x1="0" x2="1" y1="0" y2="0">
                <stop offset="0%" stop-color="#f9a8d4" />
                <stop offset="100%" stop-color="#db2777" />
              </linearGradient>
            </defs>
            <rect width="100%" height="100%" fill="url(#waveform-gradient)" mask="url(#waveform-mask)" />
            <mask id="waveform-mask">
              <rect width="100%" height="100%" fill="black" />
              {Array.from({ length: 100 }).map((_, i) => (
                <rect 
                  x={`${i * 1}%`} 
                  y={`${20 + Math.random() * 60}%`} 
                  width="0.5%" 
                  height={`${20 + Math.random() * 80}%`} 
                  fill="white" 
                />
              ))}
            </mask>
          </svg>
        </div>
        <div class="relative">
          <slot />
        </div>
      </main>
    </div>

    <Scripts />
  </body>
</html>

<style is:global>
  .podcast-sidebar {
    /* Custom scrollbar para a sidebar se necessário */
    scrollbar-width: thin;
    scrollbar-color: theme('colors.neutral.300') transparent;
  }
  
  .dark .podcast-sidebar {
    scrollbar-color: theme('colors.neutral.700') transparent;
  }
</style>
