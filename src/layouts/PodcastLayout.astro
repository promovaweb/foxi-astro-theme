---
// Podcast Layout
// Descrição: Layout inspirado no estilo moderno para podcasts
// Propriedades:
// - title: Título SEO da página
// - description: Descrição SEO da página
// - ogImage: Imagem Open Graph

import { Image } from 'astro:assets'
import Header from '@components/blocks/head/Header.astro'
import Scripts from '@components/scripts/LocalScripts.astro'
import GoogleTagManagerBody from '@components/scripts/googleTagManagerBody.astro'
import SocialLinks from '@components/ui/SocialLinks.astro'
import posterImage from '@/assets/podcast-poster.png'
import { configData } from '@config'
import '@styles/global.css'
import '@fontsource-variable/inter'
import '@fontsource-variable/outfit'
import type { DataLayerInfo } from '@/types/analytics'

type Props = {
  title?: string
  description?: string
  ogImage?: string
  dataLayer?: DataLayerInfo
  isSingle?: boolean
}

const { 
  title = configData.siteTitle, 
  description = configData.siteDescription, 
  ogImage = configData.ogImage,
  dataLayer,
  isSingle = false
} = Astro.props
---

<!doctype html>
<html lang="pt-BR" class="scroll-animation mode-auto relative">
  <Header title={title} description={description} ogImage={ogImage} dataLayer={dataLayer} />
  <body class="bg-neutral-50 dark:bg-neutral-950">
    <GoogleTagManagerBody />
    
    <div class="podcast-layout min-h-screen">
      <!-- Sidebar Desktop / Header Mobile -->
      <header class="podcast-sidebar bg-neutral-50 dark:bg-neutral-900 lg:fixed lg:inset-y-0 lg:left-0 lg:flex lg:w-[28rem] lg:items-start lg:overflow-y-auto xl:w-[30rem] border-b lg:border-r border-neutral-200 dark:border-neutral-800 transition-colors duration-300 z-50">
        <div class="relative z-10 mx-auto px-4 pt-10 pb-4 sm:px-6 md:max-w-2xl md:px-4 lg:min-h-full lg:flex-auto lg:px-8 lg:py-12 xl:px-12">
          <!-- Logo -->
          <div class="mb-10 flex justify-center lg:justify-start">
            <a href="/" class="flex items-center gap-2 group" aria-label="Ir para a página inicial">
              <img 
                src={configData.logo.src} 
                alt={configData.logo.alt} 
                class="h-8 w-auto dark:invert transition-transform group-hover:scale-105 duration-300"
              />
              <span class="text-xl font-bold text-neutral-900 dark:text-neutral-50 font-headings tracking-tight">Foxi.</span>
            </a>
          </div>

          <!-- Poster / Cover -->
          <a href="/podcast" class="podcast-sidebar__poster relative mx-auto block w-48 overflow-hidden rounded-lg bg-neutral-200 dark:bg-neutral-800 shadow-xl shadow-neutral-200 dark:shadow-neutral-900 sm:w-64 sm:rounded-xl lg:w-auto lg:rounded-2xl transition-transform hover:scale-[1.02] duration-300" aria-label="Podcast Início">
            <Image
              class="w-full h-auto object-cover"
              src={posterImage}
              alt="Podcast Cover"
              widths={[200, 400, 600]}
              sizes="(min-width: 1024px) 20rem, (min-width: 640px) 16rem, 12rem"
              loading="eager"
            />
            <div class="absolute inset-0 rounded-lg ring-1 ring-black/10 ring-inset sm:rounded-xl lg:rounded-2xl" />
          </a>

          <!-- Social Links -->
          <SocialLinks className="mt-6 flex justify-center lg:justify-start gap-3" />

          <div class="mt-10 text-center lg:mt-12 lg:text-left">
            <p class="text-xl font-bold text-neutral-900 dark:text-neutral-50 font-headings">
              <a href="/podcast">{configData.podcastName}</a>
            </p>
            <p class="mt-3 text-lg leading-relaxed font-medium text-neutral-700 dark:text-neutral-300">
              {configData.podcastDescription}
            </p>
          </div>

        </div>
      </header>

      <!-- Main Content -->
      <main class="podcast-main lg:relative lg:ml-[28rem] xl:ml-[30rem]">
        <!-- Hero Background Shared -->
        <div class="relative bg-neutral-50 dark:bg-neutral-900/50 border-b border-neutral-200 dark:border-neutral-800 overflow-hidden">
            <!-- Decorative Waves -->
            <div class="absolute inset-0 opacity-10 dark:opacity-5 pointer-events-none flex items-end justify-center">
                <svg width="100%" height="150" viewBox="0 0 1200 200" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
                    {Array.from({ length: 40 }).map((_, i) => (
                        <rect 
                            x={100 + i * 25} 
                            y={40 + Math.random() * 80} 
                            width="12" 
                            height={40 + Math.random() * 120} 
                            fill="currentColor" 
                            class={`text-primary-500 animate-pulse`}
                            style={{ animationDelay: `${i * 50}ms` }}
                        />
                    ))}
                </svg>
            </div>
            
            <div class="relative z-10">
                <slot name="hero" />
            </div>
        </div>

        <div class="relative z-10 bg-white dark:bg-neutral-950 min-h-screen">
          <slot />
        </div>
      </main>
    </div>

    <Scripts />
  </body>
</html>

<style is:global>
  .podcast-sidebar {
    scrollbar-width: thin;
    scrollbar-color: theme('colors.neutral.300') transparent;
  }
  
  .dark .podcast-sidebar {
    scrollbar-color: theme('colors.neutral.700') transparent;
  }
</style>
